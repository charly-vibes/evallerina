ial_failed |= matches!(\n                report.status,\n                TrialStatus::Failed | TrialStatus::InvalidOutput\n            );\n        }\n        println!(\"{}\", serde_json::to_string(event).unwrap());\n    }\n    if trial_failed {\n        Ok(ExitCode::FAILURE)\n    } else {\n        Ok(ExitCode::SUCCESS)\n    }\n}\n\n/// Aggregate a JSONL file of report rows into the fault dashboard.\n/// The configured model registry comes from the checked-in registry;\n/// the channel map from the live scenario registry. Findings do not\n/// affect the exit code — the dashboard is the record, and nonzero\n/// exits are reserved for aggregation errors.\nfn run_report(path: &str, route: bool, file: bool) -> Result<ExitCode, String> {\n    evallerina::report::validate_route_flags(route, file)?;\n    let content = std::fs::read_to_string(path)\n        .map_err(|e| format!(\"cannot read report rows from {path}: {e}\"))?;\n    let rows: Vec<serde_json::Value> = content\n        .lines()\n        .filter(|line| !line.trim().is_empty())\n        .map(|line| serde_json::from_str(line).map_err(|e| format!(\"malformed report row: {e}\")))\n        .collect::<Result<Vec<_>, String>>()?;\n    let configured: Vec<String> = ordered_ids().into_iter().map(String::from).collect();\n    let mut dashboard = evallerina::report::aggregate_rows(\n        &rows,\n        &configured,\n        &evallerina::report::scenario_channel,\n    )?;\n    if route {\n        let mut runner = evallerina::routing::run_bd;\n        evallerina::report::run_routing_step(\n            &mut dashboard,\n            &rows,\n            &configured,\n            std::path::Path::new(path),\n            file,\n            &mut runner,\n        )?;\n    }\n    println!(\n        \"{}\",\n        serde_json::to_string_pretty(&dashboard).expect(\"dashboard serializes\")\n    );\n    Ok(ExitCode::SUCCESS)\n}\n"}],"isError":false,"timestamp":1792435513802},{"role":"assistant","content":[{"type":"toolCall","id":"call_435d5c2f541a44b0a94178f9","name":"read","arguments":{"limit":160,"offset":25,"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/ablation.rs"}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":912,"output":45,"cacheRead":14336,"cacheWrite":0,"reasoning":1,"totalTokens":15293,"cost":{"input":0.0001368,"output":0.000022499999999999998,"cacheRead":0.00043007999999999995,"cacheWrite":0,"total":0.0005893799999999999}},"stopReason":"toolUse","timestamp":1792435513804,"responseId":"gen-1792435513-wOV82hNygiVuQzDT1PTG","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_435d5c2f541a44b0a94178f9","toolName":"read","content":[{"type":"text","text":"use genesis::evals::Scenario;\n\nuse crate::live::{Arm, ArmContext, Bounds, RotationEvent, TrialStatus, run_rotation_with_arm};\n\n/// Per-arm transport sourcing for an ablation: one factory per arm\n/// (the arm is the caller's knowledge, not the trial's).\npub struct AblationFactories<'a> {\n    /// Transports for the full arm (AIX artifacts present).\n    pub full: crate::live::TransportFactory<'a>,\n    /// Transports for the ablated arm (raw binaries).\n    pub ablated: crate::live::TransportFactory<'a>,\n}\n\n/// Version of the ablation report shape. Additive evolution only\n/// within a version; breaking changes bump this.\npub const ABLATION_VERSION: u32 = 1;\n\n/// The evals.md Step 5 sample floor: a delta claim needs ≥3 runs per\n/// arm; fewer samples cannot support it.\nconst REPS_FLOOR: u32 = 3;\n\n/// The AIX artifact set the full arm provisions (dulce tool family:\n/// llms.txt + managed AGENTS.md + `.genesis/tools.toml`). Contents are\n/// caller-supplied so tests stay hermetic; production wires the real\n/// generated artifacts.\n#[derive(Debug, Clone, Copy)]\npub struct AixArtifacts {\n    /// The `llms.txt` file content.\n    pub llms_txt: &'static str,\n    /// The managed `AGENTS.md` content (managed blocks included).\n    pub managed_agents_md: &'static str,\n    /// The `.genesis/tools.toml` content.\n    pub tools_toml: &'static str,\n}\n\n/// The fixture paths the full arm provisions, in [`AixArtifacts::fixture_files`]\n/// order. Shared by the static and real paths so the two arms of the\n/// ablation can never drift apart — and so the collision check below\n/// covers both.\nconst ARTIFACT_PATHS: [&str; 3] = [\"AGENTS.md\", \".genesis/tools.toml\", \"llms.txt\"];\n\nimpl AixArtifacts {\n    /// The artifact set as fixture files, written into the full arm's\n    /// fixture after the scenario's own material.\n    pub fn fixture_files(&self) -> Vec<(String, String)> {\n        vec![\n            (\"AGENTS.md\".to_owned(), self.managed_agents_md.to_owned()),\n            (\".genesis/tools.toml\".to_owned(), self.tools_toml.to_owned()),\n            (\"llms.txt\".to_owned(), self.llms_txt.to_owned()),\n        ]\n    }\n\n    /// Real generation entry (evallerina-0j8): invoke the provisioned\n    /// tools inside `fixture_dir` and harvest the artifacts they\n    /// produce. Process-boundary only: `wai init --json` must exit 0\n    /// and produce a readable `AGENTS.md` (its managed block) and a\n    /// registered `.genesis/tools.toml` — tool internals are never\n    /// inspected. A tool failure is a loud error, never a silent\n    /// placeholder fallback.\n    pub fn for_fixture(\n        fixture_dir: &Path,\n        tools: &ToolBinaries,\n    ) -> Result<GeneratedAixArtifacts, String> {\n        let out = std::process::Command::new(&tools.wai)\n            .arg(\"init\")\n            .arg(\"--json\")\n            .current_dir(fixture_dir)\n            .output()\n            .map_err(|e| format!(\"wai init spawn failed ({}): {e}\", tools.wai.display()))?;\n        if !out.status.success() {\n            return Err(format!(\n                \"wai init exited {} — real artifact generation failed loudly (stderr: {})\",\n                out.status,\n                String::from_utf8_lossy(&out.stderr).trim()\n            ));\n        }\n        let managed_agents_md = std::fs::read_to_string(fixture_dir.join(\"AGENTS.md\"))\n            .map_err(|e| format!(\"wai init produced no readable AGENTS.md: {e}\"))?;\n        let tools_toml = std::fs::read_to_string(fixture_dir.join(\".genesis/tools.toml\"))\n            .map_err(|e| format!(\"wai init produced no readable .genesis/tools.toml: {e}\"))?;\n        let llms_txt = llms_txt_for_fixture(fixture_dir)?;\n        Ok(GeneratedAixArtifacts {\n            llms_txt,\n            managed_agents_md,\n            tools_toml,\n        })\n    }\n}\n\n/// The real `llms.txt` for the fixture tool set: genesis-vibes's\n/// `generate_llms_txt` over the tools the provisioned binary actually\n/// registered (read through genesis discovery), titled by the\n/// generation fixture's project name.\nfn llms_txt_for_fixture(fixture_dir: &Path) -> Result<String, String> {\n    let manifest = genesis::discovery::read_manifest(fixture_dir)\n        .ok_or(\"wai init left no readable .genesis/tools.toml manifest\")?;\n    let mut modules: Vec<genesis::aix::ModuleEntry> = manifest\n        .tools\n        .into_iter()\n        .map(|(name, entry)| genesis::aix::ModuleEntry {\n            name,\n            description: entry.description,\n        })\n        .collect();\n    // Map iteration is unordered; the standardized listing is stable.\n    modules.sort_by(|a, b| a.name.cmp(&b.name));\n    let name = fixture_dir\n        .file_name()\n        .and_then(|n| n.to_str())\n        .unwrap_or(\"dulce-fixture\")\n        .to_owned();\n    let meta = genesis::aix::ProjectMeta {\n        name,\n        tagline: \"the dulce-de-leche tool family\".to_owned(),\n        repository: None,\n        documentation: None,\n        crates_io: None,\n    };\n    Ok(genesis::aix::generate_llms_txt(&meta, &modules))\n}\n\n/// The provisioned tool binaries available for real artifact\n/// generation ([`AixSource::Real`]). Paths, not versions: generation\n/// asserts on process exit codes and produced files, never tool\n/// internals.\n#[derive(Debug, Clone)]\npub struct ToolBinaries {\n    /// The provisioned `wai` binary — generates the managed AGENTS.md\n    /// (with its provenance footer) and registers the tool manifest.\n    pub wai: PathBuf,\n}\n\nimpl ToolBinaries {\n    /// Locate `wai` on `PATH`; `None` when absent, so CI without tool\n    /// binaries stays hermetic ([`AixSource::Static`]).\n    pub fn discover_wai() -> Option<PathBuf> {\n        std::env::var_os(\"PATH\")\n            .as_deref()\n            .map(std::env::split_paths)\n            .into_iter()\n            .flatten()\n            .find_map(|dir| {\n                let candidate = dir.join(\"wai\");\n                candidate.is_file().then_some(candidate)\n            })\n    }\n}\n\n/// Which contents the full arm provisions. The hermetic static\n/// contents are the default (tests, CI without tool binaries); real\n/// generation is opt-in and runs the provisioned tools in a generation\n/// fixture ([`AixArtifacts::for_fixture`]).\n#[derive(Debug, Clone)]\npub enum AixSource<'a> {\n    /// Static contents — today's hermetic behavior, byte-for-byte.\n    Static(&'a AixArtifacts),\n    /// Real generation: invoke the provisioned tools and harvest what\n    /// they produce. Opt-in; a tool failure is a loud error.\n    Real(ToolBinaries),\n}\n\n[228 more lines in file. Use offset=185 to continue.]"}],"isError":false,"timestamp":1792435516286},{"role":"assistant","content":[{"type":"toolCall","id":"call_43b05914afa3450ea6980b68","name":"read","arguments":{"limit":230,"offset":185,"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/ablation.rs"}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":1798,"output":45,"cacheRead":15104,"cacheWrite":0,"reasoning":1,"totalTokens":16947,"cost":{"input":0.0002697,"output":0.000022499999999999998,"cacheRead":0.00045311999999999994,"cacheWrite":0,"total":0.0007453199999999999}},"stopReason":"toolUse","timestamp":1792435516288,"responseId":"gen-1792435516-15P7THYw6heifetmnz5o","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_43b05914afa3450ea6980b68","toolName":"read","content":[{"type":"text","text":"\n/// Owned artifact contents produced by real generation\n/// ([`AixArtifacts::for_fixture`]) — the production entry. The static\n/// [`AixArtifacts`] variant stays for hermetic tests.\n#[derive(Debug, Clone)]\npub struct GeneratedAixArtifacts {\n    /// The `llms.txt` file content.\n    pub llms_txt: String,\n    /// The managed `AGENTS.md` content (managed blocks included).\n    pub managed_agents_md: String,\n    /// The `.genesis/tools.toml` content.\n    pub tools_toml: String,\n}\n\nimpl GeneratedAixArtifacts {\n    /// The artifact set as fixture files, written into the full arm's\n    /// fixture after the scenario's own material.\n    pub fn fixture_files(&self) -> Vec<(String, String)> {\n        ARTIFACT_PATHS\n            .iter()\n            .zip([\n                self.managed_agents_md.clone(),\n                self.tools_toml.clone(),\n                self.llms_txt.clone(),\n            ])\n            .map(|(path, content)| ((*path).to_owned(), content))\n            .collect()\n    }\n}\n\n/// Per-arm outcome summary. `pass_rate` is over trials that ran\n/// (`passed + failed + invalid_output`); rate-limited and absent cells\n/// are surfaced in their own counters and excluded from the\n/// denominator — they are records, never failures.\n#[derive(Debug, Clone, Serialize)]\npub struct ArmSummary {\n    /// The arm this summary describes.\n    pub arm: Arm,\n    /// Trials that actually ran.\n    pub trials: usize,\n    /// Trials where every declared check passed.\n    pub passed: usize,\n    /// Trials that ended `failed` (a check failed or a bound was\n    /// reached).\n    pub failed: usize,\n    /// Trials that ended `invalid_output` (agent fault).\n    pub invalid_output: usize,\n    /// Trials that ended `rate_limited` (transport 429 twice).\n    pub rate_limited: usize,\n    /// Trials that ended `http_error` (mid-trial transport error).\n    /// Surfaced as a coverage record — like `rate_limited`, never a\n    /// fault and never attributed to the agent or the tool.\n    pub http_error: usize,\n    /// Cells the budget skipped before they could start.\n    pub absent: usize,\n    /// Pass rate over trials that ran; `None` when nothing ran.\n    pub pass_rate: Option<f64>,\n}\n\n/// One scenario's A/B result: per-arm summaries, the delta, and the\n/// underlying rows verbatim (the report is auditable, not a black box).\n#[derive(Debug, Clone, Serialize)]\npub struct AblationReport {\n    /// Report shape version.\n    pub ablation_version: u32,\n    /// The scenario name.\n    pub scenario: String,\n    /// The full-arm (AIX artifacts present) summary.\n    pub full: ArmSummary,\n    /// The ablated-arm (raw binaries) summary.\n    pub ablated: ArmSummary,\n    /// `pass_rate(full) − pass_rate(ablated)` — the measured value of\n    /// the AIX investment for this scenario. `None` when either arm\n    /// has no runnable trials; undefined is never silently zero.\n    pub delta: Option<f64>,\n    /// The full arm's rotation rows, verbatim.\n    pub full_rows: Vec<RotationEvent>,\n    /// The ablated arm's rotation rows, verbatim.\n    pub ablated_rows: Vec<RotationEvent>,\n}\n\n/// Run the A/B ablation for one scenario: ≥3 runs per arm (the evals.md\n/// Step 5 floor, enforced loudly), the full arm first, then the\n/// ablated arm, over the same model list and repetitions. The budget\n/// closure is shared across both arms, so a mid-ablation expiry lands\n/// as absent cells in whichever arm runs short — recorded, never\n/// failed, never dropped.\n///\n/// The artifact paths must not collide with the scenario's own fixture\n/// files or distractors: an artifact must never overwrite scenario\n/// material the checks depend on (e.g. a corrupt config is the fault\n/// injection). Collisions are a loud error, not a silent overwrite.\npub fn run_ablation(\n    scenario: &Scenario,\n    models: &[String],\n    reps: u32,\n    artifacts: AixSource<'_>,\n    factories: AblationFactories<'_>,\n    bounds: &Bounds,\n    budget_remaining: &dyn Fn() -> bool,\n) -> Result<AblationReport, String> {\n    if reps < REPS_FLOOR {\n        return Err(format!(\n            \"ablation needs ≥{REPS_FLOOR} runs per arm to support a delta claim (got {reps})\"\n        ));\n    }\n    // The artifact paths are the same for both sources, so the\n    // collision check runs before any generation: a scenario-owned\n    // path (e.g. a corrupt config injected as the fault) is never\n    // overwritten, hermetic or real.\n    for path in ARTIFACT_PATHS {\n        let collides = scenario\n            .fixture_files\n            .iter()\n            .map(|(p, _)| p.as_str())\n            .chain(scenario.distractors.iter().map(|d| d.path.as_str()))\n            .any(|p| p == path);\n        if collides {\n            return Err(format!(\n                \"AIX artifact '{path}' collides with scenario material for '{}' — refusing to overwrite\",\n                scenario.name\n            ));\n        }\n    }\n    let artifact_files: Vec<(String, String)> = match &artifacts {\n        AixSource::Static(static_artifacts) => static_artifacts.fixture_files(),\n        AixSource::Real(tools) => {\n            let generation_dir = generation_fixture_dir()?;\n            let generated = AixArtifacts::for_fixture(&generation_dir, tools)?;\n            std::fs::remove_dir_all(&generation_dir).ok();\n            generated.fixture_files()\n        }\n    };\n\n    let full_rows = run_rotation_with_arm(\n        std::slice::from_ref(scenario),\n        models,\n        reps,\n        &ArmContext {\n            arm: Arm::Full,\n            extra_fixture_files: &artifact_files,\n        },\n        factories.full,\n        bounds,\n        budget_remaining,\n    )?;\n    let ablated_rows = run_rotation_with_arm(\n        std::slice::from_ref(scenario),\n        models,\n        reps,\n        &ArmContext {\n            arm: Arm::Ablated,\n            extra_fixture_files: &[],\n        },\n        factories.ablated,\n        bounds,\n        budget_remaining,\n    )?;\n\n    let full = arm_summary(Arm::Full, &full_rows);\n    let ablated = arm_summary(Arm::Ablated, &ablated_rows);\n    let delta = match (full.pass_rate, ablated.pass_rate) {\n        (Some(full_rate), Some(ablated_rate)) => Some(full_rate - ablated_rate),\n        _ => None,\n    };\n    Ok(AblationReport {\n        ablation_version: ABLATION_VERSION,\n        scenario: scenario.name.clone(),\n        full,\n        ablated,\n        delta,\n        full_rows,\n        ablated_rows,\n    })\n}\n\n/// A fresh unique generation fixture under the system temp dir: the\n/// directory the provisioned tools run in during real artifact\n/// generation. Never the scenario's trial fixture — scenario-owned\n/// material (fault injections like a corrupt config) can't be touched.\nfn generation_fixture_dir() -> Result<PathBuf, String> {\n    let dir = std::env::temp_dir().join(format!(\n        \"evallerina-ablation-gen-{}-{}\",\n        std::process::id(),\n        std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .map_err(|e| format!(\"clock: {e}\"))?\n            .as_nanos(),\n    ));\n    std::fs::create_dir_all(&dir).map_err(|e| format!(\"generation fixture: {e}\"))?;\n    Ok(dir)\n}\n\n/// Summarize one arm's rotation rows into an [`ArmSummary`].\nfn arm_summary(arm: Arm, rows: &[RotationEvent]) -> ArmSummary {\n    let mut summary = ArmSummary {\n        arm,\n        trials: 0,\n        passed: 0,\n        failed: 0,\n        invalid_output: 0,\n        rate_limited: 0,\n        http_error: 0,\n        absent: 0,\n        pass_rate: None,\n    };\n    for row in rows {\n        match row {\n            RotationEvent::Trial { report } => {\n                summary.trials += 1;\n                match report.status {\n                    TrialStatus::Passed => summary.passed += 1,\n                    TrialStatus::Failed => summary.failed += 1,\n                    TrialStatus::InvalidOutput => summary.invalid_output += 1,\n                    TrialStatus::RateLimited => summary.rate_limited += 1,\n                    TrialStatus::HttpError => summary.http_error += 1,\n                }\n            }\n            RotationEvent::Absent { .. } => summary.absent += 1,\n        }\n    }\n    let ran = summary.passed + summary.failed + summary.invalid_output;\n    if ran > 0 {\n        summary.pass_rate = Some(summary.passed as f64 / ran as f64);\n    }\n    summary\n}\n"}],"isError":false,"timestamp":1792435519516},{"role":"assistant","content":[{"type":"thinking","thinking":"Now I understand run_ablation's signature. It takes: scenario (&Scenario), models, reps, artifacts (AixSource), factories (AblationFactories), bounds, budget_remaining.\n\nFor CLI wiring:\n- scenario: a name → but run_ablation takes a `Scenario` from genesis. How do tests load scenarios? There's SCENARIOS_DIR and live_scenario_by_name. But ablation likely runs over live scenarios. Let me check scenario.rs and lib.rs, plus how live.rs exposes run_rotation_with_arm, TransportFactory, and what OpenRouterTransport::from_env does.\n\nThe test needs end-to-end CLI in a temp sandbox with no network/no model calls. Options: use a mock transport? The CLI wires OpenRouterTransport from env — that would be live. Hmm. The brief says: \"end-to-end dry-run in a temp sandbox (no network, no model call — use an empty/absent registry path or a mock)\".\n\nSo maybe the CLI should accept a registry path / model list, and when the registry is empty or absent... \"loud errors on bad paths, never silent\" though. Hmm, but \"use an empty/absent registry path or a mock\".\n\nLet me look at reg