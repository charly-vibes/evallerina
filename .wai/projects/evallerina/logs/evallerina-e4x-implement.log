 D1/D4). One `[tool]` section per\n# routing.toml tool. Relative `repo` paths resolve against the\n# evallerina repo root (same rules as routing.toml).\n#\n# Per tool:\n#   repo     — the repository whose doc surfaces are scanned\n#              (README.md, docs/**, llms.txt, AGENTS.md managed blocks)\n#   binary   — binary probed with `--help`; defaults to the tool name\n#   surface  — \"none\" for tools that are not --help-probeable CLIs:\n#              they skip the binary step and are recorded in\n#              provenance, never silently skipped.\n#\n# A missing binary records `binary_absent` provenance; a missing local\n# checkout records `repo_absent`. Every skip is provenance (anti-goal:\n# no silent skips).\n\n[wai]\nrepo = \"../wai\"\n\n[genesis]\nrepo = \"../genesis\"\n\n[espectacular]\nrepo = \"../espectacular\"\n\n[dont]\nrepo = \"../dont\"\n\n[testaruda]\nrepo = \"../testaruda\"\n\n# turu's repo is `whisper` (binary/crate name mismatch; ddl canonical table).\n[turu]\nrepo = \"../whisper\"\nbinary = \"turu\"\n\n# `ah` shares the espectacular checkout (binary name of the espectacular CLI).\n[ah]\nrepo = \"../espectacular\"\n\n[pretender]\nrepo = \"../pretender\"\n\n[vampiro]\nrepo = \"../vampiro\"\n\n[incitaciones]\nrepo = \"../incitaciones\"\n\n# Third-party upstreams: not locally checked-out Rust CLIs — surface\n# none, provenance-recorded, never silent.\n[openspec]\nrepo = \"fission-ai/openspec\"\nsurface = \"none\"\n\n[specodelic]\nrepo = \"../specodelic\"\n\n[funkalization]\nrepo = \"../funkalization\"\n\n[wild]\nrepo = \"../wild\"\n\n[dulce-de-leche]\nrepo = \"../dulce-de-leche\"\n\n[bd]\nrepo = \"gastownhall/beads\"\nsurface = \"none\"\n----\n# evallerina — eval battery for the dulce-de-leche tool family\n# Tier ladder per genesis evals-guidelines: 0 static (push) / 1 replay (nightly) / 2 live (scheduled)\n\ndefault:\n    @just --list\n\n# Tier 0 — static checks, no model (gates every push)\ntier0:\n    cargo fmt --check\n    cargo clippy -- -D warnings\n    cargo test\n    cargo run --quiet -- doc-audit > /dev/null\n\n# Tier 1 — scripted replay of recorded AgentStep transcripts, no model, no network\ntier1:\n    cargo test --test evals_replay -- --nocapture\n\n# Tier 2 — live rotation (requires OPENROUTER_API_KEY); never gates a push.\n# One JSON event per cell on stdout (trial row or absent record).\ntier2 model=\"openrouter/free\" scenario=\"\" budget=\"20\":\n    #!/usr/bin/env bash\n    set -euo pipefail\n    args=(live --model \"{{model}}\" --budget-mins \"{{budget}}\")\n    if [ -n \"{{scenario}}\" ]; then args+=(\"{{scenario}}\"); fi\n    cargo run --release -- \"${args[@]}\"\n\n# Build + test the harness crate\nci: tier0\n\n# Fixture sandbox smoke test: provision binaries, run one replay scenario\n"}],"isError":false,"timestamp":1792528692763}}
{"type":"turn_end","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_74e9fe465aee4a7cb5381ac2","name":"read","arguments":{"limit":513,"offset":1,"path":"src/main.rs"}},{"type":"toolCall","id":"call_0c3b2bba5e604adc95dca163","name":"bash","arguments":{"command":"cd /var/home/sasha/para/areas/dev/gh/charly/evallerina && cat routing.toml && echo ---- && cat doc_audit.toml && echo ---- && head -30 justfile","timeout":30}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":4464,"output":83,"cacheRead":17408,"cacheWrite":0,"reasoning":1,"totalTokens":21955,"cost":{"input":0.0006696,"output":0.0000415,"cacheRead":0.00052224,"cacheWrite":0,"total":0.0012333399999999999}},"stopReason":"toolUse","timestamp":1792528687513,"responseId":"gen-1792528687-gSOlFtuoMjDsOX9iLiBj","rawStopReason":"tool_calls"},"toolResults":[{"role":"toolResult","toolCallId":"call_74e9fe465aee4a7cb5381ac2","toolName":"read","content":[{"type":"text","text":"//! Purpose: CLI entry point of the evallerina harness.\n//! Responsibilities: expose the tier commands the justfile recipes\n//! invoke — `smoke` (run the replay smoke scenario, exit code carries\n//! pass/fail) and `live` (tier-2 live rotation over scenario × model\n//! cells via the OpenRouter :free action protocol).\n//! Rationale: tier discipline — the binary gates tier-0/1 locally and\n//! in CI; tier-2 never gates a push. `live` prints one JSON event per\n//! cell (trial row or absent record) and exits nonzero only when a\n//! trial actually failed or malformed — skipped cells are the record.\n\nuse std::io::Write;\nuse std::process::ExitCode;\nuse std::time::{Duration, Instant};\n\nuse clap::{Parser, Subcommand};\nuse evallerina::ablation::{\n    AblationFactories, AixArtifacts, AixSource, ToolBinaries, run_ablation,\n};\nuse evallerina::live::{OpenRouterTransport, RotationEvent, TrialStatus, run_rotation};\nuse evallerina::recorded::RecordedTrajectory;\nuse evallerina::registry::{DEFAULT_REPETITIONS, ordered_ids};\nuse evallerina::scenario::{SCENARIOS_DIR, live_scenario_by_name, live_scenarios, smoke_scenario};\n\n/// Default per-run wall-clock budget for the live rotation, minutes.\nconst DEFAULT_BUDGET_MINS: u64 = 20;\n\n/// Evals with an avatar — measuring whether agents actually use the tools.\n#[derive(Parser)]\n#[command(name = \"evallerina\", version, about)]\nstruct Cli {\n    #[command(subcommand)]\n    command: Command,\n}\n\n#[derive(Subcommand)]\nenum Command {\n    /// Run the tier-1 smoke replay (no model, no network). Exit 0 iff green.\n    Smoke,\n    /// Tier-2 live rotation (requires OPENROUTER_API_KEY). One JSON\n    /// event per cell on stdout: a report_version 1 trial row, or an\n    /// absent record when the per-run budget skipped the cell.\n    Live {\n        /// Optional scenario name filter (default: the whole live battery).\n        #[arg(default_value = None)]\n        scenario: Option<String>,\n        /// Repetitions per scenario × model cell.\n        #[arg(long, default_value_t = DEFAULT_REPETITIONS)]\n        reps: u32,\n        /// Run only this model id (default: the whole registry, in order).\n        #[arg(long, default_value = None)]\n        model: Option<String>,\n        /// Per-run wall-clock budget, minutes; cells not started before\n        /// it expires are recorded absent, never failed.\n        #[arg(long, default_value_t = DEFAULT_BUDGET_MINS)]\n        budget_mins: u64,\n    },\n    /// A/B ablation over one scenario (evals.md Step 5): the full arm\n    /// (AIX artifacts provisioned) vs the ablated arm (raw binaries),\n    /// ≥3 runs per arm over the configured model registry. Writes the\n    /// per-arm rotation rows as ArmReport JSONL to --out and prints the\n    /// per-arm summary + delta as JSON on stdout.\n    Ablate {\n        /// Scenario name (a live battery scenario; unknown names are a\n        /// loud error).\n        scenario: String,\n        /// Repetitions per arm (the evals.md Step 5 delta floor is 3).\n        #[arg(long, default_value_t = DEFAULT_REPETITIONS)]\n        reps: u32,\n        /// Run only this model id (default: the whole registry, in order).\n        #[arg(long, default_value = None)]\n        model: Option<String>,\n        /// Dry-run: every cell is recorded absent — no model calls, no\n        /// network; exercises the full report path hermetically.\n        #[arg(long)]\n        dry_run: bool,\n        /// Real artifact generation (opt-in; evallerina-0j8): invoke the\n        /// provisioned `wai` binary and harvest what it produces for the\n        /// full arm, instead of the static hermetic contents. A tool\n        /// failure is a loud error, never a placeholder fallback.\n        #[arg(long)]\n        real_artifacts: bool,\n        /// Per-run wall-clock budget, minutes; cells not started before\n        /// it expires are recorded absent, never failed.\n        #[arg(long, default_value_t = DEFAULT_BUDGET_MINS)]\n        budget_mins: u64,\n        /// Path the ArmReport JSONL rows are written to (full arm rows\n        /// first, then ablated, in run order).\n        #[arg(long)]\n        out: String,\n    },\n    /// Aggregate report rows (one JSON value per line in a JSONL file —\n    /// tier-2 rotation events or tier-1 rows) into the per-channel\n    /// fault dashboard. Prints the dashboard JSON to stdout; exits\n    /// nonzero on aggregation errors (unknown scenario, version\n    /// mismatch), never on fault findings.\n    Report {\n        /// Path to the JSONL report rows to aggregate.\n        path: String,\n        /// Run the fault-routing step after aggregation (dry-run by\n        /// default): attach the additive `routed` summary to the\n        /// dashboard and write proposed-tickets.jsonl next to the report.\n        #[arg(long)]\n        route: bool,\n        /// File the proposed tickets in their mapped repositories\n        /// (explicit cross-repo write authorization, Phase 2).\n        /// Requires --route.\n        #[arg(long)]\n        file: bool,\n    },\n    /// Tier-0 doc-coverage audit (evallerina-fok): harvest each\n    /// configured tool's CLI surface from `--help`, scan its repo's doc\n    /// surfaces (README, docs/**, llms.txt, AGENTS.md managed blocks),\n    /// and emit per-token audit rows (ERR_FEATURE_UNDOCUMENTED /\n    /// ERR_DOC_NOT_FINDABLE) plus provenance for every non-extracted\n    /// source — never a silent skip. Prints the audit as JSON. Findings\n    /// are the record, not failures: exit nonzero only on loud errors\n    /// (missing/malformed config, unreadable surface).\n    DocAudit,\n    /// Tier-0 routing-map parity gate (evallerina-0sy): diff\n    /// routing.toml against dulce-de-leche's MANAGED-TOOLS block\n    /// (../dulce-de-leche/README.md). Prints the parity report as JSON\n    /// (degraded flag + one row per managed tool) and exits nonzero iff\n    /// any row failed; an absent ddl sibling degrades to a warning row\n    /// with exit 0 (standalone clones), never covering a parse failure.\n    RoutingParity,\n}\n\n/// The hermetic static artifact set the full arm provisions by default\n/// (the ablated-arm baseline stays raw binaries either way). Real\n/// generation — the provisioned `wai` binary harvesting the actual\n/// managed AGENTS.md, `.genesis/tools.toml` and `llms.txt` — is opt-in\n/// via --real-artifacts (evallerina-0j8).\nconst DEFAULT_AIX_ARTIFACTS: AixArtifacts = AixArtifacts {\n    llms_txt: \"llms.txt content: wai status --json\",\n    managed_agents_md: \"<!-- WAI:START -->managed guidance<!-- WAI:END -->\",\n    tools_toml: \"[tools]\\nwai = { cmd = \\\"wai\\\" }\\n\",\n};\n\nfn main() -> std::process::ExitCode {\n    match Cli::parse().command {\n        Command::Smoke => {\n            let path = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n                .join(SCENARIOS_DIR)\n                .join(\"wai-hint-adherence-smoke.json\");\n            let content = std::fs::read_to_string(&path)\n                .unwrap_or_else(|e| panic!(\"read {}: {e}\", path.display()));\n            let trajectory = RecordedTrajectory::from_json(&content)\n                .unwrap_or_else(|e| panic!(\"parse {}: {e}\", path.display()));\n            let report = smoke_scenario()\n                .run(trajectory.steps())\n                .unwrap_or_else(|e| panic!(\"replay failed: {e}\"));\n            println!(\"{}\", serde_json::to_string_pretty(&report).unwrap());\n            if report.passed {\n                ExitCode::SUCCESS\n            } else {\n                ExitCode::FAILURE\n            }\n        }\n        Command::Live {\n            scenario,\n            reps,\n            model,\n            budget_mins,\n        } => match run_live(scenario, reps, model, budget_mins) {\n            Ok(code) => code,\n            Err(msg) => {\n                eprintln!(\"{msg}\");\n                ExitCode::FAILURE\n            }\n        },\n        Command::Report { path, route, file } => match run_report(&path, route, file) {\n            Ok(code) => code,\n            Err(msg) => {\n                eprintln!(\"{msg}\");\n                ExitCode::FAILURE\n            }\n        },\n        Command::DocAudit => match run_doc_audit() {\n            Ok(code) => code,\n            Err(e) => {\n                eprintln!(\"doc-audit: {e}\");\n                ExitCode::FAILURE\n            }\n        },\n        Command::RoutingParity => match run_routing_parity() {\n            Ok(code) => code,\n            Err(msg) => {\n                eprintln!(\"{msg}\");\n                ExitCode::FAILURE\n            }\n        },\n        Command::Ablate {\n            scenario,\n            reps,\n            model,\n            dry_run,\n            real_artifacts,\n            budget_mins,\n            out,\n        } => match run_ablate(\n            &scenario,\n            reps,\n            model,\n            dry_run,\n            real_artifacts,\n            budget_mins,\n            &out,\n        ) {\n            Ok(code) => code,\n            Err(msg) => {\n                eprintln!(\"{msg}\");\n                ExitCode::FAILURE\n            }\n        },\n    }\n}\n\n/// Tier-2 live rotation: the scenario battery (or one named scenario)\n/// × selected models × reps, in registry order, under a per-run\n/// wall-clock budget. One JSON event per cell on stdout — a\n/// report_version 1 trial row or an absent record. Exit nonzero iff a\n/// trial failed or malformed; rate-limited and budget-skipped cells are\n/// recorded in their rows, they are not failures (the row is the\n/// record).\nfn run_live(\n    scenario: Option<String>,\n    reps: u32,\n    model: Option<String>,\n    budget_mins: u64,\n) -> Result<ExitCode, String> {\n    let scenarios: Vec<_> = match scenario {\n        Some(name) => vec![live_scenario_by_name(&name)?],\n        None => live_scenarios(),\n    };\n    let models: Vec<String> = match model {\n        Some(id) => vec![id],\n        None => ordered_ids().into_iter().map(String::from).collect(),\n    };\n    let start = Instant::now();\n    let budget = Duration::from_secs(budget_mins * 60);\n    let mut factory = |m: &str| {\n        OpenRouterTransport::from_env(m)\n            .map(|t| Box::new(t) as Box<dyn evallerina::live::Transport>)\n    };\n    let events = run_rotation(\n        &scenarios,\n        &models,\n        reps,\n        &mut factory,\n        &evallerina::live::Bounds::default(),\n        &|| start.elapsed() < budget,\n    )?;\n    let mut trial_failed = false;\n    for event in &events {\n        if let RotationEvent::Trial { report } = event {\n            trial_failed |= matches!(\n                report.status,\n                TrialStatus::Failed | TrialStatus::InvalidOutput\n            );\n        }\n        println!(\"{}\", serde_json::to_string(event).unwrap());\n    }\n    if trial_failed {\n        Ok(ExitCode::FAILURE)\n    } else {\n        Ok(ExitCode::SUCCESS)\n    }\n}\n\n/// Tier-0 routing-map parity gate (evallerina-0sy): read the checked-in\n/// routing.toml and the ddl sibling README relative to the repo root\n/// (discovered worktree-safe), run\n/// [`evallerina::routing_parity::routing_parity`], and print the parity\n/// report as JSON. Exit nonzero\n/// iff any parity row failed (`ERR_ROUTING_PARITY` rows carry tool +\n/// detail); an absent ddl sibling degrades to a warning row with exit\n/// 0 — parse failures stay loud and nonzero.\nfn run_routing_parity() -> Result<ExitCode, String> {\n    let root = evallerina::routing::discover_root()?;\n    let root_path = std::path::PathBuf::from(&root);\n    let toml_path = root_path.join(\"routing.toml\");\n    let toml = std::fs::read_to_string(&toml_path)\n        .map_err(|e| format!(\"cannot read {}: {e}\", toml_path.display()))?;\n    let readme_path = root_path.join(evallerina::routing_parity::DDL_README);\n    let readme = std::fs::read_to_string(&readme_path).ok();\n    let report = evallerina::routing_parity::routing_parity(readme.as_deref(), &toml, &root_path)?;\n    println!(\n        \"{}\",\n        serde_json::to_string_pretty(&report.to_json()).expect(\"parity report serializes\")\n    );\n    if report.failed() {\n        Ok(ExitCode::FAILURE)\n    } else {\n        Ok(ExitCode::SUCCESS)\n    }\n}\n\n/// Tier-0 doc-coverage audit CLI handler (evallerina-fok): load the\n/// checked-in doc_audit.toml from the repo root, run the surface step\n/// per tool (binary probe, or `skip`/`binary_absent` provenance —\n/// never a silent skip), scan each tool's local repo surfaces into a\n/// doc inventory, and diff the two into per-token audit rows that also\n/// flow into the report contract as report_version 1 rows. Findings\n/// are the record, not gate failures (the dashboard is the record);\n/// nonzero exit is reserved for loud errors: missing/malformed config,\n/// unreadable surfaces.\nfn run_doc_audit() -> Result<ExitCode, String> {\n    let root = evallerina::routing::discover_root()?;\n    let root_path = std::path::PathBuf::from(&root);\n    let config_path = root_path.join(\"doc_audit.toml\");\n    let config_src = std::fs::read_to_string(&config_path)\n        .map_err(|e| format!(\"cannot read {}: {e}\", config_path.display()))?;\n    let configs = evallerina::doc_audit::parse_config(&config_src)?;\n\n    let mut provenance = Vec::new();\n    let mut tools = serde_json::Map::new();\n    let mut report_rows = Vec::new();\n    let mut audit_rows_all = Vec::new();\n    for config in &configs {\n        let prov = evallerina::doc_audit::audit_tool_surface(config)?;\n        let mut tool_json = serde_json::json!({\n            \"surface_status\": prov.status,\n            \"surface_tokens\": prov.tokens.len(),\n            \"audit_rows\": 0,\n        });\n        if !prov.tokens.is_empty() {\n            // Only tools with a harvested surface can produce audit\n            // rows; the repo must be a local checkout to scan.\n            let repo = evallerina::routing::resolve_repo(&config.repo, &root_path);\n            let repo_path = std::path::PathBuf::from(&repo);\n            if repo_path.is_dir() {\n                let inv = evallerina::doc_audit::scan_inventory(&repo_path)?;\n                let rows = evallerina::doc_audit::audit(&prov.tokens, &inv);\n                tool_json[\"surfaces\"] = serde_json::json!(inv.surfaces.len());\n                tool_json[\"audit_rows\"] = serde_json::json!(rows.len());\n                audit_rows_all.extend(rows.iter().map(\n                    |r| serde_json::json!({\"tool\": config.tool, \"token\": r.token, \"code\": r.code}),\n                ));\n                if !rows.is_empty() {\n                    report_rows.push(evallerina::doc_audit::report_row(&config.tool, &rows));\n                }\n            } else {\n                provenance.push(serde_json::json!({\n                    \"tool\": config.tool,\n                    \"status\": \"repo_absent\",\n                    \"detail\": format!(\"repo checkout '{repo}' not found — inventory not scanned\"),\n                }));\n                tool_json[\"surfaces\"] = serde_json::json!(0);\n            }\n        }\n        provenance.push(serde_json::json!({\n            \"tool\": prov.tool,\n            \"status\": prov.status,\n            \"detail\": prov.detail,\n        }));\n        tools.insert(config.tool.clone(), tool_json);\n    }\n\n    println!(\n        \"{}\",\n        serde_json::to_string_pretty(&serde_json::json!({\n            \"inventory\": tools,\n            \"provenance\": provenance,\n            \"audit_rows\": audit_rows_all,\n            \"report_rows\": report_rows,\n        }))\n        .expect(\"doc-audit report serializes\")\n    );\n    Ok(ExitCode::SUCCESS)\n}\n\n/// Aggregate a JSONL file of report rows into the fault dashboard.\n/// The configured model registry comes from the checked-in registry;\n/// the channel map from the live scenario registry. Findings do not\n/// affect the exit code — the dashboard is the record, and nonzero\n/// exits are reserved for aggregation errors.\nfn run_report(path: &str, route: bool, file: bool) -> Result<ExitCode, String> {\n    evallerina::report::validate_route_flags(route, file)?;\n    let content = std::fs::read_to_string(path)\n        .map_err(|e| format!(\"cannot read report rows from {path}: {e}\"))?;\n    let rows: Vec<serde_json::Value> = content\n        .lines()\n        .filter(|line| !line.trim().is_empty())\n        .map(|line| serde_json::from_str(line).map_err(|e| format!(\"malformed report row: {e}\")))\n        .collect::<Result<Vec<_>, String>>()?;\n    let configured: Vec<String> = ordered_ids().into_iter().map(String::from).collect();\n    let mut dashboard = evallerina::report::aggregate_rows(\n        &rows,\n        &configured,\n        &evallerina::report::scenario_channel,\n    )?;\n    if route {\n        let mut runner = evallerina::routing::run_bd;\n        evallerina::report::run_routing_step(\n            &mut dashboard,\n            &rows,\n            &configured,\n            std::path::Path::new(path),\n            file,\n            &mut runner,\n        )?;\n    }\n    println!(\n        \"{}\",\n        serde_json::to_string_pretty(&dashboard).expect(\"dashboard serializes\")\n    );\n    Ok(ExitCode::SUCCESS)\n}\n\n/// A/B ablation CLI handler (evallerina-wdx): resolve the named\n/// scenario and model list, run both arms via\n/// [`evallerina::ablation::run_ablation`], write the ArmReport JSONL\n/// rows (full arm first, then ablated, in run order), and print the\n/// per-arm summary + delta as JSON on stdout. Measurement, not a gate:\n/// the exit code is success whenever the ablation ran; errors — unknown\n/// scenario, artifact-path collision, generation failure, unwritable\n/// output — are loud and nonzero, never silent.\nfn run_ablate(\n    scenario: &str,\n    reps: u32,\n    model: Option<String>,\n    dry_run: bool,\n    real_artifacts: bool,\n    budget_mins: u64,\n    out: &str,\n) -> Result<ExitCode, String> {\n    let scenario = evallerina::scenario::live_scenario_by_name(scenario)?;\n    let models: Vec<String> = match model {\n        Some(id) => vec![id],\n        None => ordered_ids().into_iter().map(String::from).collect(),\n    };\n    let artifacts: AixSource<'static> = if real_artifacts {\n        let wai = ToolBinaries::discover_wai().ok_or_else(|| {\n            \"real artifact generation requested but no `wai` binary is on PATH — refusing to fake it\"\n                .to_owned()\n        })?;\n        AixSource::Real(ToolBinaries { wai })\n    } else {\n        AixSource::Static(&DEFAULT_AIX_ARTIFACTS)\n    };\n    // Dry-run: transports are constructed but never called — the zero\n    // budget records every cell absent before any trial starts. No\n    // key required, no network. Non-dry-run: the real tier-2\n    // transport, which refuses to start without OPENROUTER_API_KEY.\n    let report = if dry_run {\n        let mut full_factory = |m: &str| {\n            Ok(Box::new(OpenRouterTransport::new(m, \"dry-run-no-network\"))\n                as Box<dyn evallerina::live::Transport>)\n        };\n        let mut ablated_factory = |m: &str| {\n            Ok(Box::new(OpenRouterTransport::new(m, \"dry-run-no-network\"))\n                as Box<dyn evallerina::live::Transport>)\n        };\n        run_ablation(\n            &scenario,\n            &models,\n            reps,\n            artifacts,\n            AblationFactories {\n                full: &mut full_factory,\n                ablated: &mut ablated_factory,\n            },\n            &evallerina::live::Bounds::default(),\n            &|| false,\n        )\n    } else {\n        let start = Instant::now();\n        let budget = Duration::from_secs(budget_mins * 60);\n        let mut full_factory = |m: &str| {\n            OpenRouterTransport::from_env(m)\n                .map(|t| Box::new(t) as Box<dyn evallerina::live::Transport>)\n        };\n        let mut ablated_factory = |m: &str| {\n            OpenRouterTransport::from_env(m)\n                .map(|t| Box::new(t) as Box<dyn evallerina::live::Transport>)\n        };\n        run_ablation(\n            &scenario,\n            &models,\n            reps,\n            artifacts,\n            AblationFactories {\n                full: &mut full_factory,\n                ablated: &mut ablated_factory,\n            },\n            &evallerina::live::Bounds::default(),\n            &|| start.elapsed() < budget,\n        )\n    }?;\n\n    let mut rows = std::fs::File::create(out)\n        .map_err(|e| format!(\"cannot write report rows to {out}: {e}\"))?;\n    for event in report.full_rows.iter().chain(&report.ablated_rows) {\n        writeln!(\n            rows,\n            \"{}\",\n            serde_json::to_string(event).expect(\"row serializes\")\n        )\n        .map_err(|e| format!(\"cannot write report rows to {out}: {e}\"))?;\n    }\n    let summary = serde_json::json!({\n        \"ablation_version\": report.ablation_version,\n        \"scenario\": report.scenario,\n        \"full\": report.full,\n        \"ablated\": report.ablated,\n        \"delta\": report.delta,\n    });\n    println!(\n        \"{}\",\n        serde_json::to_string_pretty(&summary).expect(\"summary serializes\")\n    );\n    Ok(ExitCode::SUCCESS)\n}\n\n[1 more lines in file. Use offset=514 to continue.]"}],"isError":false,"timestamp":1792528692763},{"role":"toolResult","toolCallId":"call_0c3b2bba5e604adc95dca163","toolName":"bash","content":[{"type":"text","text":"# routing.toml — fault→ticket routing map (openspec add-fault-ticket-routing,\n# expanded to the full ecosystem by evallerina-0sy /\n# add-ecosystem-doc-evals D2). Maps each dulce-de-leche family tool to the\n# repository its tickets live in. The managed tool list is mirrored from\n# ddl's MANAGED-TOOLS block (../dulce-de-leche/README.md) and enforced by\n# the tier-0 routing-parity gate (`evallerina routing-parity`; drift fails\n# `just tier0` via tests/routing_parity.rs).\n#\n# Relative paths resolve against the evallerina repo root (git rev-parse\n# --show-toplevel, worktree-safe); absolute paths pass through (target-repo\n# worktrees). Entries marked `upstream = true` are third-party: mapped for\n# parity completeness, but never filed in (filing semantics: e4x).\n\n[wai]\nrepo = \"../wai\"\n\n[genesis]\nrepo = \"../genesis\"\n\n[espectacular]\nrepo = \"../espectacular\"\n\n[dont]\nrepo = \"../dont\"\n\n# --- managed tools beyond the original four (evallerina-0sy) ---\n\n[testaruda]\nrepo = \"../testaruda\"\n\n# turu's repo is `whisper` (binary/crate name mismatch; ddl canonical table).\n[turu]\nrepo = \"../whisper\"\n\n# `ah` shares the espectacular checkout (binary name of the espectacular CLI).\n[ah]\nrepo = \"../espectacular\"\n\n[pretender]\nrepo = \"../pretender\"\n\n[vampiro]\nrepo = \"../vampiro\"\n\n[incitaciones]\nrepo = \"../incitaciones\"\n\n# Third-party upstreams: mapped (parity requires the entry), never filed.\n[openspec]\nrepo = \"fission-ai/openspec\"\nupstream = true\n\n[specodelic]\nrepo = \"../specodelic\"\n\n[funkalization]\nrepo = \"../funkalization\"\n\n[wild]\nrepo = \"../wild\"\n\n[dulce-de-leche]\nrepo = \"../dulce-de-leche\"\n\n[bd]\nrepo = \"gastownhall/beads\"\nupstream = true\n----\n# doc_audit.toml — tier-0 doc-coverage audit config (evallerina-fok,\n# openspec add-ecosystem-doc-evals D1/D4). One `[tool]` section per\n# routing.toml tool. Relative `repo` paths resolve against the\n# evallerina repo root (same rules as routing.toml).\n#\n# Per tool:\n#   repo     — the repository whose doc surfaces are scanned\n#              (README.md, docs/**, llms.txt, AGENTS.md managed blocks)\n#   binary   — binary probed with `--help`; defaults to the tool name\n#   surface  — \"none\" for tools that are not --help-probeable CLIs:\n#              they skip the binary step and are recorded in\n#              provenance, never silently skipped.\n#\n# A missing binary records `binary_absent` provenance; a missing local\n# checkout records `repo_absent`. Every skip is provenance (anti-goal:\n# no silent skips).\n\n[wai]\nrepo = \"../wai\"\n\n[genesis]\nrepo = \"../genesis\"\n\n[espectacular]\nrepo = \"../espectacular\"\n\n[dont]\nrepo = \"../dont\"\n\n[testaruda]\nrepo = \"../testaruda\"\n\n# turu's repo is `whisper` (binary/crate name mismatch; ddl canonical table).\n[turu]\nrepo = \"../whisper\"\nbinary = \"turu\"\n\n# `ah` shares the espectacular checkout (binary name of the espectacular CLI).\n[ah]\nrepo = \"../espectacular\"\n\n[pretender]\nrepo = \"../pretender\"\n\n[vampiro]\nrepo = \"../vampiro\"\n\n[incitaciones]\nrepo = \"../incitaciones\"\n\n# Third-party upstreams: not locally checked-out Rust CLIs — surface\n# none, provenance-recorded, never silent.\n[openspec]\nrepo = \"fission-ai/openspec\"\nsurface = \"none\"\n\n[specodelic]\nrepo = \"../specodelic\"\n\n[funkalization]\nrepo = \"../funkalization\"\n\n[wild]\nrepo = \"../wild\"\n\n[dulce-de-leche]\nrepo = \"../dulce-de-leche\"\n\n[bd]\nrepo = \"gastownhall/beads\"\nsurface = \"none\"\n----\n# evallerina — eval battery for the dulce-de-leche tool family\n# Tier ladder per genesis evals-guidelines: 0 static (push) / 1 replay (nightly) / 2 live (scheduled)\n\ndefault:\n    @just --list\n\n# Tier 0 — static checks, no model (gates every push)\ntier0:\n    cargo fmt --check\n    cargo clippy -- -D warnings\n    cargo test\n    cargo run --quiet -- doc-audit > /dev/null\n\n# Tier 1 — scripted replay of recorded AgentStep transcripts, no model, no network\ntier1:\n    cargo test --test evals_replay -- --nocapture\n\n# Tier 2 — live rotation (requires OPENROUTER_API_KEY); never gates a push.\n# One JSON event per cell on stdout (trial row or absent record).\ntier2 model=\"openrouter/free\" scenario=\"\" budget=\"20\":\n    #!/usr/bin/env bash\n    set -euo pipefail\n    args=(live --model \"{{model}}\" --budget-mins \"{{budget}}\")\n    if [ -n \"{{scenario}}\" ]; then args+=(\"{{scenario}}\"); fi\n    cargo run --release -- \"${args[@]}\"\n\n# Build + test the harness crate\nci: tier0\n\n# Fixture sandbox smoke test: provision binaries, run one replay scenario\n"}],"isError":false,"timestamp":1792528692763}]}
