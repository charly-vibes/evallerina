{"type":"message_update","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"assistantMessageEvent":{"type":"toolcall_delta","contentIndex":1,"delta":",\"edits\":[{\"oldText\":\"pub fn propose(\\n    rows: &[serde_json::Value],\\n    configured_models: &[String],\\n    scenario_tool_of: &dyn Fn(&str) -> Option<String>,\\n    repo_map: &BTreeMap<String, String>,\\n) -> Result<Vec<ProposalRow>, String> {\",\"newText\":\"pub fn propose(\\n    rows: &[serde_json::Value],\\n    configured_models: &[String],\\n    scenario_tool_of: &dyn Fn(&str) -> Option<String>,\\n    repo_map: &BTreeMap<String, crate::routing_parity::RoutingEntry>,\\n) -> Result<Vec<ProposalRow>, String> {\"},{\"oldText\":\"/// `repo_map` maps tool name → repo path (the\\n/// parsed routing.toml); a mapped-but-unregistered tool surfaces as\\n/// `skipped`/`unmapped_tool`, never a silent drop.\",\"newText\":\"/// `repo_map` maps tool name → routing target (the parsed routing.toml\\n/// via [`crate::routing_parity::parse_routing_entries`], including the\\n/// `upstream` flag); a mapped-but-unregistered tool surfaces as\\n/// `skipped`/`unmapped_tool`, an `upstream = true` tool as\\n/// `skipped`/`unmapped_upstream` — never a silent drop.\"},{\"oldText\":\"/// Parse routing.toml content into the tool → repo map. Structure is\\n/// deliberately minimal: `[<tool>]` tables with a `repo` string.\\npub fn parse_routing_toml(content: &str) -> Result<BTreeMap<String, String>, String> {\\n    let value: toml::Value =\\n        toml::from_str(content).map_err(|e| format!(\\\"routing.toml parse error: {e}\\\"))?;\\n    let mut map = BTreeMap::new();\\n    let table = value\\n        .as_table()\\n        .ok_or(\\\"routing.toml must be a table of [tool] sections\\\")?;\\n    for (tool, item) in table {\\n        let repo = item\\n            .get(\\\"repo\\\")\\n            .and_then(toml::Value::as_str)\\n            .ok_