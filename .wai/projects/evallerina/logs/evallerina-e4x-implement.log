P8kB1wLs4hZZ8S","rawStopReason":"tool_calls"},"toolResults":[{"role":"toolResult","toolCallId":"call-055c3bff-bb12-4b45-9492-43307ca8f9fb","toolName":"read","content":[{"type":"text","text":"//! Purpose: Library core of the evallerina harness — the consumer eval\n//! battery for the dulce-de-leche tool family (wai first, most adopted).\n//! Responsibilities: parse the family's envelope channels (which drift\n//! from genesis's generic `hints` shape), load recorded agent\n//! trajectories from `scenarios/`, and assemble tier-1 replay scenarios\n//! with deterministic checks from `genesis::evals`.\n//! Rationale: process-boundary scoring per the genesis evals-guidelines\n//! spec — the harness only ever asserts on captured stdout/stderr, exit\n//! codes, and fixture state; free-form agent text is never scored. The\n//! dulce-specific envelope readers live here because the reusable\n//! genesis helpers assume a top-level `hints` array, while real tool\n//! output (wai 2026.10.5) carries remediation under `data.remediation`.\n\npub mod ablation;\npub mod doc_audit;\npub mod envelope;\npub mod live;\npub mod recorded;\npub mod registry;\npub mod report;\npub mod routing;\npub mod routing_parity;\npub mod scenario;\n"}],"isError":false,"timestamp":1792529112717},{"role":"toolResult","toolCallId":"call-bd50d1a0-5666-4cf6-8188-c4e9736c1b92","toolName":"bash","content":[{"type":"text","text":"88-/// Parse routing.toml content into `[tool]` → [`RoutingEntry`]. Every\n89-/// entry must carry a non-empty `repo` string; `upstream` is optional\n90-/// and must be a boolean when present. Structure mirrors\n91:/// [`crate::routing::parse_routing_toml`] (tool → repo strings) with\n92-/// the additive `upstream` flag; parse failures are loud errors.\n93-pub fn parse_routing_entries(content: &str) -> Result<BTreeMap<String, RoutingEntry>, String> {\n94-    let value: toml::Value =\n95-        toml::from_str(content).map_err(|e| format!(\"routing.toml parse error: {e}\"))?;\n96-    let table = value\n97-        .as_table()\n98-        .ok_or(\"routing.toml must be a table of [tool] sections\")?;\n99-    let mut map = BTreeMap::new();\n100-    for (tool, item) in table {\n101-        let repo = item\n===\n//! Purpose: End-to-end CLI contract tests for the `evallerina ablate`\n//! subcommand (evallerina-wdx, evals.md Step 5).\n//! Responsibilities: pin the CLI surface — `ablate --help` exits 0 and\n//! names the scenario arg — and the hermetic dry-run path: a temp\n//! sandbox run with zero budget writes the ArmReport JSONL rows and the\n//! summary without any model call or network, and bad paths fail\n//! loudly, never silently.\n//! Rationale: the ablation CLI is the production entry to the A/B\n//! harness; its contract (no silent degradation, rows are the record)\n//! must hold end to end through the binary, not just through the\n//! library API.\n\nuse std::process::Command;\n\nuse serde_json::Value;\n\nfn bin() -> Command {\n    Command::new(env!(\"CARGO_BIN_EXE_evallerina\"))\n}\n\n/// A fresh unique temp sandbox dir; removed after use.\nfn sandbox(tag: &str) -> std::path::PathBuf {\n    let dir = std::env::temp_dir().join(format!(\n        \"evallerina-ablate-cli-{tag}-{}-{}\",\n        std::process::id(),\n        std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .expect(\"clock\")\n            .as_nanos(),\n    ));\n    std::fs::create_dir_all(&dir).expect(\"create sandbox\");\n    dir\n}\n\n/// Step 2 (evallerina-wdx): end-to-end dry-run in a temp sandbox — no\n/// network, no model call, no OPENROUTER_API_KEY — writes the ArmReport\n/// JSONL rows and prints the summary. With a zero budget every cell is\n/// recorded absent (registry × reps × 2 arms), the rows carry the arm\n/// field, and the delta stays null (undefined is never zero).\n#[test]\nfn ablate_dry_run_writes_report_files_in_temp_sandbox() {\n    let dir = sandbox(\"dry-run\");\n    let rows_path = dir.join(\"rows.jsonl\");\n    let out = bin()\n        .args([\n            \"ablate\",\n            \"wai-hint-adherence-smoke\",\n            \"--dry-run\",\n            \"--out\",\n            rows_path.to_str().unwrap(),\n        ])\n        .env_remove(\"OPENROUTER_API_KEY\")\n        .output()\n        .expect(\"run ablate dry-run\");\n    assert!(\n        out.status.success(),\n        \"dry-run succeeds without a key or network: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n\n===\n    /// first in the registry ordering.\n    pub free: bool,\n}\n\n/// The checked-in ordered registry. `:free` ids first (scheduling\n/// priority), paid ids after. Nothing is special-cased beyond ordering.\npub const REGISTRY: &[RegistryEntry] = &[\n    RegistryEntry {\n        id: \"openrouter/free\",\n        free: true,\n    },\n    RegistryEntry {\n        id: \"deepseek/deepseek-v4-flash:free\",\n        free: true,\n    },\n    RegistryEntry {\n        id: \"qwen/qwen3-coder:free\",\n        free: true,\n    },\n    RegistryEntry {\n        id: \"meta-llama/llama-3.3-70b-instruct:free\",\n        free: true,\n    },\n];\n\n/// Default repetitions per scenario × model cell (n>=3 by policy).\npub const DEFAULT_REPETITIONS: u32 = 3;\n\n/// Registry ids in scheduling order, verbatim.\npub fn ordered_ids() -> Vec<&'static str> {\n    REGISTRY.iter().map(|e| e.id).collect()\n}\n\n/// The free-tier entries, in registry order.\npub fn free_ids() -> Vec<&'static str> {\n    REGISTRY.iter().filter(|e| e.free).map(|e| e.id).collect()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    /// Free-tier ids sort first and their ids are preserved verbatim.\n    /// Free-tier membership is the `free` flag, not the `:free` suffix:\n    /// `openrouter/free` routes to OpenRouter's free catalog without a\n    /// suffix.\n    #[test]\n    fn free_ids_first_and_verbatim() {\n        let ids = ordered_ids();\n        let free_count = free_ids().len();\n        for (i, id) in ids.iter().take(free_count).enumerate() {\n===\n453:    let repo_map = [(\"wai\".to_owned(), \"../wai\".to_owned())].into();\n456:    let proposals = evallerina::report::attach_routing(\n460:        &repo_map,\n620:    let proposals = evallerina::report::attach_routing(\n650:    let repo_map = [(\"wai\".to_owned(), \"../wai\".to_owned())].into();\n653:    let proposals = evallerina::report::attach_routing(\n657:        &repo_map,\n"}],"isError":false,"timestamp":1792529112717}]}
