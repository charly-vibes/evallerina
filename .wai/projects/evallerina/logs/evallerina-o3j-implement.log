r per genesis evals-guidelines: 0 static (push) / 1 replay (nightly) / 2 live (scheduled)\n\ndefault:\n    @just --list\n\n# Tier 0 — static checks, no model (gates every push)\ntier0:\n    cargo fmt --check\n    cargo clippy -- -D warnings\n    cargo test\n\n# Tier 1 — scripted replay of recorded AgentStep transcripts, no model, no network\ntier1:\n    cargo test --test evals_replay -- --nocapture\n\n# Tier 2 — live rotation (requires OPENROUTER_API_KEY); never gates a push.\n# One JSON event per cell on stdout (trial row or absent record).\ntier2 model=\"openrouter/free\" scenario=\"\" budget=\"20\":\n    #!/usr/bin/env bash\n    set -euo pipefail\n    args=(live --model \"{{model}}\" --budget-mins \"{{budget}}\")\n    if [ -n \"{{scenario}}\" ]; then args+=(\"{{scenario}}\"); fi\n    cargo run --release -- \"${args[@]}\"\n\n# Build + test the harness crate\nci: tier0\n\n# Fixture sandbox smoke test: provision binaries, run one replay scenario\nsmoke:\n    cargo run --release -- smoke\n"}],"isError":false,"timestamp":1792429940055},{"role":"assistant","content":[{"type":"toolCall","id":"call-e149d7e1-3cb6-48dc-b0eb-5e2c12916077","name":"bash","arguments":{"command":"cat routing.toml; echo ---; sed -n 360,435p src/routing.rs","timeout":10}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":5632,"output":37,"cacheRead":26880,"cacheWrite":0,"reasoning":0,"totalTokens":32549,"cost":{"input":0.0008447999999999999,"output":0.0000185,"cacheRead":0.0008064,"cacheWrite":0,"total":0.0016696999999999999}},"stopReason":"toolUse","timestamp":1792429940057,"responseId":"gen-1792429940-eNKVwVUXDHN8MIbdGdfh","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call-e149d7e1-3cb6-48dc-b0eb-5e2c12916077","toolName":"bash","content":[{"type":"text","text":"# routing.toml — fault→ticket routing map (openspec add-fault-ticket-routing)\n# Maps each dulce-de-leche family tool to the repository its tickets live in.\n# Relative paths resolve against the evallerina repo root (git rev-parse\n# --show-toplevel, worktree-safe); absolute paths pass through (target-repo\n# worktrees). Filing is evallerina-2bz; dry-run proposals reference these\n# paths from Phase 1 onward.\n\n[wai]\nrepo = \"../wai\"\n\n[genesis]\nrepo = \"../genesis\"\n\n[espectacular]\nrepo = \"../espectacular\"\n\n[dont]\nrepo = \"../dont\"\n---\n        // Dedup: `bd search <token> --status open --json` first (title\n        // search); the token lives in the issue BODY, so fall back to\n        // `bd list --status open --json` + grep — same status filter.\n        let search = run_bd(&cwd, &[\"search\", &row.token, \"--status\", \"open\", \"--json\"])\n            .ok()\n            .and_then(|out| bd_issue_array(&out));\n        let found = match search {\n            Some(issues) if any_issue_holds_token(&issues, &row.token) => true,\n            _ => run_bd(&cwd, &[\"list\", \"--status\", \"open\", \"--json\"])\n                .ok()\n                .and_then(|out| bd_issue_array(&out))\n                .map(|issues| any_issue_holds_token(&issues, &row.token))\n                .unwrap_or(false),\n        };\n        if found {\n            row.decision = \"existing\".to_owned();\n            row.reason = None;\n            continue; // bd_issue_id stays null: set only for `filed`.\n        }\n\n        // File: `bd create` in the target repo cwd, exit code + id.\n        let title = format!(\"[evallerina] {}: {}\", row.fault_class, row.scenario);\n        let body = format!(\n            \"{}\\ntool: {}\\nfiled by evallerina fault routing (openspec add-fault-ticket-routing)\",\n            row.token, row.tool\n        );\n        match run_bd(&cwd, &[\"create\", &title, \"-d\", &body, \"--json\"]) {\n            Ok(out) if out.status.success() => {\n                let id = serde_json::from_slice::<serde_json::Value>(&out.stdout)\n                    .ok()\n                    .and_then(|v| v[\"id\"].as_str().map(String::from));\n                match id {\n                    Some(id) => {\n                        row.decision = \"filed\".to_owned();\n                        row.reason = None;\n                        row.bd_issue_id = Some(id);\n                        // Tracked-export invariant: refresh the JSONL\n                        // source of truth after a successful create.\n                        // Export failure is not fatal to the report.\n                        let _ = run_bd(&cwd, &[\"export\", \"-o\", \".beads/issues.jsonl\"]);\n                    }\n                    // Create succeeded but the id is unparseable — treat\n                    // as a bd failure rather than claim a filing we\n                    // cannot link (follow-up threshold: no per-version\n                    // output-format parsers).\n                    None => {\n                        row.decision = \"skipped\".to_owned();\n                        row.reason = Some(\"bd_failure\".to_owned());\n                    }\n                }\n            }\n            Ok(_) | Err(_) => {\n                row.decision = \"skipped\".to_owned();\n                row.reason = Some(\"bd_failure\".to_owned());\n            }\n        }\n    }\n    Ok(())\n}\n\n/// Discover the evallerina repo root (worktree-safe) for relative\n/// routing.toml path resolution.\npub fn discover_root() -> Result<String, String> {\n    let out = std::process::Command::new(\"git\")\n        .args([\"rev-parse\", \"--show-toplevel\"])\n        .output()\n        .map_err(|e| format!(\"cannot run git for repo root: {e}\"))?;\n    if !out.status.success() {\n        return Err(format!(\n            \"git rev-parse --show-toplevel failed: {}\",\n            String::from_utf8_lossy(&out.stderr)\n        ));\n    }\n    Ok(String::from_utf8_lossy(&out.stdout).trim().to_owned())\n}\n"}],"isError":false,"timestamp":1792429944282},{"role":"assistant","content":[{"type":"thinking","thinking":"Now let me check lib.rs expo