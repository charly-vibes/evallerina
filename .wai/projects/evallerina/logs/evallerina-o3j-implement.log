p = crate::routing::parse_routing_toml(&content)?;\n    let proposals = attach_routing(\n        dashboard,\n        rows,\n        configured_models,\n        &repo_map,\n        file_authorized,\n        run_bd,\n    )?;\n    let jsonl = crate::routing::to_jsonl(&proposals);\n    let out_path = report_path\n        .parent()\n        .unwrap_or(std::path::Path::new(\".\"))\n        .join(\"proposed-tickets.jsonl\");\n    std::fs::write(&out_path, jsonl)\n        .map_err(|e| format!(\"cannot write {}: {e}\", out_path.display()))?;\n    Ok(proposals)\n}"}]}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":7143,"output":1209,"cacheRead":35840,"cacheWrite":0,"reasoning":0,"totalTokens":44192,"cost":{"input":0.00107145,"output":0.0006045,"cacheRead":0.0010752,"cacheWrite":0,"total":0.00275115}},"stopReason":"toolUse","timestamp":1792430172656,"responseId":"gen-1792430172-ezfyeDjntjWFyPkt1LP2","rawStopReason":"tool_calls"},"toolResults":[{"role":"toolResult","toolCallId":"call-a9afb306-fb24-41ef-afd7-a2df7f29f992","toolName":"edit","content":[{"type":"text","text":"Successfully replaced 1 block(s) in src/report.rs."}],"details":{"diff":"     ...\n  29     }\n  30     Ok(())\n  31 }\n  32 \n+ 33 /// The scenario definition's recorded tool — the repo key for routing\n+ 34 /// (routing.rs keys proposals on this, never the report row's `tool`\n+ 35 /// field, which is hardcoded for live trials). Scenario names\n+ 36 /// prefix-encode the eval target by convention (`wai-*`, `dont-*`);\n+ 37 /// an unknown prefix is None → a loud error downstream (never a\n+ 38 /// silent bucket, mirroring aggregate_rows).\n+ 39 pub fn scenario_tool_of(name: &str) -> Option<String> {\n+ 40     if name.starts_with(\"wai-\") {\n+ 41         Some(\"wai\".to_owned())\n+ 42     } else if name.starts_with(\"dont-\") {\n+ 43         Some(\"dont\".to_owned())\n+ 44     } else {\n+ 45         None\n+ 46     }\n+ 47 }\n+ 48 \n+ 49 /// Run the routing s