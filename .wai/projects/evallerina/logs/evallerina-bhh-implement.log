{"type":"message_update","usage":{"input":187,"output":416,"cacheRead":27392,"cacheWrite":0,"reasoning":1,"totalTokens":27995,"cost":{"input":0.000028049999999999997,"output":0.000208,"cacheRead":0.0008217599999999999,"cacheWrite":0,"total":0.00105781}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":0,"toolCall":{"type":"toolCall","id":"call_65217d8d68354d01b8b3055f","name":"edit","arguments":{"edits":[{"newText":"#[test]\nfn every_live_scenario_declares_a_channel() {\n    for scenario in live_scenarios() {\n        assert!(\n            evallerina::report::scenario_channel(&scenario.name).is_some(),\n            \"live scenario '{}' has no output-channel declaration\",\n            scenario.name\n        );\n    }\n}\n\n/// The archetype scenarios join the battery (evallerina-bhh) and must\n/// resolve to the channel their checks probe — the archetype family\n/// mappings in `scenario_channel`. vampiro-polyglot-seam asserts on\n/// vampiro's gate/guidance JSON envelopes; wai-drifted-ecosystem is the\n/// archetype cousin of the doc-drift family (same stale-AGENTS.md\n/// artifact probe via doc_drift_blindness), so it maps to `artifact`\n/// like its siblings.\n#[test]\nfn archetype_scenarios_declare_channels() {\n    assert_eq!(\n        scenario_channel(\"vampiro-polyglot-seam\"),\n        Some(\"envelope\"),\n        \"polyglot seam probes vampiro's gate/guidance envelopes\"\n    );\n    assert_eq!(\n        scenario_channel(\"wai-drifted-ecosystem\"),\n        Some(\"artifact\"),\n        \"drifted ecosystem probes the stale-docs artifact like the doc-drift family\"\n    );\n}","oldText":"#[test]\nfn every_live_scenario_declares_a_channel() {\n    for scenario in live_scenarios() {\n        assert!(\n            evallerina::report::scenario_channel(&scenario.name).is_some(),\n            \"live scenario '{}' has no output-channel declaration\",\n            scenario.name\n        );\n    }\n}"}],"path":"tests/report_aggregation.rs"}}}}
