erever battery-shape tests live\n\n## Red/green sequence\n1. RED: battery contains 'vampiro-polyglot-seam' and 'wai-drifted-ecosystem';\n   live_scenario_by_name resolves both. GREEN.\n2. RED: rotation eligibility — every scenario in live_scenarios() has\n   channel_of mapping (src/report.rs scenario_channel) so the dashboard\n   never errors on unknown scenario. If polyglot/drifted lack channels, add\n   mappings (archetype channel family). GREEN.\n\n## Anti-goals\n- The 4 stub fixtures (legacy-monolith, ai-native-greenfield,\n  high-compliance, devops-headless) stay OUT of the battery — TODO.md is\n  their home, do not register stubs\n- No changes to recorded scenario JSON files\n- No rotation threshold changes\n\n## Commands\n- `cargo test` per step; `just tier0` at end\n\n## Follow-up threshold\nIf channel semantics resist archetype scenarios (>1h), STOP and record.\n\n## Spawn model\nDefault implementor; context ceiling ≤ 50%.\n"}],"isError":false,"timestamp":1792436583657},{"role":"toolResult","toolCallId":"call_bb5b4d6a565a4d5284d07057","toolName":"bash","content":[{"type":"text","text":"ablation.rs\nenvelope.rs\nlib.rs\nlive.rs\nmain.rs\nrecorded.rs\nregistry.rs\nreport.rs\nrouting.rs\nscenario.rs\n  451 src/scenario.rs\n  464 src/report.rs\n  915 total\n"}],"isError":false,"timestamp":1792436583657},{"role":"assistant","content":[{"type":"toolCall","id":"call_60e466c650364643b034c2d6","name":"bash","arguments":{"command":"grep -n \"live_scenarios\\|polyglot_seam_scenario\\|drifted_ecosystem_scenario\\|live_scenario_by_name\" src/*.rs tests/*.rs 2>/dev/null | head -40; ls tests/","timeout":30}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":636,"output":66,"cacheRead":11008,"cacheWrite":0,"reasoning":1,"totalTokens":11710,"cost":{"input":0.0000954,"output":0.000032999999999999996,"cacheRead":0.00033024,"cacheWrite":0,"total":0.00045863999999999996}},"stopReason":"toolUse","timestamp":1792436583660,"responseId":"gen-1792436583-4nyIVbumoZRZs0cvOvuA","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_60e466c650364643b034c2d6","toolName":"bash","content":[{"type":"text","text":"src/main.rs:22:use evallerina::scenario::{SCENARIOS_DIR, live_scenario_by_name, live_scenarios, smoke_scenario};\nsrc/main.rs:202:        Some(name) => vec![live_scenario_by_name(&name)?],\nsrc/main.rs:203:        None => live_scenarios(),\nsrc/main.rs:295:    let scenario = evallerina::scenario::live_scenario_by_name(scenario)?;\nsrc/scenario.rs:57:pub fn live_scenarios() -> Vec<Scenario> {\nsrc/scenario.rs:70:pub fn live_scenario_by_name(name: &str) -> Result<Scenario, String> {\nsrc/scenario.rs:71:    let all = live_scenarios();\nsrc/scenario.rs:73:        let names: Vec<String> = live_scenarios().iter().map(|s| s.name.clone()).collect();\nsrc/scenario.rs:381:pub fn polyglot_seam_scenario() -> Scenario {\nsrc/scenario.rs:434:pub fn drifted_ecosystem_scenario() -> Scenario {\ntests/evals_replay.rs:12:    dont_doc_drift_scenario, dont_lifecycle_scenario, drifted_ecosystem_scenario,\ntests/evals_replay.rs:13:    polyglot_seam_scenario, smoke_scenario, wai_corrupt_config_scenario, wai_doc_drift_scenario,\ntests/evals_replay.rs:480:    let report = polyglot_seam_scenario()\ntests/evals_replay.rs:496:    let report = drifted_ecosystem_scenario()\ntests/report_aggregation.rs:17:use evallerina::scenario::live_scenarios;\ntests/report_aggregation.rs:676:    for scenario in live_scenarios() {\nablate_cli.rs\nablation.rs\nevals_replay.rs\nlive_protocol.rs\nreport_aggregation.rs\nrouting.rs\n"}],"isError":false,"timestamp":1792436588290},{"role":"assistant","content":[{"type":"toolCall","id":"call_9d71dae1705f463db6458d82","name":"read","arguments":{"limit":100,"offset":1,"path":"src/scenario.rs"}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":582,"output":26,"cacheRead":11520,"cacheWrite":0,"reasoning":1,"totalTokens":12128,"cost":{"input":0.0000873,"output":0.000013,"cacheRead":0.00034559999999999994,"cacheWrite":0,"total":0.00044589999999999994}},"stopReason":"toolUse","timestamp":1792436588292,"responseId":"gen-1792436588-kQ5XhVUv4XaPckwbk6Zf","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_9d71dae1705f463db6458d82","toolName":"read","content":[{"type":"text","text":"//! Purpose: Scenario definitions for the evallerina battery.\n//! Responsibilities: assemble tier-1 replay scenarios — fixture setup,\n//! agent prompt, and deterministic checks — starting with the smoke\n//! Must gate of evallerina-e10 (one recorded wai trajectory proving the\n//! harness end-to-end).\n//! Rationale: scenarios follow the eval formula (fixture + prompt +\n//! deterministic checks + error code) and carry provenance in the\n//! recorded trajectory file. New scenario families (hint adherence,\n//! doc-drift blindness, managed-block audits) land here as separate\n//! tickets with their own recorded fixtures.\n\nuse crate::envelope::{\n    agent_followed_hint_matching, envelope_field_is, error_envelope_with_hint_containing,\n    error_envelope_with_hint_matching, error_envelope_with_remediation_hint, exit_code_is,\n    ok_envelope_loose, stderr_did_you_mean,\n};\nuse genesis::evals::{\n    DistractorKind, Scenario, agent_executed_all, agent_followed_hint, doc_drift_blindness,\n};\n\n/// Directory holding recorded trajectories, relative to the crate root.\npub const SCENARIOS_DIR: &str = \"scenarios\";\n\n/// Subdirectory holding the hint-adherence family (evallerina-ey7).\npub const HINT_ADHERENCE_DIR: &str = \"scenarios/hint-adherence\";\n\n/// Subdirectory holding the doc-drift blindness family (evallerina-7y1).\npub const DOC_DRIFT_DIR: &str = \"scenarios/doc-drift\";\n\n/// Directory holding archetype smoke trajectories (`scenarios/archetypes/`,\n/// evallerina-sqq).\npub const ARCHETYPE_DIR: &str = \"scenarios/archetypes\";\n\n/// The smoke scenario (evallerina-e10 Must gate).\n///\n/// Replay