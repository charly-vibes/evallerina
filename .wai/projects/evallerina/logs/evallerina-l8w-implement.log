: &str, row_tool: &str, model: &str) -> serde_json::Value {\n    json!({\n        \"kind\": \"trial\",\n        \"report_version\": 1,\n        \"scenario\": scenario,\n        \"tool\": row_tool,\n        \"model\": model,\n        \"status\": \"failed\",\n        \"checks\": [{\"name\": \"envelope_hint_absent\", \"passed\": false}]\n    })\n}\n\nfn three_models() -> Vec<String> {\n    vec![\"m/a\".into(), \"m/b\".into(), \"m/c\".into()]\n}\n\nfn recorded_wai(scenario: &str) -> Option<&'static str> {\n    (scenario == \"wai-hint-adherence-typo\").then_some(\"wai\")\n}\n\nfn repo_map() -> std::collections::BTreeMap<String, String> {\n    [(\"wai\".to_owned(), \"../wai\".to_owned())].into()\n}\n\n#[test]\nfn threshold_tool_fault_becomes_dry_run_proposal() {\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    assert_eq!(proposals.len(), 1, \"one fault key above threshold\");\n    let p = &proposals[0];\n    assert_eq!(p[\"scenario\"], \"wai-hint-adherence-typo\");\n    assert_eq!(p[\"fault_class\"], \"tool_fault\");\n    assert_eq!(p[\"token\"], \"evallerina:wai-hint-adherence-typo:tool_fault\");\n    assert_eq!(p[\"decision\"], \"dry_run\");\n    assert_eq!(p[\"reason\"], serde_json::Value::Null);\n    assert_eq!(p[\"bd_issue_id\"], serde_json::Value::Null);\n}\n\n#[test]\nfn below_threshold_is_no_proposal() {\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\"] // 2 distinct < 3\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals =\n        routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n            .expect(\"routing succeeds\");\n    assert!(proposals.is_empty(), \"below threshold → recorded, no action\");\n}\n"}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":298,"output":888,"cacheRead":68928,"cacheWrite":0,"reasoning":83,"totalTokens":70114,"cost":{"input":0.000044699999999999996,"output":0.000444,"cacheRead":0.0020678399999999996,"cacheWrite":0,"total":0.0025565399999999995}},"stopReason":"toolUse","timestamp":1792426236910,"responseId":"gen-1792426237-BCvewpYki7HAZnCUJ7sc","rawStopReason":"tool_calls"},"toolResults":[{"role":"toolResult","toolCallId":"call-5a53716b-8814-4113-a685-6fdc200d71ce","toolName":"write","content":[{"type":"text","text":"Successfully wrote to tests/routing.rs"}],"isError":false,"timestamp":1792426244851}]}
