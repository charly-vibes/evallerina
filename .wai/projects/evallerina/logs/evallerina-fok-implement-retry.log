lures (the dashboard is the record);\n+/// nonzero exit is reserved for loud errors: missing/malformed config,\n+/// unreadable surfaces.\n+fn run_doc_audit() -> Result<ExitCode, String> {\n+    let root = evallerina::routing::discover_root()?;\n+    let root_path = std::path::PathBuf::from(&root);\n+    let config_path = root_path.join(\"doc_audit.toml\");\n+    let config_src = std::fs::read_to_string(&config_path)\n+        .map_err(|e| format!(\"cannot read {}: {e}\", config_path.display()))?;\n+    let configs = evallerina::doc_audit::parse_config(&config_src)?;\n+\n+    let mut provenance = Vec::new();\n+    let mut tools = serde_json::Map::new();\n+    let mut report_rows = Vec::new();\n+    let mut audit_rows_all = Vec::new();\n+    for config in &configs {\n+        let prov = evallerina::doc_audit::audit_tool_surface(config)?;\n+        let mut tool_json = serde_json::json!({\n+            \"surface_status\": prov.status,\n+            \"surface_tokens\": prov.tokens.len(),\n+            \"audit_rows\": 0,\n+        });\n+        if !prov.tokens.is_empty() {\n+            // Only tools with a harvested surface can produce audit\n+            // rows; the repo must be a local checkout to scan.\n+            let repo = evallerina::routing::resolve_repo(&config.repo, &root_path);\n+            let repo_path = std::path::PathBuf::from(&repo);\n+            if repo_path.is_dir() {\n+                let inv = evallerina::doc_audit::scan_inventory(&repo_path)?;\n+                let rows = evallerina::doc_audit::audit(&prov.tokens, &inv);\n+                tool_json[\"surfaces\"] = serde_json::json!(inv.surfaces.len());\n+                tool_json[\"audit_rows\"] = serde_json::json!(rows.len());\n+                audit_rows_all.extend(\n+                    rows.iter().map(|r| {\n+                        serde_json::json!({\"tool\": config.tool, \"token\": r.token, \"code\": r.code})\n+                    }),\n+                );\n+                if !rows.is_empty() {\n+                    report_rows.push(evallerina::doc_audit::report_row(&config.tool, &rows));\n+                }\n+            } else {\n+                provenance.push(serde_json::json!({\n+                    \"tool\": config.tool,\n+                    \"status\": \"repo_absent\",\n+                    \"detail\": format!(\"repo checkout '{repo}' not found — inventory not scanned\"),\n+                }));\n+                tool_json[\"surfaces\"] = serde_json::json!(0);\n+            }\n+        }\n+        provenance.push(\n+            serde_json::to_value(&serde_json::json!({\n+                \"tool\": prov.tool,\n+                \"status\": prov.status,\n+                \"detail\": prov.detail,\n+            }))\n+            .expect(\"provenance serializes\"),\n+        );\n+        tools.insert(config.tool.clone(), tool_json);\n+    }\n+\n+    println!(\n+        \"{}\",\n+        serde_json::to_string_pretty(&serde_json::json!({\n+            \"inventory\": tools,\n+            \"provenance\": provenance,\n+            \"audit_rows\": audit_rows_all,\n+            \"report_rows\": report_rows,\n+        }))\n+        .expect(\"doc-audit report serializes\")\n+    );\n+    Ok(ExitCode::SUCCESS)\n+}\n+\n /// Aggregate a JSONL file of report rows into the fault dashboard.\n /// The configured model registry comes from the checked-in registry;\n /// the channel map from the live scenario registry. Findings do not\n /// affect the exit code — the dashboard is the record, and nonzero\n","firstChangedLine":298},"isError":false,"timestamp":1792526780503},{"role":"assistant","content":[{"type":"text","text":"Now `doc_audit.toml` for the whole ecosystem (mirroring routing.toml), and the justfile wiring:"},{"type":"toolCall","id":"call-8fb8c882-c65e-4463-8f80-993b4a446724","name":"write","arguments":{"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/doc_audit.toml","content":"# doc_audit.toml — tier-0 doc-coverage audit config (evallerina-fok,\n# openspec add-ecosystem-doc-evals D1/D4). One `[tool]` section per\n# routing.toml tool. Relative `repo` paths resolve against the\n# evallerina repo root (same rules as routing.toml).\n#\n# Per tool:\n#   repo     — the repository whose doc surfaces are scanned\n#              (README.md, docs/**, llms.txt, AGENTS.md managed blocks)\n#   binary   — binary probed with `--help`; defaults to the tool name\n#   surface  — \"none\" for tools that are not --help-probeable CLIs:\n#              they skip the binary step and are recorded in\n#              provenance, never silently skipped.\n#\n# A missing binary records `binary_absent` provenance; a missing local\n# checkout records `repo_absent`. Every skip is provenance (anti-goal:\n# no silent skips).\n\n[wai]\nrepo = \"../wai\"\n\n[genesis]\nrepo = \"../genesis\"\n\n[espectacular]\nrepo = \"../espectacular\"\n\n[dont]\nrepo = \"../dont\"\n\n[testaruda]\nrepo = \"../testaruda\"\n\n# turu's repo is `whisper` (binary/crate name mismatch; ddl canonical table).\n[turu]\nrepo = \"../whisper\"\nbinary = \"turu\"\n\n# `ah` shares the espectacular checkout (binary name of the espectacular CLI).\n[ah]\nrepo = \"../espectacular\"\n\n[pretender]\nrepo = \"../pretender\"\n\n[vampiro]\nrepo = \"../vampiro\"\n\n[incitaciones]\nrepo = \"../incitaciones\"\n\n# Third-party upstreams: not locally checked-out Rust CLIs — surface\n# none, provenance-recorded, never silent.\n[openspec]\nrepo = \"fission-ai/openspec\"\nsurface = \"none\"\n\n[specodelic]\nrepo = \"../specodelic\"\n\n[funkalization]\nrepo = \"../funkalization\"\n\n[wild]\nrepo = \"../wild\"\n\n[dulce-de-leche]\nrepo = \"../dulce-de-leche\"\n\n[bd]\nrepo = \"gastownhall/beads\"\nsurface = \"none\"\n"}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":5537,"output":530,"cacheRead":49280,"cacheWrite":0,"reasoning":0,"totalTokens":55347,"cost":{"input":0.00083055,"output":0.000265,"cacheRead":0.0014784,"cacheWrite":0,"total":0