n        if !prov.tokens.is_empty() {\n            // Only tools with a harvested surface can produce audit\n            // rows; the repo must be a local checkout to scan.\n            let repo = evallerina::routing::resolve_repo(&config.repo, &root_path);\n            let repo_path = std::path::PathBuf::from(&repo);\n            if repo_path.is_dir() {\n                let inv = evallerina::doc_audit::scan_inventory(&repo_path)?;\n                let rows = evallerina::doc_audit::audit(&prov.tokens, &inv);\n                tool_json[\"surfaces\"] = serde_json::json!(inv.surfaces.len());\n                tool_json[\"audit_rows\"] = serde_json::json!(rows.len());\n                audit_rows_all.extend(\n                    rows.iter().map(|r| {\n                        serde_json::json!({\"tool\": config.tool, \"token\": r.token, \"code\": r.code})\n                    }),\n                );\n                if !rows.is_empty() {\n                    report_rows.push(evallerina::doc_audit::report_row(&config.tool, &rows));\n                }\n            } else {\n                provenance.push(serde_json::json!({\n                    \"tool\": config.tool,\n                    \"status\": \"repo_absent\",\n                    \"detail\": format!(\"repo checkout '{repo}' not found — inventory not scanned\"),\n                }));\n                tool_json[\"surfaces\"] = serde_json::json!(0);\n            }\n        }\n        provenance.push(\n            serde_json::to_value(&serde_json::json!({\n                \"tool\": prov.tool,\n                \"status\": prov.status,\n                \"detail\": prov.detail,\n            }))\n            .expect(\"provenance serializes\"),\n        );\n        tools.insert(config.tool.clone(), tool_json);\n    }\n\n    println!(\n        \"{}\",\n        serde_json::to_string_pretty(&serde_json::json!({\n            \"inventory\": tools,\n            \"provenance\": provenance,\n            \"audit_rows\": audit_rows_all,\n            \"report_rows\": report_rows,\n        }))\n        .expect(\"doc-audit report serializes\")\n    );\n    Ok(ExitCode::SUCCESS)\n}\n\n/// Aggregate a JSONL file of report rows into the fault dashboard."}]}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":8983,"output":999,"cacheRead":44800,"cacheWrite":0,"reasoning":0,"totalTokens":54782,"cost":{"input":0.00134745,"output":0.0004994999999999999,"cacheRead":0.001344,"cacheWrite":0,"total":0.0031909499999999997}},"stopReason":"toolUse","timestamp":1792526771359,"responseId":"gen-1792526771-MRDQOVcvS1TJEBFJiWTR","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call-388b5971-d2e9-4792-aa4f-91f842a428ce","toolName":"edit","content":[{"type":"text","text":"Successfully replaced 1 block(s) in /var/home/sasha/para/areas/dev/gh/charly/evallerina/src/main.rs."}],"details":{"diff":"     ...\n 294         Ok(ExitCode::SUCCESS)\n 295     }\n 296 }\n 297 \n+298 /// Tier-0 doc-coverage audit CLI handler (evallerina-fok): load the\n+299 /// checked-in doc_audit.toml from the repo root, run the surface step\n+300 /// per tool (binary probe, or `skip`/`binary_absent` provenance —\n+301 /// never a silent skip), scan each tool's local repo surfaces into a\n+302 /// doc inventory, and diff the two into per-token audit rows that also\n+303 /// flow into the report contract as report_version 1 rows. Findings\n+304 /// are the record, not gate failures (the dashboard is the record);\n+305 /// nonzero exit is reserved for loud errors: missing/malformed config,\n+306 /// unreadable surfaces.\n+307 fn run_doc_audit() -> Result<ExitCode, String> {\n+308     let root = evallerina::routing::discover_root()?;\n+309     let root_path = std::path::PathBuf::from(&root);\n+310     let config_path = root_path.join(\"doc_audit.toml\");\n+311     let config_src = std::fs::read_to_string(&config_path)\n+312         .map_err(|e| format!(\"cannot read {}: {e}\", config_path.d