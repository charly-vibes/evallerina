t row = report\n            .rows\n            .iter()\n            .find(|r| r.tool == tool)\n            .unwrap_or_else(|| panic!(\"missing row for {tool}: {report:?}\"));\n        assert_eq!(row.status, routing_parity::RowStatus::Ok, \"{row:?}\");\n    }\n}\n"}],"isError":false,"timestamp":1792526146128}}
