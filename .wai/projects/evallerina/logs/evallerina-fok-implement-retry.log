cripts, no model, no network\ntier1:\n    cargo test --test evals_replay -- --nocapture\n\n# Tier 2 — live rotation (requires OPENROUTER_API_KEY); never gates a push.\n# One JSON event per cell on stdout (trial row or absent record).\ntier2 model=\"openrouter/free\" scenario=\"\" budget=\"20\":\n    #!/usr/bin/env bash\n    set -euo pipefail\n    args=(live --model \"{{model}}\" --budget-mins \"{{budget}}\")\n    if [ -n \"{{scenario}}\" ]; then args+=(\"{{scenario}}\"); fi\n    cargo run --release -- \"${args[@]}\"\n\n# Build + test the harness crate\nci: tier0\n\n# Fixture sandbox smoke test: provision binaries, run one replay scenario\nsmoke:\n    cargo run --release -- smoke\n"}],"isError":false,"timestamp":1792526099715},{"role":"toolResult","toolCallId":"call_e137a1dd100e4f2db50bb4b4","toolName":"read","content":[{"type":"text","text":"# Tasks: add-ecosystem-doc-evals\n\n## 1. Routing map parity (no battery change)\n\n- [x] 1.1 Failing test: routing-parity parser — fixture README with a\n  MANAGED-TOOLS block + canonical-names table → expected tool→repo pairs\n- [x] 1.2 Implement `routing_parity()` in `src/routing.rs` (or new module):\n  parse sibling ddl README managed block, diff against routing.toml entries,\n  unresolved paths fail, absent sibling → warning\n- [x] 1.3 Wire into tier-0 (`just tier0` / main.rs subcommand) and add\n  `ERR_ROUTING_PARITY` reporting; GHA workflows check out the ddl sibling so\n  the gate enforces in CI (warning-only in local standalone clones)\n- [x] 1.4 Expand routing.toml: testaruda, turu(whisper), ah(espectacular\n  exists), pretender, vampiro, incitaciones, openspec (`upstream = true`),\n  specodelic, funkalization, wild, dulce-de-leche, bd (`upstream = true`);\n  verify parity check green\n\n## 2. Tier-0 doc-coverage audit\n\n- [ ] 2.1 Failing test: surface extraction — fixture binary `--help` with\n  subcommands/flags → token set (kebab/snake/spacing normalization)\n- [ ] 2.2 Implement surface extractor (`src/doc_audit.rs`: Purpose header per\n  e10 Must gate); `surface: none` fixtures skip cleanly\n- [ ] 2.3 Failing test: inventory extraction — fixture repo with README +\n  docs/ + llms.txt + AGENTS.md managed block → feature-token set per surface\n- [ ] 2.4 Implement inventory scanner; breadcrumb-reachability check\n  (llms.txt / managed blocks) distinguishing ERR_FEATURE_UNDOCUMENTED vs\n  ERR_DOC_NOT_FINDABLE\n- [ ] 2.5 Wire audit rows into report as new check-codes (report_version\n  stays 1, additive); `just tier0` green\n\n## 3. Routing integration for audit faults\n\n- [ ] 3.1 Failing test: audit row with ERR_FEATURE_UNDOCUMENTED crosses\n  threshold → dry-run proposal with token `evallerina:<scenario>:<fault-class>`\n- [ ] 3.2 Dry-run smoke against latest tier-2 rows; review proposals before\n  any filing (mirrors 4.3 of add-fault-ticket-routing)\n\n## 4. Doc-findability scenarios (first tools)\n\n- [ ] 4.1 Fixture: turu (whisper) repo slice with llms.txt breadcrumb to a\n  seeded feature doc\n- [ ] 4.2 Record live tier-2 transcript; land scenario JSON + tier-1 replay in\n  same commit (design D5)\n- [ ] 4.3 Repeat for testaruda and ah; step budget + discovery-channel row\n  provenance asserted in replay tests\n\n## 5. Edge-exploration scenarios (first tools)\n\n- [ ] 5.1 Failing test: classifier — non-zero exit without hints on\n  undocumented input → ERR_EDGE_UNHANDLED; hint ignored →\n  ERR_ENVELOPE_HINT_BLINDNESS (existing class)\n- [ ] 5.2 Fixtures + recordings for wai and dont edge inputs (existing battery\n  tools first — cheapest provenance)\n- [ ] 5.3 Extend to turu/testaruda/ah recordings as they land\n\n## 6. Validation\n\n- [ ] 6.1 `just tier0` green; routing-parity + doc-coverage gates pass on this\n  repo itself\n- [ ] 6.2 Dogfood first: run the doc-coverage audit against evallerina's own\n  surfaces (README, docs/, AGENTS.md) before any tool-fixture rollout —\n  fastest way to shake out the extractor\n- [ ] 6.3 `just tier1` replay unchanged for existing scenarios\n- [ ] 6.4 One full nightly rotation green with new families; dry-run\n  proposals reviewed; `--file` remains opt-in\n"}],"isError":false,"timestamp":1792526099715},{"role":"assistant","content":[{"type":"toolCall","id":"call_4e2951d0d76245d3a6f45417","name":"read","arguments":{"limit":80,"offset":1,"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/main.rs"}},{"type":"toolCall","id":"call_c162136888ca41d09ce8d4f7","name":"read","arguments":{"limit":120,"offset":1,"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/report.rs"}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":1307,"output":84,"cacheRead":13056,"cacheWrite":0,"reasoning":1,"totalTokens":14447,"cost":{"input":0.00019605,"output":0.000042,"cacheRead":0.00039168,"cacheWrite":0,"total":0.00062973}},"stopReason":"toolUse","timestamp":1792526099717,"responseId":"gen-1792526099-nBGa2gwgVxRnNxneIvkn","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_4e2951d0d76245d3a6f45417","toolName":"read","content":[{"type":"text","text":"//! Purpose: CLI entry point of the evallerina harness.\n//! Responsibilities: expose the tier commands the justfile recipes\n//! invoke — `smoke` (run the replay smoke scenario, exit code carries\n//! pass/fail) and `live` (tier-2 live rotation over scenario × model\n//! cells via the OpenRouter :free action protocol).\n//! Rationale: tier discipline — the binary gates tier-0/1 locally and\n//! in CI; tier-2 never gates a push. `live` prints one JSON event per\n//! cell (trial row or absent record) and exits nonzero only when a\n//! trial actually failed or malformed — skipped cells are the record.\n\nuse std::io::Write;\nuse std::process::ExitCode;\nuse std::time::{Duration, Instant};\n\nuse clap::{Parser, Subcommand};\nuse evallerina::ablation::{\n    AblationFactories, AixArtifacts, AixSource, ToolBinaries, run_ablation,\n};\nuse evallerina::live::{OpenRouterTransport, RotationEvent, TrialStatus, run_rotation};\nuse evallerina::recorded::RecordedTrajectory;\nuse evallerina::registry::{DEFAULT_REPETITIONS, ordered_ids};\nuse evallerina::scenario::{SCENARIOS_DIR, live_scenario_by_name, live_scenarios, smoke_scenario};\n\n/// Default per-run wall-clock budget for the live rotation, minutes.\nconst DEFAULT_BUDGET_MINS: u64 = 20;\n\n/// Evals with an avatar — measuring whether agents actually use the tools.\n#[derive(Parser)]\n#[command(name = \"evallerina\", version, about)]\nstruct Cli {\n    #[command(subcommand)]\n    command: Command,\n}\n\n#[derive(Subcommand)]\nenum Command {\n    /// Run the tier-1 smoke replay (no model, no network). Exit 0 iff green.\n    Smoke,\n    /// Tier-2 live rotation (requires OPENROUTER_API_KEY). One JSON\n    /// event per cell on stdout: a report_version 1 trial row, or an\n    /// absent record when the per-run budget skipped the cell.\n    Live {\n        /// Optional scenario name filter (default: the whole live battery).\n        #[arg(default_value = None)]\n        scenario: Option<String>,\n        /// Repetitions per scenario × model cell.\n        #[arg(long, default_value_t = DEFAULT_REPETITIONS)]\n        reps: u32,\n        /// Run only this model id (default: the whole registry, in order).\n        #[arg(long, default_value = None)]\n        model: Option<String>,\n        /// Per-run wall-clock budget, minutes; cells not started before\n        /// it expires are recorded absent, never failed.\n        #[arg(long, default_value_t = DEFAULT_BUDGET_MINS)]\n        budget_mins: u64,\n    },\n    /// A/B ablation over one scenario (evals.md Step 5): the full arm\n    /// (AIX artifacts provisioned) vs the ablated arm (raw binaries),\n    /// ≥3 runs per arm over the configured model registry. Writes the\n    /// per-arm rotation rows as ArmReport JSONL to --out and prints the\n    /// per-arm summary + delta as JSON on stdout.\n    Ablate {\n        /// Scenario name (a live battery scenario; unknown names are a\n        /// loud error).\n        scenario: String,\n        /// Repetitions per arm (the evals.md Step 5 delta floor is 3).\n        #[arg(long, default_value_t = DEFAULT_REPETITIONS)]\n        reps: u32,\n        /// Run only this model id (default: the whole registry, in order).\n        #[arg(long, default_value = None)]\n        model: Option<String>,\n        /// Dry-run: every cell is recorded absent — no model calls, no\n        /// network; exercises the full report path hermetically.\n        #[arg(long)]\n        dry_run: bool,\n        /// Real artifact generation (opt-in; evallerina-0j8): invoke the\n        /// provisioned `wai` binary and harvest what it produces for the\n        /// full arm, instead of the static hermetic contents. A tool\n        /// failure is a loud error, never a placeholder fallback.\n        #[arg(long)]\n\n[344 more lines in file. Use offset=81 to continue.]"}],"isError":false,"timestamp":1792526102957},{"role":"toolResult","toolCallId":"call_c162136888ca41d09ce8d4f7","toolName":"read","content":[{"type":"text","text":"//! Purpose: Tier-1/2 report aggregation into the per-channel fault\n//! dashboard (evallerina-48g).\n//! Responsibilities: aggregate report_version 1 rows (tier-2 rotation\n//! events and tier-1 rows without model attribution) into a\n//! per-output-channel × check-code × model-id fault matrix, apply the\n//! evals-guidelines fault routing (tool faults → tool tickets; agent\n//! faults → AIX-channel work only at the cross-model threshold),\n//! surface absent, rate_limited, and http_error cells as coverage\n//! records — never failures, never dropped — and refuse loudly on unmappable scenarios\n//! instead of silently bucketing them.\n//! Rationale: evals-guidelines \"Fault routing\" and \"suite-wide\n//! aggregation\" requirements. The dashboard deliberately carries no\n//! single aggregate score: per-capability breakdown is a hard\n//! requirement, and a collapse into one number hides exactly the\n//! channel × code × model signal the routing rule needs.\n\nuse serde_json::json;\nuse std::collections::{BTreeMap, BTreeSet};\n\n/// Validate the `report` subcommand's routing flags: `--file` (cross-repo\n/// write authorization, Phase 2) requires `--route` — filing proposed\n/// tickets only makes sense after the routing step ran. Any combination\n/// without `--file` is fine.\npub fn validate_route_flags(route: bool, file: bool) -> Result<(), String> {\n    if file && !route {\n        return Err(\n            \"--file requires --route: filing proposed tickets only makes sense after the routing step ran\".into(),\n        );\n    }\n    Ok(())\n}\n\n/// The scenario definition's recorded tool — the repo key for routing\n/// (routing.rs keys proposals on this, never the report row's `tool`\n/// field, which is hardcoded for live trials). Scenario names\n/// prefix-encode the eval target by convention (`wai-*`, `dont-*`);\n/// an unknown prefix is None → a loud error downstream (never a\n/// silent bucket, mirroring aggregate_rows).\npub fn scenario_tool_of(name: &str) -> Option<String> {\n    if name.starts_with(\"wai-\") {\n        Some(\"wai\".to_owned())\n    } else if name.starts_with(\"dont-\") {\n        Some(\"dont\".to_owned())\n    } else {\n        None\n    }\n}\n\n/// Run the routing step against an aggregated dashboard: propose\n/// dry-run tickets from the same rows the dashboard aggregated from,\n/// optionally file them (Phase 2, `--file`), and attach the additive\n/// `routed` summary — decision counts only, no aggregate score — to\n/// the dashboard JSON.\n///\n/// Returns the proposals so the caller can serialize\n/// proposed-tickets.jsonl. Routing never affects the exit code unless\n/// it errors loudly (empty registry, unknown scenario, version\n/// mismatch): skipped proposals (unmapped tool, bd failure) are the\n/// record, not failures.\npub fn attach_routing(\n    dashboard: &mut serde_json::Value,\n    rows: &[serde_json::Value],\n    configured_models: &[String],\n    repo_map: &BTreeMap<String, String>,\n    file_authorized: bool,\n    run_bd: &mut crate::routing::BdRunner,\n) -> Result<Vec<crate::routing::ProposalRow>, String> {\n    let mut proposals =\n        crate::routing::propose(rows, configured_models, &scenario_tool_of, repo_map)?;\n    crate::routing::file_proposals(&mut proposals, file_authorized, run_bd)?;\n\n    let (mut filed, mut existing, mut dry_run, mut skipped) = (0usize, 0, 0, 0);\n    for p in &proposals {\n        match p.decision.as_str() {\n            \"filed\" => filed += 1,\n            \"existing\" => existing += 1,\n            \"dry_run\" => dry_run += 1,\n            _ => skipped += 1,\n        }\n    }\n    dashboard[\"routed\"] = json!({\n        \"filed\": filed,\n        \"existing\": existing,\n        \"dry_run\": dry_run,\n        \"skipped\": skipped,\n    });\n    Ok(proposals)\n}\n\n/// The full CLI routing step for `report --route`: load routing.toml\n/// (from the current directory — the repo root on rotation day),\n/// attach the routed summary to the dashboard, and write\n/// proposed-tickets.jsonl next to the report file. `file_authorized`\n/// comes from the explicit `--file` flag; the runner is injectable so\n/// tests can spy on bd calls.\npub fn run_routing_step(\n    dashboard: &mut serde_json::Value,\n    rows: &[serde_json::Value],\n    configured_models: &[String],\n    report_path: &std::path::Path,\n    file_authorized: bool,\n    run_bd: &mut crate::routing::BdRunner,\n) -> Result<Vec<crate::routing::ProposalRow>, String> {\n    let content = std::fs::read_to_string(\"routing.toml\")\n        .map_err(|e| format!(\"cannot read routing.toml: {e}\"))?;\n    let repo_map = crate::routing::parse_routing_toml(&content)?;\n    let proposals = attach_routing(\n        dashboard,\n        rows,\n        configured_models,\n        &repo_map,\n        file_authorized,\n        run_bd,\n    )?;\n    let jsonl = crate::routing::to_jsonl(&proposals);\n    let out_path = report_path\n        .parent()\n        .unwrap_or(std::path::Path::new(\".\"))\n        .join(\"proposed-tickets.jsonl\");\n    std::fs::write(&out_path, jsonl)\n\n[351 more lines in file. Use offset=121 to continue.]"}],"isError":false,"timestamp":1792526102957},{"role":"assistant","content":[{"type":"toolCall","id":"call_131880ddc2ca4672bb3140b8","name":"read","arguments":{"limit":120,"offset":121,"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/report.rs"}},{"type":"toolCall","id":"call_f84ff2ad5b774cc9870181ef","name":"read","arguments":{"limit":60,"offset":1,"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/lib.rs"}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":2240,"output":84,"cacheRead":14336,"cacheWrite":0,"reasoning":1,"totalTokens":16660,"cost":{"input":0.000336,"output":0.000042,"cacheRead":0.00043007999999999995,"cacheWrite":0,"total":0.0008080799999999999}},"stopReason":"toolUse","timestamp":1792526102961,"responseId":"gen-1792526103-GqKOgN4AsVhOv2D0ujfI","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_131880ddc2ca4672bb3140b8","toolName":"read","content":[{"type":"text","text":"        .map_err(|e| format!(\"cannot write {}: {e}\", out_path.display()))?;\n    Ok(proposals)\n}\n\n/// Version of the dashboard shape. Additive evolution only within a\n/// version; breaking changes bump this.\npub const DASHBOARD_VERSION: u32 = 1;\n\n/// The evals-guidelines cross-model routing threshold for agent faults\n/// within one output channel.\nconst ROUTING_THRESHOLD: usize = 3;\n\n/// The output channel a live scenario's checks probe (the fault-routing\n/// key per evals-guidelines: suggestions, envelope, managed-block, or\n/// artifact surface). Registered for every live scenario; the channel\n/// must exist before rotation day, not after the first dashboard run.\npub fn scenario_channel(name: &str) -> Option<&'static str> {\n    match name {\n        \"wai-hint-adherence-smoke\"\n        | \"wai-hint-adherence-corrupt-config\"\n        | \"dont-hint-adherence-lifecycle\" => Some(\"envelope\"),\n        \"wai-hint-adherence-typo\" => Some(\"suggestions\"),\n        \"wai-doc-drift-stale-agents-md\" | \"dont-doc-drift-stale-lifecycle\" => Some(\"artifact\"),\n        // Archetype family (evallerina-bhh): vampiro-polyglot-seam asserts\n        // on vampiro's gate/guidance JSON envelopes; wai-drifted-ecosystem\n        // probes the stale-AGENTS.md artifact via doc_drift_blindness,\n        // mapping to `artifact` like its doc-drift siblings.\n        \"vampiro-polyglot-seam\" => Some(\"envelope\"),\n        \"wai-drifted-ecosystem\" => Some(\"artifact\"),\n        _ => None,\n    }\n}\n\n/// One accumulator key in the routing maps: agent faults key on\n/// (channel, code), tool faults on (tool, check, channel) because they\n/// carry no code by contract.\n#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]\nenum FaultKey {\n    /// Agent fault: the `ERR_*` taxonomy code within one output channel.\n    Agent { channel: String, code: String },\n    /// Tool fault: no code; routed to the tool's repository.\n    Tool {\n        tool: String,\n        check: String,\n        channel: String,\n    },\n}\n\n/// Accumulated occurrences for one fault key: total count plus the set\n/// of distinct model ids observed (empty for non-tier-2 rows).\n#[derive(Debug, Default)]\nstruct FaultTally {\n    occurrences: usize,\n    models: BTreeSet<String>,\n    scenarios: BTreeSet<String>,\n}\n\n/// Aggregate report_version 1 rows into the dashboard JSON.\n///\n/// `rows` are parsed report rows as [`serde_json::Value`]: tier-2\n/// rotation events (`kind: trial | absent`) or tier-1 rows without a\n/// `model` field (grouped as non-tier-2 per the report contract).\n/// `configured_models` is the model registry the rotation was\n/// configured with — it defines the routing threshold (3, or the full\n/// registry size when fewer than three are configured). `channel_of`\n/// resolves a scenario to the output channel its checks probe; an\n/// unknown scenario is a loud error, never a silent bucket.\n///\n/// The returned value is the serialized dashboard shape: no single\n/// aggregate score, per-capability breakdown only.\npub fn aggregate_rows(\n    rows: &[serde_json::Value],\n    configured_models: &[String],\n    channel_of: &dyn Fn(&str) -> Option<&'static str>,\n) -> Result<serde_json::Value, String> {\n    if configured_models.is_empty() {\n        return Err(\"configured model registry is empty — no routing threshold exists\".into());\n    }\n    let routing_threshold = configured_models.len().min(ROUTING_THRESHOLD);\n\n    let mut matrix_cells: BTreeMap<(String, String, String), FaultTally> = BTreeMap::new();\n    let mut routings: BTreeMap<FaultKey, FaultTally> = BTreeMap::new();\n    let mut coverage = Coverage::default();\n    let mut report_versions = BTreeSet::new();\n\n    for row in rows {\n        let kind = row.get(\"kind\").and_then(serde_json::Value::as_str);\n        if kind == Some(\"absent\") {\n            // Absent cells are the record that a cell did not run; they\n            // are never failures and never dropped (anti-goal).\n            coverage.absent += 1;\n            continue;\n        }\n        let status = row\n            .get(\"status\")\n            .and_then(serde_json::Value::as_str)\n            .ok_or(\"report row lacks a `status` field\")?;\n        let scenario = row\n            .get(\"scenario\")\n            .and_then(serde_json::Value::as_str)\n            .ok_or(\"report row lacks a `scenario` field\")?;\n        let tool = row\n            .get(\"tool\")\n            .and_then(serde_json::Value::as_str)\n            .ok_or(\"report row lacks a `tool` field\")?;\n        let checks = row\n            .get(\"checks\")\n            .and_then(serde_json::Value::as_array)\n            .ok_or(\"report row lacks a `checks` array\")?;