scenario registry. Findings do not\n/// affect the exit code — the dashboard is the record, and nonzero\n/// exits are reserved for aggregation errors.\nfn run_report(path: &str, route: bool, file: bool) -> Result<ExitCode, String> {\n    evallerina::report::validate_route_flags(route, file)?;\n    let content = std::fs::read_to_string(path)\n        .map_err(|e| format!(\"cannot read report rows from {path}: {e}\"))?;\n    let rows: Vec<serde_json::Value> = content\n        .lines()\n        .filter(|line| !line.trim().is_empty())\n        .map(|line| serde_json::from_str(line).map_err(|e| format!(\"malformed report row: {e}\")))\n        .collect::<Result<Vec<_>, String>>()?;\n    let configured: Vec<String> = ordered_ids().into_iter().map(String::from).collect();\n    let mut dashboard = evallerina::report::aggregate_rows(\n        &rows,\n        &configured,\n        &evallerina::report::scenario_channel,\n    )?;\n    if route {\n        let mut runner = evallerina::routing::run_bd;\n        evallerina::report::run_routing_step(\n            &mut dashboard,\n            &rows,\n            &configured,\n            std::path::Path::new(path),\n            file,\n            &mut runner,\n        )?;\n    }\n    println!(\n        \"{}\",\n        serde_json::to_string_pretty(&dashboard).expect(\"dashboard serializes\")\n    );\n    Ok(ExitCode::SUCCESS)\n}\n\n/// A/B ablation CLI handler (evallerina-wdx): resolve the named\n/// scenario and model list, run both arms via\n/// [`evallerina::ablation::run_ablation`], write the ArmReport JSONL\n/// rows (full arm first, then ablated, in run order), and print the\n/// per-arm summary + delta as JSON on stdout. Measurement, not a gate:\n/// the exit code is success whenever the ablation ran; errors — unknown\n/// scenario, artifact-path collision, generation failure, unwritable\n/// output — are loud and nonzero, never silent.\nfn run_ablate(\n    scenario: &str,\n    reps: u32,\n    model: Option<String>,\n    dry_run: bool,\n    real_artifacts: bool,\n    budget_mins: u64,\n    out: &str,\n) -> Result<ExitCode, String> {\n    let scenario = evallerina::scenario::live_scenario_by_name(scenario)?;\n    let models: Vec<String> = match model {\n        Some(id) => vec![id],\n        None => ordered_ids().into_iter().map(String::from).collect(),\n    };\n    let artifacts: AixSource<'static> = if real_artifacts {\n        let wai = ToolBinaries::discover_wai().ok_or_else(|| {\n            \"real artifact generation requested but no `wai` binary is on PATH — refusing to fake it\"\n                .to_owned()\n        })?;\n        AixSource::Real(ToolBinaries { wai })\n    } else {\n        AixSource::Static(&DEFAULT_AIX_ARTIFACTS)\n    };\n    // Dry-run: transports are constructed but never called — the zero\n    // budget records every cell absent before any trial starts. No\n    // key required, no network. Non-dry-run: the real tier-2\n    // transport, which refuses to start without OPENROUTER_API_KEY.\n    let report = if dry_run {\n        let mut full_factory = |m: &str| {\n            Ok(Box::new(OpenRouterTransport::new(m, \"dry-run-no-network\"))\n                as Box<dyn evallerina::live::Transport>)\n        };\n        let mut ablated_factory = |m: &str| {\n"}],"isError":false,"timestamp":1792526129352},{"role":"assistant","content":[{"type":"toolCall","id":"call_8086e9c983a640a7a90a2318","name":"bash","arguments":{"command":"grep -n \"\" src/routing_parity.rs | head -0; wc -l src/routing_parity.rs src/routing.rs; sed -n 1,60p src/routing_parity.rs; grep -n \"routing-parity\\|tier0\" tests/routing_parity.rs justfile","timeout":30}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":1245,"output":80,"cacheRead":21504,"cacheWrite":0,"reasoning":1,"totalTokens":22829,"cost":{"input":0.00018674999999999999,"output":0.000039999999999999996,"cacheRead":0.0006451199999999999,"cacheWrite":0,"total":0.0008718699999999998}},"stopReason":"toolUse","timestamp":1792526129354,"responseId":"gen-1792526129-TYre9loCxQ7pZDEs4vTd","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_8086e9c983a640a7a90a2318","toolName":"bash","content":[{"type":"text","text":"  411 src/routing_parity.rs\n  434 src/routing.rs\n  845 total\n//! Purpose: tier-0 routing-map parity gate (evallerina-0sy, openspec\n//! add-ecosystem-doc-evals, design D2) — `routing.toml` must mirror\n//! dulce-de-leche's MANAGED-TOOLS block so every managed tool's faults\n//! have a ticket-routing target.\n//! Responsibilities: parse the ddl sibling README (`../dulce-de-leche/\n//! README.md`) for the MANAGED-TOOLS tool list and the canonical-names\n//! table (binary → repository; the table deliberately lists only\n//! binary/crate name mismatches), resolve each managed tool's repo\n//! reference (canonical table → binary-name fallback → explicit\n//! routing.toml override), parse routing.toml entries with their\n//! `upstream` flag (data-only: third-party upstreams `bd` and\n//! `openspec` are mapped but never filed — filing semantics belong to\n//! e4x), and diff the two maps into per-tool parity rows. Failure rows\n//! carry `ERR_ROUTING_PARITY`; the only warning path is a genuinely\n//! absent ddl sibling (standalone clones degrade, exit 0).\n//! Rationale: ddl's managed block is the ecosystem source of truth\n//! (drift-tested inside ddl itself); a tier-0 gate here fails `just\n//! tier0` the moment routing.toml drifts, instead of letting tool\n//! faults route to nowhere. Parse failures are always loud errors —\n//! the gate must never paper over a broken managed block (anti-goal),\n//! and warning degradation is reserved exclusively for the absent\n//! sibling checkout. Row statuses are explicit: `ok`, `warn` (named,\n//! never silent), `fail`.\n\nuse std::collections::BTreeMap;\n\n/// Path of the ddl sibling README, relative to the evallerina repo\n/// root — the MANAGED-TOOLS source of truth (design D2).\npub const DDL_README: &str = \"../dulce-de-leche/README.md\";\n\nconst MANAGED_START: &str = \"<!-- MANAGED-TOOLS:START -->\";\nconst MANAGED_END: &str = \"<!-- MANAGED-TOOLS:END -->\";\n\n/// One parsed routing.toml `[tool]` entry: the repo reference plus the\n/// `upstream` flag. `upstream = true` is DATA only (openspec\n/// add-ecosystem-doc-evals): third-party upstreams (`bd`, `openspec`)\n/// must be mapped so parity is complete, but they are never filed in —\n/// the filing-side semantics (`skipped`/`unmapped_upstream`) belong to\n/// e4x and are out of scope here.\n#[derive(Debug, Clone, PartialEq)]\npub struct RoutingEntry {\n    pub repo: String,\n    pub upstream: bool,\n}\n\n/// The resolved repo reference for a managed tool — the spec's\n/// resolution chain made explicit so every branch is testable:\n/// explicit routing.toml entry (override wins) → ddl canonical-names\n/// table → binary-name fallback (`charly-vibes/<binary>`).\n#[derive(Debug, Clone, PartialEq)]\npub enum ResolvedRepo {\n    /// Explicit routing.toml entry — the override, always wins.\n    Override(String),\n    /// ddl's canonical-names table (name-mismatch rows).\n    Canonical(String),\n    /// Not in the table: first-party assumption `charly-vibes/<binary>`.\n    BinaryFallback(String),\n}\n\nimpl ResolvedRepo {\ntests/routing_parity.rs:13://! Rationale: the gate is the mechanism that fails `just tier0` the\ntests/routing_parity.rs:486:// `just tier0`) naming the drifted tool.\ntests/routing_parity.rs:510:        \"routing-parity drift between routing.toml and ddl's MANAGED-TOOLS block: {fails:?}\"\njustfile:8:tier0:\njustfile:27:ci: tier0\n"}],"isError":false,"timestamp":1792526135051},{"role":"assistant","content":[{"type":"thinking","thinking":"Let me look at routing_parity tests + how tier0 includes routing parity (tests/routing_parity.rs is a test). Also look at src/routing.rs discover_root. Then design doc_audit.\n\nLet me check main.rs command dispatch (lines 116–135) and existing Cargo.toml deps.","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"Let me look at routing_parity tests + how tier0 includes routing parity (tests/routing_parity.rs is a test). Also look at src/routing.rs discover_root. Then design doc_audit.\\n\\nLet me check main.rs command dispatch (lines 116–135) and existing Cargo.toml deps.\",\"format\":\"unknown\",\"index\":0}]"},{"type":"toolCall","id":"call_c1e42bb3eb244da59a8394ea","name":"bash","arguments":{"command":"sed -n 108,135p src/main.rs; echo ----; cat Cargo.toml; echo ----; sed -n 480,525p tests/routing_parity.rs","timeout":30}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":899,"output":116,"cacheRead":22784,"cacheWrite":0,"reasoning":63,"totalTokens":23799,"cost":{"input":0.00013485,"output":0.000058,"cacheRead":0.00068352,"cacheWrite":0,"total":0.00087637}},"stopReason":"toolUse","timestamp":1792526135053,"responseId":"gen-1792526135-uIvTdA24bwYjRBCaNBUU","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_c1e42bb3eb244da59a8394ea","toolName":"bash","content":[{"type":"text","text":"        file: bool,\n    },\n    /// Tier-0 routing-map parity gate (evallerina-0sy): diff\n    /// routing.toml against dulce-de-leche's MANAGED-TOOLS block\n    /// (../dulce-de-leche/README.md). Prints the parity report as JSON\n    /// (degraded flag + one row per managed tool) and exits nonzero iff\n    /// any row failed; an absent ddl sibling degrades to a warning row\n    /// with exit 0 (standalone clones), never covering a parse failure.\n    RoutingParity,\n}\n\n/// The hermetic static artifact set the full arm provisions by default\n/// (the ablated-arm baseline stays raw binaries either way). Real\n/// generation — the provisioned `wai` binary harvesting the actual\n/// managed AGENTS.md, `.genesis/tools.toml` and `llms.txt` — is opt-in\n/// via --real-artifacts (evallerina-0j8).\nconst DEFAULT_AIX_ARTIFACTS: AixArtifacts = AixArtifacts {\n    llms_txt: \"llms.txt content: wai status --json\",\n    managed_agents_md: \"<!-- WAI:START -->managed guidance<!-- WAI:END -->\",\n    tools_toml: \"[tools]\\nwai = { cmd = \\\"wai\\\" }\\n\",\n};\n\nfn main() -> std::process::ExitCode {\n    match Cli::parse().command {\n        Command::Smoke => {\n            let path = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n                .join(SCENARIOS_DIR)\n                .join(\"wai-hint-adherence-smoke.json\");\n----\n[package]\nname = \"evallerina\"\nversion = \"0.1.0\"\nedition = \"2024\"\ndescription = \"Eval battery for the dulce-de-leche tool family: do LLM agents actually use the suite's AIX output channels?\"\nlicense = \"Apache-2.0\"\nrepository = \"https://github.com/charly-vibes/evallerina\"\nreadme = \"README.md\"\n\n[lib]\nname = \"evallerina\"\n\n[[bin]]\nname = \"evallerina\"\npath = \"src/main.rs\"\n\n[dependencies]\ngenesis-vibes = { git = \"https://github.com/charly-vibes/genesis\", tag = \"v0.12.3\" }\nclap = { version = \"4\", features = [\"derive\", \"env\"] }\nserde = { version = \"1\", features = [\"derive\"] }\nserde_json = \"1\"\ntoml = \"0.8\"\nregex = \"1\"\nthiserror = \"2\"\nureq = { version = \"2\", default-features = false, features = [\"tls\", \"json\"] }\n----\n}\n\n// ---------------------------------------------------------------------------\n// Step 5: the real-workspace gate — this test IS the tier-0\n// enforcement: any drift between the checked-in routing.toml and the\n// ddl sibling's MANAGED-TOOLS block fails `cargo test` (and thus\n// `just tier0`) naming the drifted tool.\n// ---------------------------------------------------------------------------\n\n#[test]\nfn real_workspace_parity_is_green() {\n    let root = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    let readme_path = root.join(routing_parity::DDL_README);\n    let readme = std::fs::read_to_string(&readme_path).ok();\n    let toml =\n        std::fs::read_to_string(root.join(\"routing.toml\")).expect(\"routing.toml is checked in\");\n    let report = routing_parity::routing_parity(readme.as_deref(), &toml, &root)\n        .expect(\"gate runs against the real workspace\");\n\n    if report.degraded {\n        // Sibling genuinely absent (standalone clone): warning only,\n        // exit 0 — this is the ONE sanctioned degradation.\n        assert_eq!(report.rows.len(), 1, \"degraded report has one warn row\");\n        assert_eq!(report.rows[0].status, routing_parity::RowStatus::Warn);\n        return;\n    }\n\n    let fails = failing_rows(&report);\n    assert!(\n        fails.is_empty(),\n        \"routing-parity drift between routing.toml and ddl's MANAGED-TOOLS block: {fails:?}\"\n    );\n    // One row per managed tool — the gate never silently skips a\n    // first-party tool (anti-goal).\n    assert_eq!(report.rows.len(), 13, \"one row per managed tool\");\n    // The upstream entries resolve as data rows.\n    for tool in [\"bd\", \"openspec\"] {\n        let row = report\n            .rows\n            .iter()\n            .find(|r| r.tool == tool)\n            .unwrap_or_else(|| panic!(\"missing row for {tool}: {report:?}\"));\n        assert_eq!(row.status, routing_parity::RowStatus::Ok, \"{row:?}\");\n    }\n}\n"}],"isError":false,"timestamp":1792526146128},{"role":"assistant","content":[{"type":"thinking","thinking":"Now I have a good picture. Design `src/doc_audit.rs`:\n\nKey data structures:\n- `DocAuditConfig`: parse `doc_audit.toml` — per-tool entries: repo path, binary name (default = tool name), optional `surface = \"none\"`.\n- `SurfaceExtraction`: run binary `--help`, harvest tokens: subcommands, long flags (`--foo-bar`), exit codes mentioned (\"Exit codes: 0, 1, 2\" or \"Exit status\"). Normalize tokens: kebab/snake/spacing → normalize by lowercasing, replacing `-` and `_` and spaces... Actually \"substring-normalized matching per D1\" — normalize token to canonical form: lowercase, remove `-`, `_`, spaces? That maps `foo-bar` and `foo