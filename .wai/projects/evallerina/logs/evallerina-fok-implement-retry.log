{"type":"message_update","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"assistantMessageEvent":{"type":"toolcall_delta","contentIndex":1,"delta":",\"edits\":[{\"oldText\":\"fn harvest_tokens(help: &str) -> BTreeSet<String> {\\n    let mut tokens = BTreeSet::new();\\n    let mut in_commands = false;\\n    for line in help.lines() {\\n        let trimmed = line.trim();\\n        // Long flags: `--flag-name` (strip the dashes, canonicalize).\\n        for word in trimmed.split_whitespace() {\\n            if let Some(flag) = word.strip_prefix(\\\"--\\\") {\\n                let flag = flag.split('=').next().unwrap_or(flag);\\n                if !flag.is_empty() && flag.chars().any(|c| c.is_ascii_alphanumeric()) {\\n                    tokens.insert(canonical_raw(flag));\\n                }\\n            }\\n        }\\n        // Subcommand section: lines after a `Commands:`/`Subcommands:`\\n        // header, until a blank line ends the section. The first word\\n        // of each indented entry is the subcommand name.\\n        if trimmed == \\\"Commands:\\\" || trimmed == \\\"Subcommands:\\\" {\\n            in_commands = true;\\n            continue;\\n        }\\n        if in_commands {\\n            if trimmed.is_empty() || !line.starts_with(char::is_whitespace) {\\n                in_commands = false;\\n            } else if let Some(name) = trimmed.split_whitespace().next() {\\n                if name.chars().any(|c| c.is_ascii_alphanumeric()) {\\n                    tokens.insert(canonical_raw(name));\\n                }\\n            }\\n        }\\n        // Documented exit codes: `Exit codes:` / `Exit status:`\\n        // sections, or inline `exit code N` mentions. The code itself\\n        // becomes the token `exitN`.\\n        let lower = trimmed.to_lowercase();\\n        if let Some(rest) = lower\\n            .strip_prefix(\\\"exit codes:\\\")\\n            .or_else(|| lower.strip_prefix(\\\"exit status:\\\"))\\n        {\\n            for word in rest.split_whitespace() {\\n                if let Ok(code) = word.trim_end_matches(|c: char| !c.is_ascii_digit()).parse::<u32>()\\n                {\\n                    tokens.insert(format!(\\\"exit{code}\\\"));\\n                }\\n            }\\n        } else if let Some(idx) = lower.find(\\\"exit code\\\")\\n            .or_else(|| lower.find(\\\"exit status\\\"))\\n        {\\n            let after = &trimmed[idx + \\\"exit code\\\".len()..];\\n            if let Some(first) = after.split(|c: char| !c.is_ascii_digit()).find(|s| !s.is_empty())\\n            {\\n                if let Ok(code) = first.parse::<u32>() {\\n                    tokens.insert(format!(\\\"exit{code}\\\"));\\n                }\\n            }\\n        }\\n    }\\n    // Numbered exit-code list lines (`  0  success`) under an exit\\n    // section: handled by treating any standalone leading integer after\\n    // the section header above; plain leading numbers are covered by\\n    // the header-strip branch when they follow on the same line.\\n    tokens\\n}\",\"newText\":\"fn harvest_tokens(help: &str) -> BTreeSet<String> {\\n    let mut tokens = BTreeSet::new();\\n    let mut in_commands = false;\\n    let mut in_exit = false;\\n    for line in help.lines() {\\n        let trimmed = line.trim();\\n        // Long flags: `--flag-name` (strip the dashes, canonicalize).\\n        for word in trimmed.split_whitespace() {\\n            if let Some(flag) = word.strip_prefix(\\\"--\\\") {\\n                let flag = flag.split('=').next().unwrap_or(flag);\\n                if !flag.is_empty() && flag.chars().any(|c| c.is_ascii_alphanumeric()) {\\n                    tokens.insert(canonical_raw(flag));\\n                }\\n            }\\n        }\\n        // Subcommand section: lines after a `Commands:`/`Subcommands:`\\n        // header, until a blank line or non-indented line ends it. The\\n        // first word of each indented entry is the subcommand name.\\n        if trimmed == \\\"Commands:\\\" || trimmed == \\\"Subcommands:\\\" {\\n            in_commands = true;\\n            continue;\\n        }\\n        if in_commands {\\n            if trimmed.is_empty() || !line.starts_with(char::is_whitespace) {\\n                in_commands = false;\\n            } else if let Some(name) = trimmed.split_whitespace().next() {\\n                if name.chars().any(|c| c.is_ascii_alphanumeric()) {\\n                    tokens.insert(canonical_raw(name));\\n                }\\n            }\\n            continue;\\n        }\\n        // Exit-code section: `Exit codes:` / `Exit status:` header,\\n        // then indented `N  description` lines. Each documented code\\n        // becomes the token `exitN`.\\n        let lower = trimmed.to_lowercase();\\n        if lower.starts_with(\\\"exit codes:\\\") || lower.starts_with(\\\"exit status:\\\") {\\n            in_exit = true;\\n            // Same-line codes (`Exit codes: 0, 2`) are harvested too.\\n            harvest_exit_words(trimmed, &mut tokens);\\n            continue;\\n        }\\n        if in_exit {\\n            if trimmed.is_empty() || !line.starts_with(char::is_whitespace) {\\n                in_exit = false;\\n            } else {\\n                harvest_exit_words(trimmed, &mut tokens);\\n            }\\n            continue;\\n        }\\n        // Inline exit-code mention: `Exits with code 2 on bad input`.\\n        if let Some(idx) = lower.find(\\\"exit code\\\").or_else(|| lower.find(\\\"exit status\\\")) {\\n            let after = &trimmed[idx + \\\"exit code\\\".len()..];\\n            if let Some(first) = after\\n                .trim_start_matches(|c: char| !c.is_ascii_digit())\\n                .split(|c: char| !c.is_ascii_digit())\\n                .next()\\n            {\\n                if let Ok(code) = first.parse::<u32>() {\\n                    tokens.insert(format!(\\\"exit{code}\\\"));\\n                }\\n            }\\n        }\\n    }\\n    tokens\\n}\\n\\n/// Harvest leading integer exit codes from one exit-section line\\n/// (`  0  success` → `exit0`); description words are not tokens.\\nfn harvest_exit_words(line: &str, tokens: &mut BTreeSet<String>) {\\n    let digits: String = line.chars().take_while(|c| c.is_ascii_digit()).collect();\\n    if !digits.is_empty() {\\n        if let Ok(code) = digits.parse::<u32>() {\\n            tokens.insert(format!(\\\"exit{code}\\\"));\\n        }\\n    }\\n}\"}]}"}}
