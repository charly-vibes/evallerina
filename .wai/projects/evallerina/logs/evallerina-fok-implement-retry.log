de: \"ERR_FEATURE_UNDOCUMENTED\".into(),\n            },\n        ],\n    )];\n    assert_eq!(rows[0][\"report_version\"], 1, \"report_version stays 1\");\n\n    let configured = vec![\"model-a\".to_owned()];\n    let dashboard = aggregate_rows(&rows, &configured, &scenario_channel)\n        .expect(\"doc-audit rows aggregate cleanly\");\n    let matrix = dashboard[\"matrix\"].as_array().expect(\"matrix\");\n    assert_eq!(matrix.len(), 2, \"both codes are matrix-visible\");\n    let codes: Vec<&str> = matrix\n        .iter()\n        .map(|c| c[\"code\"].as_str().expect(\"code str\"))\n        .collect();\n    assert!(codes.contains(&\"ERR_FEATURE_UNDOCUMENTED\"));\n    assert!(codes.contains(&\"ERR_DOC_NOT_FINDABLE\"));\n    assert_eq!(dashboard[\"report_version\"], 1);\n}\nEOF\ncargo test --test doc_audit 2>&1 | grep -E \"error\\[|not found\" | head -4","timeout":300}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":7585,"output":881,"cacheRead":40320,"cacheWrite":0,"reasoning":188,"totalTokens":48786,"cost":{"input":0.0011377499999999999,"output":0.0004405,"cacheRead":0.0012096,"cacheWrite":0,"total":0.0027878499999999997}},"stopReason":"toolUse","timestamp":1792526701211,"responseId":"gen-1792526701-zJNdwFfVNX4AiFHc85Kx","rawStopReason":"tool_calls"}}
