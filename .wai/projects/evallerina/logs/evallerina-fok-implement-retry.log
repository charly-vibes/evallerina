{"type":"tool_execution_update","toolCallId":"call_c1e42bb3eb244da59a8394ea","toolName":"bash","args":{"command":"sed -n 108,135p src/main.rs; echo ----; cat Cargo.toml; echo ----; sed -n 480,525p tests/routing_parity.rs","timeout":30},"partialResult":{"content":[{"type":"text","text":"        file: bool,\n    },\n    /// Tier-0 routing-map parity gate (evallerina-0sy): diff\n    /// routing.toml against dulce-de-leche's MANAGED-TOOLS block\n    /// (../dulce-de-leche/README.md). Prints the parity report as JSON\n    /// (degraded flag + one row per managed tool) and exits nonzero iff\n    /// any row failed; an absent ddl sibling degrades to a warning row\n    /// with exit 0 (standalone clones), never covering a parse failure.\n    RoutingParity,\n}\n\n/// The hermetic static artifact set the full arm provisions by default\n/// (the ablated-arm baseline stays raw binaries either way). Real\n/// generation — the provisioned `wai` binary harvesting the actual\n/// managed AGENTS.md, `.genesis/tools.toml` and `llms.txt` — is opt-in\n/// via --real-artifacts (evallerina-0j8).\nconst DEFAULT_AIX_ARTIFACTS: AixArtifacts = AixArtifacts {\n    llms_txt: \"llms.txt content: wai status --json\",\n    managed_agents_md: \"<!-- WAI:START -->managed guidance<!-- WAI:END -->\",\n    tools_toml: \"[tools]\\nwai = { cmd = \\\"wai\\\" }\\n\",\n};\n\nfn main() -> std::process::ExitCode {\n    match Cli::parse().command {\n        Command::Smoke => {\n            let path = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n                .join(SCENARIOS_DIR)\n                .join(\"wai-hint-adherence-smoke.json\");\n"}],"details":{}}}
{"type":"tool_execution_update","toolCallId":"call_c1e42bb3eb244da59a8394ea","toolName":"bash","args":{"command":"sed -n 108,135p src/main.rs; echo ----; cat Cargo.toml; echo ----; sed -n 480,525p tests/routing_parity.rs","timeout":30},"partialResult":{"content":[{"type":"text","text":"        file: bool,\n    },\n    /// Tier-0 routing-map parity gate (evallerina-0sy): diff\n    /// routing.toml against dulce-de-leche's MANAGED-TOOLS block\n    /// (../dulce-de-leche/README.md). Prints the parity report as JSON\n    /// (degraded flag + one row per managed tool) and exits nonzero iff\n    /// any row failed; an absent ddl sibling degrades to a warning row\n    /// with exit 0 (standalone clones), never covering a parse failure.\n    RoutingParity,\n}\n\n/// The hermetic static artifact set the full arm provisions by default\n/// (the ablated-arm baseline stays raw binaries either way). Real\n/// generation — the provisioned `wai` binary harvesting the actual\n/// managed AGENTS.md, `.genesis/tools.toml` and `llms.txt` — is opt-in\n/// via --real-artifacts (evallerina-0j8).\nconst DEFAULT_AIX_ARTIFACTS: AixArtifacts = AixArtifacts {\n    llms_txt: \"llms.txt content: wai status --json\",\n    managed_agents_md: \"<!-- WAI:START -->managed guidance<!-- WAI:END -->\",\n    tools_toml: \"[tools]\\nwai = { cmd = \\\"wai\\\" }\\n\",\n};\n\nfn main() -> std::process::ExitCode {\n    match Cli::parse().command {\n        Command::Smoke => {\n            let path = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n                .join(SCENARIOS_DIR)\n                .join(\"wai-hint-adherence-smoke.json\");\n----\n[package]\nname = \"evallerina\"\nversion = \"0.1.0\"\nedition = \"2024\"\ndescription = \"Eval battery for the dulce-de-leche tool family: do LLM agents actually use the suite's AIX output channels?\"\nlicense = \"Apache-2.0\"\nrepository = \"https://github.com/charly-vibes/evallerina\"\nreadme = \"README.md\"\n\n[lib]\nname = \"evallerina\"\n\n[[bin]]\nname = \"evallerina\"\npath = \"src/main.rs\"\n\n[dependencies]\ngenesis-vibes = { git = \"https://github.com/charly-vibes/genesis\", tag = \"v0.12.3\" }\nclap = { version = \"4\", features = [\"derive\", \"env\"] }\nserde = { version = \"1\", features = [\"derive\"] }\nserde_json = \"1\"\ntoml = \"0.8\"\nregex = \"1\"\nthiserror = \"2\"\nureq = { version = \"2\", default-features = false, features = [\"tls\", \"json\"] }\n----\n}\n\n// ---------------------------------------------------------------------------\n// Step 5: the real-workspace gate — this test IS the tier-0\n// enforcement: any drift between the checked-in routing.toml and the\n// ddl sibling's MANAGED-TOOLS block fails `cargo test` (and thus\n// `just tier0`) naming the drifted tool.\n// ---------------------------------------------------------------------------\n\n#[test]\nfn real_workspace_parity_is_green() {\n    let root = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    let readme_path = root.join(routing_parity::DDL_README);\n    let readme = std::fs::read_to_string(&readme_path).ok();\n    let toml =\n        std::fs::read_to_string(root.join(\"routing.toml\")).expect(\"routing.toml is checked in\");\n    let report = routing_parity::routing_parity(readme.as_deref(), &toml, &root)\n        .expect(\"gate runs against the real workspace\");\n\n    if report.degraded {\n        // Sibling genuinely absent (standalone clone): warning only,\n        // exit 0 — this is the ONE sanctioned degradation.\n        assert_eq!(report.rows.len(), 1, \"degraded report has one warn row\");\n        assert_eq!(report.rows[0].status, routing_parity::RowStatus::Warn);\n        return;\n    }\n\n    let fails = failing_rows(&report);\n    assert!(\n        fails.is_empty(),\n        \"routing-parity drift between routing.toml and ddl's MANAGED-TOOLS block: {fails:?}\"\n    );\n    // One row per managed tool — the gate never silently skips a\n    // first-party tool (anti-goal).\n    assert_eq!(report.rows.len(), 13, \"one row per managed tool\");\n    // The upstream entries resolve as data rows.\n    for tool in [\"bd\", \"openspec\"] {\n        let row = report\n            .rows\n            .iter()\n            .find(|r| r.tool == tool)\n            .unwrap_or_else(|| panic!(\"missing row for {tool}: {report:?}\"));\n        assert_eq!(row.status, routing_parity::RowStatus::Ok, \"{row:?}\");\n    }\n}\n"}],"details":{}}}
