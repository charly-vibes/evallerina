 accepts its rows (additive wiring, no bump).\n    assert_eq!(scenario_channel(\"doc-audit\"), Some(\"docs\"));\n\n    let rows = vec![doc_audit::report_row(\n        \"fakecli\",\n        &[\n            doc_audit::AuditRow {\n                token: \"orphaned\".into(),\n                code: \"ERR_DOC_NOT_FINDABLE\".into(),\n            },\n            doc_audit::AuditRow {\n                token: \"hidden\".into(),\n                code: \"ERR_FEATURE_UNDOCUMENTED\".into(),\n            },\n        ],\n    )];\n    assert_eq!(rows[0][\"report_version\"], 1, \"report_version stays 1\");\n\n    let configured = vec![\"model-a\".to_owned()];\n    let dashboard = aggregate_rows(&rows, &configured, &scenario_channel)\n        .expect(\"doc-audit rows aggregate cleanly\");\n    let matrix = dashboard[\"matrix\"].as_array().expect(\"matrix\");\n    assert_eq!(matrix.len(), 2, \"both codes are matrix-visible\");\n    let codes: Vec<&str> = matrix\n        .iter()\n        .map(|c| c[\"code\"].as_str().expect(\"code str\"))\n        .collect();\n    assert!(codes.contains(&\"ERR_FEATURE_UNDOCUMENTED\"));\n    assert!(codes.contains(&\"ERR_DOC_NOT_FINDABLE\"));\n    assert_eq!(dashboard[\"report_version\"], 1);\n}\nEOF\ncargo test --test doc_audit 2>&1 | grep -E \"error\\[|not found\" | head -4","timeout":300}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":7585,"output":881,"cacheRead":40320,"cacheWrite":0,"reasoning":188,"totalTokens":48786,"cost":{"input":0.0011377499999999999,"output":0.0004405,"cacheRead":0.0012096,"cacheWrite":0,"total":0.0027878499999999997}},"stopReason":"toolUse","timestamp":1792526701211,"responseId":"gen-1792526701-zJNdwFfVNX4AiFHc85Kx","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call-c0fd3075-14a9-4d5a-b42f-5bedfebceffd","toolName":"bash","content":[{"type":"text","text":"error[E0425]: cannot find function `parse_config` in module `doc_audit`\n    |                              ^^^^^^^^^^^^ not found in `doc_audit`\nerror[E0425]: cannot find function `report_row` in module `doc_audit`\n    |                                ^^^^^^^^^^ not found in `doc_audit`\n"}],"isError":false,"timestamp":1792526712716},{"role":"assistant","content":[{"type":"toolCall","id":"call-06cb8e67-091e-45d0-af4e-48309b14d611","name":"edit","arguments":{"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/doc_audit.rs","edits":[{"oldText":"/// Per-tool audit configuration, parsed from the checked-in\n/// `doc_audit.toml` (`[tool]` sections, same shape as routing.toml).\n/// `surface_none` marks non-Rust-CLI tools (e.g. `bd`, `openspec`):\n/// they skip the binary probe and are recorded in provenance, never\n/// silently skipped.","newText":"/// Per-tool audit configuration, parsed from the checked-in\n/// `doc_audit.toml` (`[tool]` sections, same shape as routing.toml).\n/// `surface_none` marks non-Rust-CLI tools (e.g. `bd`, `openspec`):\n/// they skip the binary probe and are recorded in provenance, never\n/// silently skipped.\n///\n/// Parse `doc_audit.toml` contents into per-tool configs. `binary`\n/// defaults to the tool name; `surface = \"none\"` marks the tool as\n/// binary-probe-skippable. Unknown fields are ignored (additive\n/// evolution) but a malformed value is a loud parse error.\npub fn parse_config(toml_src: &str) -> Result<Vec<ToolConfig>, String> {\n    let value: toml::Value =\n        toml::from_str(toml_src).map_err(|e| format!(\"doc_audit.toml parse error: {e}\"))?;\n    let table = value\n        .as_table()\n        .ok_or(\"doc_audit.toml must be a table of [tool] sections\")?;\n    let mut configs = Vec::new();\n    for (tool, item) in table {\n        let repo = item\n            .get(\"repo\")\n            .and_then(toml::Value::as_str)\n            .ok_or_else(|| format!(\"doc_audit.toml [{tool}] lacks a `repo` string\"))?;\n        let surface = item\n            .get(\"surface\")\n            .and_then(toml::Value::as_str)\n            .unwrap_or(\"binary\");\n        if surface != \"none\" && surface != \"binary\" {\n            return Err(format!(\"doc_audit.toml [{tool}]: unknown surface '{surface}'\"));\n        }\n        configs.push(ToolConfig {\n            tool: tool.clone(),\n            repo: repo.to_owned(),\n            binary: Some(\n                item.get(\"binary\")\n                    .and_then(toml::Value::as_str)\n                    .unwrap_or(tool)\n                    .to_owned(),\n            ),\n            surface_none: surface == \"none\",\n        });\n    }\n    Ok(configs)\n}\n\n/// Shape one tool's audit rows as a report_version 1 report row (the\n/// additive wiring): a `doc-audit` scenario probing the `docs` channel,\n/// one failed check per audit row carrying the check-code. The existing\n/// dashboard aggregates these without modification.\npub fn report_row(tool: &str, rows: &[AuditRow]) -> serde_json::Value {\n    let checks: Vec<serde_json::Value> = rows\n        .iter()\n        .map(|r| {\n            serde_json::json!({\n                \"name\": format!(\"doc:{}\", r.token),\n                \"passed\": false,\n                \"code\": r.code,\n                \"reason\": format!(\"feature token '{}' is undocumented or unfindable\", r.token),\n            })\n        })\n        .collect();\n    serde_json::json!({\n        \"report_version\": 1,\n        \"scenario\": \"doc-audit\",\n        \"tool\": tool,\n        \"status\": \"failed\",\n        \"checks\": checks,\n    })\n}"}]}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":8535,"output":869,"cacheRead":40320,"cacheWrite":0,"reasoning":0,"totalTokens":49724,"cost":{"input":0.00128025,"output":0.0004345,"cacheRead":0.0012096,"cacheWrite":0,"total":0.00292435}},"stopReason":"toolUse","timestamp":1792526712718,"responseId":"gen-1792526712-xwi1GKaYONU3cpu0Hj77","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"cal