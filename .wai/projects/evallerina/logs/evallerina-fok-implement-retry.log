/charly/evallerina/src/doc_audit.rs","edits":[{"oldText":"use std::collections::BTreeSet;\nuse std::process::Command;","newText":"use std::collections::BTreeSet;\nuse std::process::Command;\n\n/// Per-tool audit configuration, parsed from the checked-in\n/// `doc_audit.toml` (`[tool]` sections, same shape as routing.toml).\n/// `surface_none` marks non-Rust-CLI tools (e.g. `bd`, `openspec`):\n/// they skip the binary probe and are recorded in provenance, never\n/// silently skipped.\n#[derive(Debug, Clone, PartialEq)]\npub struct ToolConfig {\n    pub tool: String,\n    pub repo: String,\n    pub binary: Option<String>,\n    pub surface_none: bool,\n}\n\n/// Provenance for one tool's audit run: the loud record of what the\n/// audit actually did. `extracted` carries the harvested token set;\n/// `skip` (surface none), `binary_absent`, and `repo_absent` are\n/// explicit non-extractions — never silent (anti-goal, pinned by test).\n#[derive(Debug, Clone, PartialEq)]\npub struct Provenance {\n    pub tool: String,\n    pub status: String,\n    pub detail: String,\n    pub tokens: BTreeSet<String>,\n}\n\n/// Run the surface step for one configured tool: either record the\n/// `skip` provenance (`surface = \"none\"`), or probe the binary and\n/// harvest its token set. A missing binary is `binary_absent` provenance\n/// — loud, not an error and not a silent skip.\npub fn audit_tool_surface(config: &ToolConfig) -> Result<Provenance, String> {\n    if config.surface_none {\n        return Ok(Provenance {\n            tool: config.tool.clone(),\n            status: \"skip\".to_owned(),\n            detail: \"surface = none: not a --help-probeable CLI surface\".to_owned(),\n            tokens: BTreeSet::new(),\n        });\n    }\n    let binary = config\n        .binary\n        .as_deref()\n        .unwrap_or(&config.tool)\n        .to_owned();\n    match extract_surface(&binary) {\n        Ok(tokens) => Ok(Provenance {\n            tool: config.tool.clone(),\n            status: \"extracted\".to_owned(),\n            detail: format!(\"{binary} --help\"),\n            tokens,\n        }),\n        Err(_) => Ok(Provenance {\n            tool: config.tool.clone(),\n            status: \"binary_absent\".to_owned(),\n            detail: format!(\"binary '{binary}' not runnable — audit cannot probe its surface\"),\n            tokens: BTreeSet::new(),\n        }),\n    }\n}"}]}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":8764,"output":696,"cacheRead":31360,"cacheWrite":0,"reasoning":0,"totalTokens":40820,"cost":{"input":0.0013146,"output":0.000348,"cacheRead":0.0009407999999999999,"cacheWrite":0,"total":0.0026033999999999996}},"stopReason":"toolUse","timestamp":1792526572377,"responseId":"gen-1792526572-8ozhpVcuZRJxArQ8Rsi9","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call-21264cc3-2da2-465e-9da2-32e9e6d9b53a","toolName":"edit","content":[{"type":"text","text":"Successfully replaced 1 block(s) in /var/home/sasha/para/areas/dev/gh/charly/evallerina/src/doc_audit.rs."}],"details":{"diff":"     ...\n  20 \n  21 use std::collections::BTreeSet;\n  22 use std::process::Command;\n  23 \n+ 24 /// Per-tool audit configuration, parsed from the checked-in\n+ 25 /// `doc_audit.toml` (`[tool]` sections, same shape as routing.toml).\n+ 26 /// `surface_none` marks non-Rust-CLI tools (e.g. `bd`, `openspec`):\n+ 27 /// they skip the binary probe and are recorded in provenance, never\n+ 28 /// silently skipped.\n+ 29 #[derive(Debug, Clone, PartialEq)]\n+ 30 pub struct ToolConfig {\n+ 31     pub tool: String,\n+ 32     pub repo: String,\n+ 33     pub binary: Option<String>,\n+ 34     pub surface_none: bool,\n+ 35 }\n+ 36 \n+ 37 /// Provenance for one tool's audit run: the loud record of what the\n+ 38 /// audit actually did. `extracted` carries the harvested token set;\n+ 39 /// `skip` (surface none), `binary_absent`, and `repo_absent` are\n+ 40 /// explicit non-extractions — never 