{"type":"tool_execution_update","toolCallId":"call_58e2de51bb5a400f8c529460","toolName":"bash","args":{"command":"cd /var/home/sasha/para/areas/dev/gh/charly/evallerina && git show f628b68 | head -250","timeout":60},"partialResult":{"content":[{"type":"text","text":"commit f628b68ee0de71f76c3ef1a5408053e29bf2561d\nAuthor: charly vibes <charly.vibes@proton.me>\nDate:   Mon Oct 19 15:10:47 2026 -0300\n\n    test(ablation): hermetic fallback unchanged without the real opt-in (evallerina-0j8 step 3)\n    \n    Pins that AixSource::Static provisions exactly today's contents into\n    the full arm's fixture (full arm passes a content-equality check,\n    ablated arm sees none) — CI without tool binaries runs hermetically,\n    behavior byte-for-byte unchanged from pre-0j8.\n\ndiff --git a/tests/ablation.rs b/tests/ablation.rs\nindex 6b7ab82..6775077 100644\n--- a/tests/ablation.rs\n+++ b/tests/ablation.rs\n@@ -221,6 +221,41 @@ fn real_generation_llms_txt_is_genesis_output_for_the_tool_set() {\n     std::fs::remove_dir_all(&dir).ok();\n }\n \n+// ── hermetic fallback (opt-out / no tool binaries) ─────────────────────────\n+\n+/// Without the real-generation opt-in (no tool binaries provisioned,\n+/// or the caller simply doesn't opt in) the harness stays hermetic:\n+/// the full arm provisions exactly today's static contents — behavior\n+/// byte-for-byte unchanged.\n+#[test]\n+fn static_source_provisions_hermetic_contents_unchanged() {\n+    let static_md = test_artifacts().managed_agents_md;\n+    let scenario =\n+        Scenario::new(\"hermetic-probe\", \"create the file\").check(\"agents-md-is-static\", move |r| {\n+            let md = std::fs::read_to_string(r.fixture_root.join(\"AGENTS.md\")).unwrap_or_default();\n+            if md == static_md {\n+                CheckOutcome::pass()\n+            } else {\n+                CheckOutcome::tool_fault(\"AGENTS.md is not the hermetic static content\")\n+            }\n+        });\n+    let report = run_ablation(\n+        &scenario,\n+        &[\"m1\".to_owned()],\n+        3,\n+        AixSource::Static(&test_artifacts()),\n+        AblationFactories {\n+            full: &mut green_factory(),\n+            ablated: &mut green_factory(),\n+        },\n+        &Bounds::default(),\n+        &always_open,\n+    )\n+    .expect(\"ablation runs\");\n+    assert_eq!(report.full.passed, 3, \"full arm sees the static contents\");\n+    assert_eq!(report.ablated.failed, 3, \"ablated arm sees none of them\");\n+}\n+\n // ── the A/B shape ───────────────────────────────────────────────────────────\n \n /// The Must gate: an A/B report for one scenario with the delta\n"}],"details":{}}}
