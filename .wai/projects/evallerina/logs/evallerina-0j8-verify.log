discovery::read_manifest(fixture_dir)\n+        .ok_or(\"wai init left no readable .genesis/tools.toml manifest\")?;\n+    let mut modules: Vec<genesis::aix::ModuleEntry> = manifest\n+        .tools\n+        .into_iter()\n+        .map(|(name, entry)| genesis::aix::ModuleEntry {\n+            name,\n+            description: entry.description,\n+        })\n+        .collect();\n+    // Map iteration is unordered; the standardized listing is stable.\n+    modules.sort_by(|a, b| a.name.cmp(&b.name));\n+    let name = fixture_dir\n+        .file_name()\n+        .and_then(|n| n.to_str())\n+        .unwrap_or(\"dulce-fixture\")\n+        .to_owned();\n+    let meta = genesis::aix::ProjectMeta {\n+        name,\n+        tagline: \"the dulce-de-leche tool family\".to_owned(),\n+        repository: None,\n+        documentation: None,\n+        crates_io: None,\n+    };\n+    Ok(genesis::aix::generate_llms_txt(&meta, &modules))\n+}\n+\n /// The provisioned tool binaries available for real artifact\n /// generation ([`AixSource::Real`]). Paths, not versions: generation\n /// asserts on process exit codes and produced files, never tool\ndiff --git a/tests/ablation.rs b/tests/ablation.rs\nindex 878361d..6b7ab82 100644\n--- a/tests/ablation.rs\n+++ b/tests/ablation.rs\n@@ -185,6 +185,42 @@ fn real_generation_writes_managed_agents_md_with_wai_provenance() {\n     std::fs::remove_dir_all(&dir).ok();\n }\n \n+/// Real generation: the fixture's `llms.txt` is the genesis-vibes\n+/// `generate_llms_txt` output for the fixture tool set — title, module\n+/// section markers, and the registered tool entries, never placeholder\n+/// text. Runs for real wherever the tool is provisioned.\n+#[test]\n+fn real_generation_llms_txt_is_genesis_output_for_the_tool_set() {\n+    let Some(wai) = ToolBinaries::discover_wai() else {\n+        return; // no tool binaries provisioned → hermetic skip\n+    };\n+    let dir = unique_dir(\"real-llms-txt\");\n+    let generated =\n+        AixArtifacts::for_fixture(&dir, &ToolBinaries { wai }).expect(\"wai init generates\");\n+    // The standardized concise format: `# {project}` title and the\n+    // module listing of the registered fixture tool set.\n+    assert!(\n+        generated.llms_txt.starts_with(\"# \"),\n+        \"llms.txt carries the project title: {}\",\n+        generated.llms_txt\n+    );\n+    assert!(\n+        generated.llms_txt.contains(\"## Modules\"),\n+        \"llms.txt carries the module sectio"}],"details":{}}}
