_map)\n243:    // Live rows hardcode tool: \"wai\" (src/live.rs); a drifted row tool\n251:            // Row tool says \"wai\"; scenario definition recorded \"dont\".\n252:            trial_row(\"dont-hint-adherence-lifecycle\", \"wai\", m)\n263:    assert_eq!(p[\"row_provenance\"][0][\"tool\"], \"wai\");\n268:    let toml_src = \"[wai]\\nrepo = \\\"../wai\\\"\\n\\n[genesis]\\nrepo = \\\"../genesis\\\"\\n\";\n270:    assert_eq!(map.get(\"wai\").map(String::as_str), Some(\"../wai\"));\n271:    assert_eq!(map.get(\"genesis\").map(String::as_str), Some(\"../genesis\"));\n276:    let err = routing::parse_routing_toml(\"[wai]\\ndescription = \\\"no repo\\\"\\n\")\n285:        routing::resolve_repo(\"../wai\", root),\n286:        \"/worktrees/evallerina/../wai\"\n294:        routing::resolve_repo(\"/para/worktrees/wai\", root),\n295:        \"/para/worktrees/wai\"\n309:                trial_row(\"wai-hint-adherence-typo\", \"wai\", m),\n310:                trial_row(\"wai-doc-drift-stale-agents-md\", \"wai\", m),\n315:    map.insert(\"wai\".to_owned(), \"../wai\".to_owned());\n317:        (s == \"wai-hint-adherence-typo\" || s == \"wai-doc-drift-stale-agents-md\")\n318:            .then(|| \"wai\".to_owned())\n361:    let token = \"evallerina:wai-hint-adherence-typo:tool_fault\";\n364:        \"wai-hint-adherence-typo: tool_fault\",\n384:            .any(|(_, a)| a.contains(&\"--status\".to_owned()) && a.contains(&\"open\".to_owned())),\n385:        \"dedup search must pass --status open\"\n392:    // bd search includes closed issues by default — the status filter\n396:    let token = \"evallerina:wai-hint-adherence-typo:tool_fault\";\n398:        \"wai-hint-adherence-typo: tool_fault\",\n426:    let token = \"evallerina:wai-hint-adherence-typo:tool_fault\";\n477:    // repo's .beads/issues.jsonl is the fresh source of truth.\n479:    let token = \"evallerina:wai-hint-adherence-typo:tool_fault\";\n485:    let jsonl_path = repo.path.join(\".beads/issues.jsonl\");\n504:    