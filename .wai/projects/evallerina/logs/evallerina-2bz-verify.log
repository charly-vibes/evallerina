as_nanos() as u64,\n        ));\n        std::fs::create_dir_all(&path).expect(\"create sandbox dir\");\n        Sandbox { path }\n    }\n\n    /// A sandbox with beads initialized (`bd init` inside the sandbox).\n    fn with_beads(tag: &str) -> Self {\n        let sb = Sandbox::fresh(tag);\n        routing::run_bd(&sb.path, &[\"init\"]).expect(\"bd init in sandbox\");\n        sb\n    }\n\n    /// Create an issue via bd in this sandbox; returns the issue id.\n    fn bd_create(&self, title: &str, body: &str) -> String {\n        let out = routing::run_bd(&self.path, &[\"create\", title, \"-d\", body, \"--json\"])\n            .expect(\"bd create in sandbox\");\n        assert!(\n            out.status.success(),\n            \"bd create failed: {}\",\n            String::from_utf8_lossy(&out.stderr)\n        );\n        let v: serde_json::Value = serde_json::from_slice(&out.stdout).expect(\"bd create --json\");\n        v[\"id\"].as_str().expect(\"issue id\").to_owned()\n    }\n}\n\nimpl Drop for Sandbox {\n    fn drop(&mut self) {\n        let _ = std::fs::remove_dir_all(&self.path);\n    }\n}\n\n/// A proposal row ready for filing into `repo` (dry_run, mapped tool).\nfn failable_row(token: &str, repo: &std::path::Path) -> routing::ProposalRow {\n    routing::ProposalRow {\n        tool: \"wai\".to_owned(),\n        repo: Some(repo.to_string_lossy().into_owned()),\n        scenario: \"wai-hint-adherence-typo\".to_owned(),\n        fault_class: \"tool_fault\".to_owned(),\n        token: token.to_owned(),\n        decision: \"dry_run\".to_owned(),\n        reason: None,\n        bd_issue_id: None,\n        row_provenance: vec![],\n    }\n}\n\n/// A recording bd runner: delegates to the real `bd` (process boundary:\n/// assert on exit codes + parsed ids) while capturing every invocation\n/// so tests can assert on calls (e.g. zero `bd create`).\nstruct BdSpy {\n    calls: Vec<(PathBuf, Vec<String>)>,\n}\n\nimpl BdSpy {\n    fn new() -> Self {\n        BdSpy { calls: Vec::new() }\n    }\n\n    fn runner(\n        &mut self,\n    ) -> impl FnMut(&std::path::Path, &[&str]) -> Result<std::process::Output, String> + '_ {\n        |cwd, args| {\n            self.calls.push((\n                cwd.to_path_buf(),\n                args.iter().map(|s| s.to_string()).collect(),\n            ));\n            routing::run_bd(cwd, args)\n        }\n    }\n\n    fn create_calls(&self) -> Vec<&(PathBuf, Vec<String>)> {\n        self.calls\n            .iter()\n            .filter(|(_, a)| a.first().map(String::as_str) == Some(\"create\"))\n            .collect()\n    }\n}\n\nimpl Sandbox {\n    /// All open issues in this sandbox, parsed from `bd list --status open --json`.\n"}],"isError":false,"timestamp":1792429546892},{"role":"assistant","content":[{"type":"thinking","thinking":"Isolation looks good: Sandbox under std::env::temp_dir(), deleted on drop, BdSpy records cwd. The repo_map with \"../wai\" appears in propose tests — those are dry-run proposal tests (task 1, presumably), and `resolve_repo` tests just compute paths. Need to verify no test writes to ../wai. The failable_row takes repo path — in filing tests they presumably pass sandbox paths. Let me check where failable_row is used and whether resolve_repo touches fs. Also check no bd search without --status open in src and tests.\n\nThen run tests.","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"Isolation looks good: Sandbox under std::env::temp_dir(), deleted on drop, BdSpy records cwd. The repo_map with \\\"../wai\\\" appears in propose tests — those are dry-run proposal tests (task 1, presumably), and `resolve_repo` tests just compute paths. Need to verify no test writes to ../wai. The failable_row takes repo path — in filing tests they presumably pass sandbox paths. Let me check where failable_row is used and whether resolve_repo touches fs. Also check no bd search without --status open in src and tests.\\n\\nThen run tests.\",\"format\":\"unknown\",\"index\":0}]"},