       },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:rekey\",\n          \"passed\": false,\n          \"reason\": \"feature token 'rekey' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:skipspecs\",\n          \"passed\": false,\n          \"reason\": \"feature token 'skipspecs' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_FEATURE_UNDOCUMENTED\",\n          \"name\": \"doc:verbose\",\n          \"passed\": false,\n          \"reason\": \"feature token 'verbose' is undocumented or unfindable\"\n        }\n      ],\n      \"report_version\": 1,\n      \"scenario\": \"doc-audit\",\n      \"status\": \"failed\",\n      \"tool\": \"specodelic\"\n    },\n    {\n      \"checks\": [\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:calibrate\",\n          \"passed\": false,\n          \"reason\": \"feature token 'calibrate' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:completions\",\n          \"passed\": false,\n          \"reason\": \"feature token 'completions' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:discover\",\n          \"passed\": false,\n          \"reason\": \"feature token 'discover' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:exec\",\n          \"passed\": false,\n          \"reason\": \"feature token 'exec' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:fingerprint\",\n          \"passed\": false,\n          \"reason\": \"feature token 'fingerprint' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:help\",\n          \"passed\": false,\n          \"reason\": \"feature token 'help' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:human\",\n          \"passed\": false,\n          \"reason\": \"feature token 'human' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:import\",\n          \"passed\": false,\n          \"reason\": \"feature token 'import' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:ingest\",\n          \"passed\": false,\n          \"reason\": \"feature token 'ingest' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:metrics\",\n          \"passed\": false,\n          \"reason\": \"feature token 'metrics' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:oracle\",\n          \"passed\": false,\n          \"reason\": \"feature token 'oracle' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:quiet\",\n          \"passed\": false,\n          \"reason\": \"feature token 'quiet' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:select\",\n          \"passed\": false,\n          \"reason\": \"feature token 'select' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:verbose\",\n          \"passed\": false,\n          \"reason\": \"feature token 'verbose' is undocumented or unfindable\"\n        }\n      ],\n      \"report_version\": 1,\n      \"scenario\": \"doc-audit\",\n      \"status\": \"failed\",\n      \"tool\": \"testaruda\"\n    },\n    {\n      \"checks\": [\n        {\n          \"code\": \"ERR_FEATURE_UNDOCUMENTED\",\n          \"name\": \"doc:help\",\n          \"passed\": false,\n          \"reason\": \"feature token 'help' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:human\",\n          \"passed\": false,\n          \"reason\": \"feature token 'human' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_FEATURE_UNDOCUMENTED\",\n          \"name\": \"doc:quiet\",\n          \"passed\": false,\n          \"reason\": \"feature token 'quiet' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_FEATURE_UNDOCUMENTED\",\n          \"name\": \"doc:verbose\",\n          \"passed\": false,\n          \"reason\": \"feature token 'verbose' is undocumented or unfindable\"\n        }\n      ],\n      \"report_version\": 1,\n      \"scenario\": \"doc-audit\",\n      \"status\": \"failed\",\n      \"tool\": \"turu\"\n    },\n    {\n      \"checks\": [\n        {\n          \"code\": \"ERR_FEATURE_UNDOCUMENTED\",\n          \"name\": \"doc:completions\",\n          \"passed\": false,\n          \"reason\": \"feature token 'completions' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:help\",\n          \"passed\": false,\n          \"reason\": \"feature token 'help' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:initci\",\n          \"passed\": false,\n          \"reason\": \"feature token 'initci' is undocumented or unfindable\"\n        },\n        {\n          \"code\": \"ERR_DOC_NOT_FINDABLE\",\n          \"name\": \"doc:prove\",\n          \"passed\": false,\n          \"reason\": \"feature token 'prove' is undocumented or unfindable\"\n        }\n    