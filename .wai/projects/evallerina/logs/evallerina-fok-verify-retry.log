{"type":"turn_end","message":{"role":"assistant","content":[{"type":"toolCall","id":"4HO3rbPzl","name":"read","arguments":{"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/report.rs","offset":1,"limit":200}},{"type":"toolCall","id":"72RY7Mymm","name":"read","arguments":{"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/main.rs","offset":1,"limit":200}},{"type":"toolCall","id":"6H2IPE5m1","name":"read","arguments":{"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/doc_audit.rs","offset":1,"limit":200}},{"type":"toolCall","id":"HyrjlsWok","name":"read","arguments":{"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/doc_audit.toml","offset":1,"limit":200}},{"type":"toolCall","id":"ddNCGGhbz","name":"bash","arguments":{"command":"cargo test doc_audit","timeout":null}},{"type":"toolCall","id":"MKTtOrfQV","name":"bash","arguments":{"command":"just tier0","timeout":null}}],"api":"openai-completions","provider":"openrouter","model":"mistralai/mistral-small-3.2-24b-instruct","usage":{"input":37930,"output":209,"cacheRead":0,"cacheWrite":0,"reasoning":0,"totalTokens":38139,"cost":{"input":0.00284475,"output":0.000041800000000000006,"cacheRead":0,"cacheWrite":0,"total":0.00288655}},"stopReason":"toolUse","timestamp":1792528414156,"responseId":"gen-1792528414-UP9UXprDMfRJipkof3GR","rawStopReason":"tool_calls"},"toolResults":[{"role":"toolResult","toolCallId":"4HO3rbPzl","toolName":"read","content":[{"type":"text","text":"//! Purpose: Tier-1/2 report aggregation into the per-channel fault\n//! dashboard (evallerina-48g).\n//! Responsibilities: aggregate report_version 1 rows (tier-2 rotation\n//! events and tier-1 rows without model attribution) into a\n//! per-output-channel × check-code × model-id fault matrix, apply the\n//! evals-guidelines fault routing (tool faults → tool tickets; agent\n//! faults → AIX-channel work only at the cross-model threshold),\n//! surface absent, rate_limited, and http_error cells as coverage\n//! records — never failures, never dropped — and refuse loudly on unmappable scenarios\n//! instead of silently bucketing them.\n//! Rationale: evals-guidelines \"Fault routing\" and \"suite-wide\n//! aggregation\" requirements. The dashboard deliberately carries no\n//! single aggregate score: per-capability breakdown is a hard\n//! requirement, and a collapse into one number hides exactly the\n//! channel × code × model signal the routing rule needs.\n\nuse serde_json::json;\nuse std::collections::{BTreeMap, BTreeSet};\n\n/// Validate the `report` subcommand's routing flags: `--file` (cross-repo\n/// write authorization, Phase 2) requires `--route` — filing proposed\n/// tickets only makes sense after the routing step ran. Any combination\n/// without `--file` is fine.\npub fn validate_route_flags(route: bool, file: bool) -> Result<(), String> {\n    if file && !route {\n        return Err(\n            \"--file requires --route: filing proposed tickets only makes sense after the routing step ran\".into(),\n        );\n    }\n    Ok(())\n}\n\n/// The scenario definition's recorded tool — the repo key for routing\n/// (routing.rs keys proposals on this, never the report row's `tool`\n/// field, which is hardcoded for live trials). Scenario names\n/// prefix-encode the eval target by convention (`wai-*`, `dont-*`);\n/// an unknown prefix is None → a loud error downstream (never a\n/// silent bucket, mirroring aggregate_rows).\npub fn scenario_tool_of(name: &str) -> Option<String> {\n    if name.starts_with(\"wai-\") {\n        Some(\"wai\".to_owned())\n    } else if name.starts_with(\"dont-\") {\n        Some(\"dont\".to_owned())\n    } else {\n        None\n    }\n}\n\n/// Run the routing step against an aggregated dashboard: propose\n/// dry-run tickets from the same rows the dashboard aggregated from,\n/// optionally file them (Phase 2, `--file`), and attach the additive\n/// `routed` summary — decision counts only, no aggregate score — to\n/// the dashboard JSON.\n///\n/// Returns the proposals so the caller can serialize\n/// proposed-tickets.jsonl. Routing never affects the exit code unless\n/// it errors loudly (empty registry, unknown scenario, version\n/// mismatch): skipped proposals (unmapped tool, bd failure) are the\n/// record, not failures.\npub fn attach_routing(\n    dashboard: &mut serde_json::Value,\n    rows: &[serde_json::Value],\n    configured_models: &[String],\n    repo_map: &BTreeMap<String, String>,\n    file_authorized: bool,\n    run_bd: &mut crate::routing::BdRunner,\n) -> Result<Vec<crate::routing::ProposalRow>, String> {\n    let mut proposals =\n        crate::routing::propose(rows, configured_models, &scenario_tool_of, repo_map)?;\n    crate::routing::file_proposals(&mut proposals, file_authorized, run_bd)?;\n\n    let (mut filed, mut existing, mut dry_run, mut skipped) = (0usize, 0, 0, 0);\n    for p in &proposals {\n        match p.decision.as_str() {\n            \"filed\" => filed += 1,\n            \"existing\" => existing += 1,\n            \"dry_run\" => dry_run += 1,\n            _ => skipped += 1,\n        }\n    }\n    dashboard[\"routed\"] = json!({\n        \"filed\": filed,\n        \"existing\": existing,\n        \"dry_run\": dry_run,\n        \"skipped\": skipped,\n    });\n    Ok(proposals)\n}\n\n/// The full CLI routing step for `report --route`: load routing.toml\n/// (from the current directory — the repo root on rotation day),\n/// attach the routed summary to the dashboard, and write\n/// proposed-tickets.jsonl next to the report file. `file_authorized`\n/// comes from the explicit `--file` flag; the runner is injectable so\n/// tests can spy on bd calls.\npub fn run_routing_step(\n    dashboard: &mut serde_json::Value,\n    rows: &[serde_json::Value],\n    configured_models: &[String],\n    report_path: &std::path::Path,\n    file_authorized: bool,\n    run_bd: &mut crate::routing::BdRunner,\n) -> Result<Vec<crate::routing::ProposalRow>, String> {\n    let content = std::fs::read_to_string(\"routing.toml\")\n        .map_err(|e| format!(\"cannot read routing.toml: {e}\"))?;\n    let repo_map = crate::routing::parse_routing_toml(&content)?;\n    let proposals = attach_routing(\n        dashboard,\n        rows,\n        configured_models,\n        &repo_map,\n        file_authorized,\n        run_bd,\n    )?;\n    let jsonl = crate::routing::to_jsonl(&proposals);\n    let out_path = report_path\n        .parent()\n        .unwrap_or(std::path::Path::new(\".\"))\n        .join(\"proposed-tickets.jsonl\");\n    std::fs::write(&out_path, jsonl)\n        .map_err(|e| format!(\"cannot write {}: {e}\", out_path.display()))?;\n    Ok(proposals)\n}\n\n/// Version of the dashboard shape. Additive evolution only within a\n/// version; breaking changes bump this.\npub const DASHBOARD_VERSION: u32 = 1;\n\n/// The evals-guidelines cross-model routing threshold for agent faults\n/// within one output channel.\nconst ROUTING_THRESHOLD: usize = 3;\n\n/// The output channel a live scenario's checks probe (the fault-routing\n/// key per evals-guidelines: suggestions, envelope, managed-block, or\n/// artifact surface). Registered for every live scenario; the channel\n/// must exist before rotation day, not after the first dashboard run.\npub fn scenario_channel(name: &str) -> Option<&'static str> {\n    match name {\n        \"wai-hint-adherence-smoke\"\n        | \"wai-hint-adherence-corrupt-config\"\n        | \"dont-hint-adherence-lifecycle\" => Some(\"envelope\"),\n        \"wai-hint-adherence-typo\" => Some(\"suggestions\"),\n        \"wai-doc-drift-stale-agents-md\" | \"dont-doc-drift-stale-lifecycle\" => Some(\"artifact\"),\n        // Archetype family (evallerina-bhh): vampiro-polyglot-seam asserts\n        // on vampiro's gate/guidance JSON envelopes; wai-drifted-ecosystem\n        // probes the stale-AGENTS.md artifact via doc_drift_blindness,\n        // mapping to `artifact` like its doc-drift siblings.\n        \"vampiro-polyglot-seam\" => Some(\"envelope\"),\n        \"wai-drifted-ecosystem\" => Some(\"artifact\"),\n        // Tier-0 doc-coverage audit rows (evallerina-fok, additive:\n        // report_version stays 1) probe the `docs` channel — feature\n        // documentation is the output channel the audit checks.\n        \"doc-audit\" => Some(\"docs\"),\n        _ => None,\n    }\n}\n\n/// One accumulator key in the routing maps: agent faults key on\n/// (channel, code), tool faults on (tool, check, channel) because they\n/// carry no code by contract.\n#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]\nenum FaultKey {\n    /// Agent fault: the `ERR_*` taxonomy code within one output channel.\n    Agent { channel: String, code: String },\n    /// Tool fault: no code; routed to the tool's repository.\n    Tool {\n        tool: String,\n        check: String,\n        channel: String,\n    },\n}\n\n/// Accumulated occurrences for one fault key: total count plus the set\n/// of distinct model ids observed (empty for non-tier-2 rows).\n#[derive(Debug, Default)]\nstruct FaultTally {\n    occurrences: usize,\n    models: BTreeSet<String>,\n    scenarios: BTreeSet<String>,\n}\n\n/// Aggregate report_version 1 rows into the dashboard JSON.\n///\n/// `rows` are parsed report rows as [`serde_json::Value`]: tier-2\n/// rotation events (`kind: trial | absent`) or tier-1 rows without a\n/// `model` field (grouped as non-tier-2 per the report contract).\n/// `configured_models` is the model registry the rotation was\n/// configured with — it defines the routing threshold (3, or the full\n/// registry size when fewer than three are configured). `channel_of`\n/// resolves a scenario to the output channel its checks probe; an\n/// unknown scenario is a loud error, never a silent bucket.\n///\n/// The returned value is the serialized dashboard shape: no single\n/// aggregate score, per-capability breakdown only.\npub fn aggregate_rows(\n    rows: &[serde_json::Value],\n    configured_models: &[String],\n    channel_of: &dyn Fn(&str) -> Option<&'static str>,\n) -> Result<serde_json::Value, String> {\n    if configured_models.is_empty() {\n\n[275 more lines in file. Use offset=201 to continue.]"}],"isError":false,"timestamp":1792528440664},{"role":"toolResult","toolCallId":"72RY7Mymm","toolName":"read","content":[{"type":"text","text":"//! Purpose: CLI entry point of the evallerina harness.\n//! Responsibilities: expose the tier commands the justfile recipes\n//! invoke — `smoke` (run the replay smoke scenario, exit code carries\n//! pass/fail) and `live` (tier-2 live rotation over scenario × model\n//! cells via the OpenRouter :free action protocol).\n//! Rationale: tier discipline — the binary gates tier-0/1 locally and\n//! in CI; tier-2 never gates a push. `live` prints one JSON event per\n//! cell (trial row or absent record) and exits nonzero only when a\n//! trial actually failed or malformed — skipped cells are the record.\n\nuse std::io::Write;\nuse std::process::ExitCode;\nuse std::time::{Duration, Instant};\n\nuse clap::{Parser, Subcommand};\nuse evallerina::ablation::{\n    AblationFactories, AixArtifacts, AixSource, ToolBinaries, run_ablation,\n};\nuse evallerina::live::{OpenRouterTransport, RotationEvent, TrialStatus, run_rotation};\nuse evallerina::recorded::RecordedTrajectory;\nuse evallerina::registry::{DEFAULT_REPETITIONS, ordered_ids};\nuse evallerina::scenario::{SCENARIOS_DIR, live_scenario_by_name, live_scenarios, smoke_scenario};\n\n/// Default per-run wall-clock budget for the live rotation, minutes.\nconst DEFAULT_BUDGET_MINS: u64 = 20;\n\n/// Evals with an avatar — measuring whether agents actually use the tools.\n#[derive(Parser)]\n#[command(name = \"evallerina\", version, about)]\nstruct Cli {\n    #[command(subcommand)]\n    command: Command,\n}\n\n#[derive(Subcommand)]\nenum Command {\n    /// Run the tier-1 smoke replay (no model, no network). Exit 0 iff green.\n    Smoke,\n    /// Tier-2 live rotation (requires OPENROUTER_API_KEY). One JSON\n    /// event per cell on stdout: a report_version 1 trial row, or an\n    /// absent record when the per-run budget skipped the cell.\n    Live {\n        /// Optional scenario name filter (default: the whole live battery).\n        #[arg(default_value = None)]\n        scenario: Option<String>,\n        /// Repetitions per scenario × model cell.\n        #[arg(long, default_value_t = DEFAULT_REPETITIONS)]\n        reps: u32,\n        /// Run only this model id (default: the whole registry, in order).\n        #[arg(long, default_value = None)]\n        model: Option<String>,\n        /// Per-run wall-clock budget, minutes; cells not started before\n        /// it expires are recorded absent, never failed.\n        #[arg(long, default_value_t = DEFAULT_BUDGET_MINS)]\n        budget_mins: u64,\n    },\n    /// A/B ablation over one scenario (evals.md Step 5): the full arm\n    /// (AIX artifacts provisioned) vs the ablated arm (raw binaries),\n    /// ≥3 runs per arm over the configured model registry. Writes the\n    /// per-arm rotation rows as ArmReport JSONL to --out and prints the\n    /// per-arm summary + delta as JSON on stdout.\n    Ablate {\n        /// Scenario name (a live battery scenario; unknown names are a\n        /// loud error).\n        scenario: String,\n        /// Repetitions per arm (the evals.md Step 5 delta floor is 3).\n        #[arg(long, default_value_t = DEFAULT_REPETITIONS)]\n        reps: u32,\n        /// Run only this model id (default: the whole registry, in order).\n        #[arg(long, default_value = None)]\n        model: Option<String>,\n        /// Dry-run: every cell is recorded absent — no model calls, no\n        /// network; exercises the full report path hermetically.\n        #[arg(long)]\n        dry_run: bool,\n        /// Real artifact generation (opt-in; evallerina-0j8): invoke the\n        /// provisioned `wai` binary and harvest what it produces for the\n        /// full arm, instead of the static hermetic contents. A tool\n        /// failure is a loud error, never a placeholder fallback.\n        #[arg(long)]\n        real_artifacts: bool,\n        /// Per-run wall-clock budget, minutes; cells not started before\n        /// it expires are recorded absent, never failed.\n        #[arg(long, default_value_t = DEFAULT_BUDGET_MINS)]\n        budget_mins: u64,\n        /// Path the ArmReport JSONL rows are written to (full arm rows\n        /// first, then ablated, in run order).\n        #[arg(long)]\n        out: String,\n    },\n    /// Aggregate report rows (one JSON value per line in a JSONL file —\n    /// tier-2 rotation events or tier-1 rows) into the per-channel\n    /// fault dashboard. Prints the dashboard JSON to stdout; exits\n    /// nonzero on aggregation errors (unknown scenario, version\n    /// mismatch), never on fault findings.\n    Report {\n        /// Path to the JSONL report rows to aggregate.\n        path: String,\n        /// Run the fault-routing step after aggregation (dry-run by\n        /// default): attach the additive `routed` summary to the\n        /// dashboard and write proposed-tickets.jsonl next to the report.\n        #[arg(long)]\n        route: bool,\n        /// File the proposed tickets in their mapped repositories\n        /// (explicit cross-repo write authorization, Phase 2).\n        /// Requires --route.\n        #[arg(long)]\n        file: bool,\n    },\n    /// Tier-0 doc-coverage audit (evallerina-fok): harvest each\n    /// configured tool's CLI surface from `--help`, scan its repo's doc\n    /// surfaces (README, docs/**, llms.txt, AGENTS.md managed blocks),\n    /// and emit per-token audit rows (ERR_FEATURE_UNDOCUMENTED /\n    /// ERR_DOC_NOT_FINDABLE) plus provenance for every non-extracted\n    /// source — never a silent skip. Prints the audit as JSON. Findings\n    /// are the record, not failures: exit nonzero only on loud errors\n    /// (missing/malformed config, unreadable surface).\n    DocAudit,\n    /// Tier-0 routing-map parity gate (evallerina-0sy): diff\n    /// routing.toml against dulce-de-leche's MANAGED-TOOLS block\n    /// (../dulce-de-leche/README.md). Prints the parity report as JSON\n    /// (degraded flag + one row per managed tool) and exits nonzero iff\n    /// any row failed; an absent ddl sibling degrades to a warning row\n    /// with exit 0 (standalone clones), never covering a parse failure.\n    RoutingParity,\n}\n\n/// The hermetic static artifact set the full arm provisions by default\n/// (the ablated-arm baseline stays raw binaries either way). Real\n/// generation — the provisioned `wai` binary harvesting the actual\n/// managed AGENTS.md, `.genesis/tools.toml` and `llms.txt` — is opt-in\n/// via --real-artifacts (evallerina-0j8).\nconst DEFAULT_AIX_ARTIFACTS: AixArtifacts = AixArtifacts {\n    llms_txt: \"llms.txt content: wai status --json\",\n    managed_agents_md: \"<!-- WAI:START -->managed guidance<!-- WAI:END -->\",\n    tools_toml: \"[tools]\\nwai = { cmd = \\\"wai\\\" }\\n\",\n};\n\nfn main() -> std::process::ExitCode {\n    match Cli::parse().command {\n        Command::Smoke => {\n            let path = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n                .join(SCENARIOS_DIR)\n                .join(\"wai-hint-adherence-smoke.json\");\n            let content = std::fs::read_to_string(&path)\n                .unwrap_or_else(|e| panic!(\"read {}: {e}\", path.display()));\n            let trajectory = RecordedTrajectory::from_json(&content)\n                .unwrap_or_else(|e| panic!(\"parse {}: {e}\", path.display()));\n            let report = smoke_scenario()\n                .run(trajectory.steps())\n                .unwrap_or_else(|e| panic!(\"replay failed: {e}\"));\n            println!(\"{}\", serde_json::to_string_pretty(&report).unwrap());\n            if report.passed {\n                ExitCode::SUCCESS\n            } else {\n                ExitCode::FAILURE\n            }\n        }\n        Command::Live {\n            scenario,\n            reps,\n            model,\n            budget_mins,\n        } => match run_live(scenario, reps, model, budget_mins) {\n            Ok(code) => code,\n            Err(msg) => {\n                eprintln!(\"{msg}\");\n                ExitCode::FAILURE\n            }\n        },\n        Command::Report { path, route, file } => match run_report(&path, route, file) {\n            Ok(code) => code,\n            Err(msg) => {\n                eprintln!(\"{msg}\");\n                ExitCode::FAILURE\n            }\n        },\n        Command::DocAudit => match run_doc_audit() {\n            Ok(code) => code,\n            Err(e) => {\n                eprintln!(\"doc-audit: {e}\");\n                ExitCode::FAILURE\n            }\n        },\n        Command::RoutingParity => match run_routing_parity() {\n            Ok(code) => code,\n            Err(msg) => {\n                eprintln!(\"{msg}\");\n                ExitCode::FAILURE\n            }\n        },\n        Command::Ablate {\n            scenario,\n            reps,\n            model,\n            dry_run,\n            real_artifacts,\n            budget_mins,\n            out,\n        } => match run_ablate(\n\n[314 more lines in file. Use offset=201 to continue.]"}],"isError":false,"timestamp":1792528440665},{"role":"toolResult","toolCallId":"6H2IPE5m1","toolName":"read","content":[{"type":"text","text":"//! Purpose: tier-0 doc-coverage audit (evallerina-fok, openspec\n//! add-ecosystem-doc-evals design D1/D4) — harvest each tool's CLI\n//! surface from its `--help` output, scan the tool's documentation\n//! surfaces into per-surface feature-token sets, and diff the two into\n//! audit rows (`ERR_FEATURE_UNDOCUMENTED`, `ERR_DOC_NOT_FINDABLE`).\n//! Responsibilities: run a tool binary with `--help` and extract\n//! subcommands, long flags, and documented exit codes; normalize tokens\n//! so kebab/snake/spacing variants are equivalent (substring-normalized\n//! matching per D1); scan README.md, docs/**, llms.txt, and AGENTS.md\n//! managed blocks; treat llms.txt + managed blocks as breadcrumb\n//! sources for reachability; carry provenance for every non-extracted\n//! source (`skip` for `surface = \"none\"`, `binary_absent` for a missing\n//! binary, `repo_absent` for a missing local checkout) — never a silent\n//! skip; and expose report-shaped rows for the existing dashboard.\n//! Rationale: docs drift silently; this gate makes undocumented or\n//! unfindable features visible in `just tier0` output the moment they\n//! drift. Normalization rules are general (lowercase, alphanumeric-only\n//! canonical form) and never tuned to pass evallerina's own docs; there\n//! is deliberately no aggregate doc-quality score — per-token rows only.\n\nuse std::collections::{BTreeMap, BTreeSet};\nuse std::path::Path;\nuse std::process::Command;\n\n/// The docs surfaces the inventory scanner reads, relative to the\n/// audited repo root: the README, every `docs/**/*.md`, `llms.txt`,\n/// and `AGENTS.md` (managed blocks only matter for breadcrumbs, but\n/// the whole file is a surface).\nconst README_SURFACE: &str = \"README.md\";\nconst LLMS_SURFACE: &str = \"llms.txt\";\nconst AGENTS_SURFACE: &str = \"AGENTS.md\";\nconst DOCS_DIR: &str = \"docs\";\n\n/// Parse `doc_audit.toml` contents into per-tool configs. `binary`\n/// defaults to the tool name; `surface = \"none\"` marks the tool as\n/// binary-probe-skippable. Unknown fields are ignored (additive\n/// evolution) but a malformed value is a loud parse error.\npub fn parse_config(toml_src: &str) -> Result<Vec<ToolConfig>, String> {\n    let value: toml::Value =\n        toml::from_str(toml_src).map_err(|e| format!(\"doc_audit.toml parse error: {e}\"))?;\n    let table = value\n        .as_table()\n        .ok_or(\"doc_audit.toml must be a table of [tool] sections\")?;\n    let mut configs = Vec::new();\n    for (tool, item) in table {\n        let repo = item\n            .get(\"repo\")\n            .and_then(toml::Value::as_str)\n            .ok_or_else(|| format!(\"doc_audit.toml [{tool}] lacks a `repo` string\"))?;\n        let surface = item\n            .get(\"surface\")\n            .and_then(toml::Value::as_str)\n            .unwrap_or(\"binary\");\n        if surface != \"none\" && surface != \"binary\" {\n            return Err(format!(\n                \"doc_audit.toml [{tool}]: unknown surface '{surface}'\"\n            ));\n        }\n        configs.push(ToolConfig {\n            tool: tool.clone(),\n            repo: repo.to_owned(),\n            binary: Some(\n                item.get(\"binary\")\n                    .and_then(toml::Value::as_str)\n                    .unwrap_or(tool)\n                    .to_owned(),\n            ),\n            surface_none: surface == \"none\",\n        });\n    }\n    Ok(configs)\n}\n\n/// Shape one tool's audit rows as a report_version 1 report row (the\n/// additive wiring): a `doc-audit` scenario probing the `docs` channel,\n/// one failed check per audit row carrying the check-code. The existing\n/// dashboard aggregates these without modification.\npub fn report_row(tool: &str, rows: &[AuditRow]) -> serde_json::Value {\n    let checks: Vec<serde_json::Value> = rows\n        .iter()\n        .map(|r| {\n            serde_json::json!({\n                \"name\": format!(\"doc:{}\", r.token),\n                \"passed\": false,\n                \"code\": r.code,\n                \"reason\": format!(\"feature token '{}' is undocumented or unfindable\", r.token),\n            })\n        })\n        .collect();\n    serde_json::json!({\n        \"report_version\": 1,\n        \"scenario\": \"doc-audit\",\n        \"tool\": tool,\n        \"status\": \"failed\",\n        \"checks\": checks,\n    })\n}\n\n/// Per-tool audit configuration, parsed from the checked-in\n/// `doc_audit.toml` (`[tool]` sections, same shape as routing.toml).\n/// `surface_none` marks non-Rust-CLI tools (e.g. `bd`, `openspec`):\n/// they skip the binary probe and are recorded in provenance, never\n/// silently skipped.\n#[derive(Debug, Clone, PartialEq)]\npub struct ToolConfig {\n    pub tool: String,\n    pub repo: String,\n    pub binary: Option<String>,\n    pub surface_none: bool,\n}\n\n/// Provenance for one tool's audit run: the loud record of what the\n/// audit actually did. `extracted` carries the harvested token set;\n/// `skip` (surface none), `binary_absent`, and `repo_absent` are\n/// explicit non-extractions — never silent (anti-goal, pinned by test).\n#[derive(Debug, Clone, PartialEq)]\npub struct Provenance {\n    pub tool: String,\n    pub status: String,\n    pub detail: String,\n    pub tokens: BTreeSet<String>,\n}\n\n/// One repo's doc inventory: a token set per scanned surface, plus the\n/// breadcrumb set — the tokens reachable from `llms.txt` or AGENTS.md\n/// managed blocks (the discovery channels a fresh agent actually\n/// follows). Design D4: reachability is measured against breadcrumbs,\n/// not against raw doc presence.\n#[derive(Debug, Default, Clone, PartialEq)]\npub struct Inventory {\n    /// Surface path (relative to the repo root) → canonical tokens.\n    pub surfaces: BTreeMap<String, BTreeSet<String>>,\n    /// Tokens reachable from `llms.txt` or managed-block breadcrumbs.\n    pub breadcrumbs: BTreeSet<String>,\n}\n\n/// Scan a repo's documentation surfaces into per-surface token sets\n/// and the breadcrumb set. Missing surfaces are simply absent from the\n/// map (a repo without llms.txt has no breadcrumb channel — that\n/// itself makes its features unfindable, which the reachability check\n/// reports, not silently ignores).\npub fn scan_inventory(repo: &Path) -> Result<Inventory, String> {\n    let mut inv = Inventory::default();\n    for (rel, text) in surface_texts(repo)? {\n        let tokens = harvest_doc_tokens(&text);\n        if rel == LLMS_SURFACE {\n            inv.breadcrumbs.extend(tokens.iter().cloned());\n        } else if rel == AGENTS_SURFACE {\n            let managed = managed_block_text(&text);\n            inv.breadcrumbs.extend(harvest_doc_tokens(&managed));\n        }\n        inv.surfaces.insert(rel, tokens);\n    }\n    Ok(inv)\n}\n\n/// Read all scanned surfaces of a repo: README.md, docs/**/*.md,\n/// llms.txt, AGENTS.md — those that exist.\nfn surface_texts(repo: &Path) -> Result<Vec<(String, String)>, String> {\n    let mut out = Vec::new();\n    for rel in [README_SURFACE, LLMS_SURFACE, AGENTS_SURFACE] {\n        let path = repo.join(rel);\n        if path.is_file() {\n            let text = std::fs::read_to_string(&path)\n                .map_err(|e| format!(\"cannot read {}: {e}\", path.display()))?;\n            out.push((rel.to_owned(), text));\n        }\n    }\n    let docs = repo.join(DOCS_DIR);\n    if docs.is_dir() {\n        collect_docs_md(&docs, DOCS_DIR, &mut out)?;\n    }\n    Ok(out)\n}\n\n/// Recursively collect `*.md` files under docs/, keys relative to the\n/// repo root, sorted for deterministic iteration.\nfn collect_docs_md(\n    dir: &Path,\n    rel_prefix: &str,\n    out: &mut Vec<(String, String)>,\n) -> Result<(), String> {\n    let mut entries: Vec<_> = std::fs::read_dir(dir)\n        .map_err(|e| format!(\"cannot read {}: {e}\", dir.display()))?\n        .filter_map(|e| e.ok())\n        .collect();\n    entries.sort_by_key(|e| e.file_name());\n    for entry in entries {\n        let name = entry.file_name();\n        let name = name.to_string_lossy();\n        let rel = format!(\"{rel_prefix}/{name}\");\n        let path = entry.path();\n        if path.is_dir() {\n            collect_docs_md(&path, &rel, out)?;\n        } else if name.ends_with(\".md\") {\n            let text = std::fs::read_to_string(&path)\n                .map_err(|e| format!(\"cannot read {}: {e}\", path.display()))?;\n            out.push((rel, text));\n        }\n    }\n\n[249 more lines in file. Use offset=201 to continue.]"}],"isError":false,"timestamp":1792528440665},{"role":"toolResult","toolCallId":"HyrjlsWok","toolName":"read","content":[{"type":"text","text":"# doc_audit.toml — tier-0 doc-coverage audit config (evallerina-fok,\n# openspec add-ecosystem-doc-evals D1/D4). One `[tool]` section per\n# routing.toml tool. Relative `repo` paths resolve against the\n# evallerina repo root (same rules as routing.toml).\n#\n# Per tool:\n#   repo     — the repository whose doc surfaces are scanned\n#              (README.md, docs/**, llms.txt, AGENTS.md managed blocks)\n#   binary   — binary probed with `--help`; defaults to the tool name\n#   surface  — \"none\" for tools that are not --help-probeable CLIs:\n#              they skip the binary step and are recorded in\n#              provenance, never silently skipped.\n#\n# A missing binary records `binary_absent` provenance; a missing local\n# checkout records `repo_absent`. Every skip is provenance (anti-goal:\n# no silent skips).\n\n[wai]\nrepo = \"../wai\"\n\n[genesis]\nrepo = \"../genesis\"\n\n[espectacular]\nrepo = \"../espectacular\"\n\n[dont]\nrepo = \"../dont\"\n\n[testaruda]\nrepo = \"../testaruda\"\n\n# turu's repo is `whisper` (binary/crate name mismatch; ddl canonical table).\n[turu]\nrepo = \"../whisper\"\nbinary = \"turu\"\n\n# `ah` shares the espectacular checkout (binary name of the espectacular CLI).\n[ah]\nrepo = \"../espectacular\"\n\n[pretender]\nrepo = \"../pretender\"\n\n[vampiro]\nrepo = \"../vampiro\"\n\n[incitaciones]\nrepo = \"../incitaciones\"\n\n# Third-party upstreams: not locally checked-out Rust CLIs — surface\n# none, provenance-recorded, never silent.\n[openspec]\nrepo = \"fission-ai/openspec\"\nsurface = \"none\"\n\n[specodelic]\nrepo = \"../specodelic\"\n\n[funkalization]\nrepo = \"../funkalization\"\n\n[wild]\nrepo = \"../wild\"\n\n[dulce-de-leche]\nrepo = \"../dulce-de-leche\"\n\n[bd]\nrepo = \"gastownhall/beads\"\nsurface = \"none\"\n"}],"isError":false,"timestamp":1792528440665},{"role":"toolResult","toolCallId":"ddNCGGhbz","toolName":"bash","content":[{"