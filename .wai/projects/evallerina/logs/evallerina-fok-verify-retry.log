lacks a `tool` field\")?;\n        let checks = row\n            .get(\"checks\")\n            .and_then(serde_json::Value::as_array)\n            .ok_or(\"report row lacks a `checks` array\")?;\n        let report_version = row\n            .get(\"report_version\")\n            .and_then(serde_json::Value::as_u64)\n            .ok_or(\"report row lacks a `report_version` field\")?;\n        if report_version != 1 {\n            return Err(format!(\n                \"report row carries report_version {report_version}; this dashboard aggregates version 1 only\"\n            ));\n        }\n        report_versions.insert(report_version);\n\n        let channel = channel_of(scenario).ok_or_else(|| {\n            format!(\"scenario '{scenario}' has no declared output channel — refusing to aggregate\")\n        })?;\n\n        let model = row.get(\"model\").and_then(serde_json::Value::as_str);\n        match model {\n            Some(_) => {\n                coverage.trials += 1;\n                bump_status(&mut coverage, status)?;\n            }\n            None => coverage.non_tier2 += 1,\n        }\n\n        for check in checks {\n            let name = check\n                .get(\"name\")\n                .and_then(serde_json::Value::as_str)\n                .ok_or(\"check row lacks a `name` field\")?;\n            let passed = check\n                .get(\"passed\")\n                .and_then(serde_json::Value::as_bool)\n                .ok_or(\"check row lacks a `passed` field\")?;\n            if passed {\n                coverage.checks_passed += 1;\n                continue;\n            }\n            coverage.checks_failed += 1;\n            match check.get(\"code\").and_then(serde_json::Value::as_str) {\n                Some(code) => {\n                    let key = FaultKey::Agent {\n                        channel: channel.to_owned(),\n                        code: code.to_owned(),\n                    };\n                    tally(\n                        &mut routings,\n                        &mut matrix_cells,\n                        &key,\n                        scenario,\n                        model,\n                        name,\n                    );\n                }\n                None => {\n                    let key = FaultKey::Tool {\n                        tool: tool.to_owned(),\n                        check: name.to_owned(),\n                        channel: channel.to_owned(),\n                    };\n                    tally(\n                        &mut routings,\n                        &mut matrix_cells,\n                        &key,\n                        scenario,\n                        model,\n                        name,\n                    );\n                }\n            }\n        }\n\n        // A trial-level `invalid_output` carries the agent fault\n        // `ERR_ACTION_FORMAT_VIOLATION` (report contract) — it is a\n        // fault occurrence in the scenario's channel, matrix-visible.\n        // The mapping is fixed by the contract, so an explicit\n        // `fault_code` field is honored when present and the contract\n        // default applies otherwise (tier-1 rows may omit it).\n        if status == \"invalid_output\" {\n            let code = row\n                .get(\"fault_code\")\n                .and_then(serde_json::Value::as_str)\n                .unwrap_or(\"ERR_ACTION_FORMAT_VIOLATION\");\n            let key = FaultKey::Agent {\n                channel: channel.to_owned(),\n                code: code.to_owned(),\n            };\n            tally(&mut routings, &mut matrix_cells, &key, scenario, model, \"\");\n        }\n    }\n\n    let matrix: Vec<serde_json::Value> = matrix_cells\n        .iter()\n        .map(|((channel, code, model), tally)| {\n            json!({\n                \"channel\": channel,\n                \"code\": code,\n                \"model\": model,\n                \"occurrences\": tally.occurrences,\n                \"scenarios\": tally.scenarios.iter().collect::<Vec<_>>(),\n            })\n        })\n        .collect();\n\n    let routing: Vec<serde_json::Value> = routings\n        .iter()\n        .map(|(key, tally)| {\n            let distinct_models = tally.models.len();\n            match key {\n                FaultKey::Agent { channel, code } => {\n                    // Cross-model threshold: 3 distinct ids for the\n                    // channel — or all configured ids when fewer than\n                    // three are configured. Below the threshold the\n                    // finding is recorded without action.\n                    let kind = if distinct_models >= routing_threshold {\n                        \"aix-channel\"\n                    } else {\n                        \"recorded-no-action\"\n                    };\n                    json!({\n                        \"kind\": kind,\n                        \"channel\": channel,\n                        \"code\": code,\n                        \"distinct_models\": distinct_models,\n                        \"occurrences\": tally.occurrences,\n                        \"scenarios\": tally.scenarios.iter().collect::<Vec<_>>(),\n                    })\n                }\n                FaultKey::Tool {\n                    tool,\n                    check,\n                    channel,\n                } => {\n                    // Tool faults are filed as tickets in the tool's\n                    // repository, never routed as AIX-channel work,\n                    // and carry no code by contract.\n                    json!({\n                        \"kind\": \"tool-ticket\",\n                        \"tool\": tool,\n                        \"check\": check,\n                        \"channel\": channel,\n                        \"distinct_models\": distinct_models,\n                        \"occurrences\": tally.occurrences,\n                        \"scenarios\": tally.scenarios.iter().collect::<Vec<_>>(),\n                    })\n                }\n            }\n        })\n        .collect();\n\n    Ok(json!({\n        \"dashboard_version\": DASHBOARD_VERSION,\n        \"report_version\": report_versions.iter().next().copied().unwrap_or(1),\n        \"configured_models\": configured_models,\n        \"routing_threshold\": routing_threshold,\n        \"matrix\": matrix,\n        \"routing\": routing,\n        \"coverage\": coverage_json(&coverage),\n    }))\n}\n\n/// Increment a check-row fault into the routing tally and, when the\n/// row carries model attribution, into the tier-2 matrix cell.\nfn tally(\n    routings: &mut BTreeMap<FaultKey, FaultTally>,\n    matrix_cells: &mut BTreeMap<(String, String, String), FaultTally>,\n    key: &FaultKey,\n    scenario: &str,\n\n[75 more lines in file. Use offset=401 to continue.]"}],"isError":false,"timestamp":1792528025246},{"role":"assistant","content":[{"type":"toolCall","id":"9bfV1om7k","name":"read","arguments":{"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/main.rs","offset":201,"limit":200}}],"api":"openai-completions","provider":"openrouter","model":"mistralai/mistral-small-3.2-24b-instruct","usage":{"input":54657,"output":45,"cacheRead":0,"cacheWrite":0,"reasoning":0,"totalTokens":54702,"cost":{"input":0.0040992749999999994,"output":0.000009,"cacheRead":0,"cacheWrite":0,"total":0.004108275}},"stopReason":"toolUse","timestamp":1792528025247,"responseId":"gen-1792528025-YZ5hwpGILZ3LvulzkwZm","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"9bfV1om7k","toolName":"read","content":[{"type":"text","text":"            &scenario,\n            reps,\n            model,\n            dry_run,\n            real_artifacts,\n            budget_mins,\n            &out,\n        ) {\n            Ok(code) => code,\n            Err(msg) => {\n                eprintln!(\"{msg}\");\n                ExitCode::FAILURE\n            }\n        },\n    }\n}\n\n/// Tier-2 live rotation: the scenario battery (or one named scenario)\n/// × selected models × reps, in registry order, under a per-run\n/// wall-clock budget. One JSON event per cell on stdout — a\n/// report_version 1 trial row or an absent record. Exit nonzero iff a\n/// trial failed or malformed; rate-limited and budget-skipped cells are\n/// recorded in their rows, they are not failures (the row is the\n/// record).\nfn run_live(\n    scenario: Option<String>,\n    reps: u32,\n    model: Option<String>,\n    budget_mins: u64,\n) -> Result<ExitCode, String> {\n    let scenarios: Vec<_> = match scenario {\n        Some(name) => vec![live_scenario_by_name(&name)?],\n        None => live_scenarios(),\n    };\n    let models: Vec<String> = match model {\n        Some(id) => vec![id],\n        None => ordered_ids().into_iter().map(String::from).collect(),\n    };\n    let start = Instant::now();\n    let budget = Duration::from_secs(budget_mins * 60);\n    let mut factory = |m: &str| {\n        OpenRouterTransport::from_env(m)\n            .map(|t| Box::new(t) as Box<dyn evallerina::live::Transport>)\n    };\n    let events = run_rotation(\n        &scenarios,\n        &models,\n        reps,\n        &mut factory,\n        &evallerina::live::Bounds::default(),\n        &|| start.elapsed() < budget,\n    )?;\n    let mut trial_failed = false;\n    for event in &events {\n        if let RotationEvent::Trial { report } = event {\n            trial_failed |= matches!(\n                report.status,\n                TrialStatus::Failed | TrialStatus::InvalidOutput\n            );\n        }\n        println!(\"{}\", serde_json::to_string(event).unwrap());\n    }\n    if trial_failed {\n        Ok(ExitCode::FAILURE)\n    } else {\n        Ok(ExitCode::SUCCESS)\n    }\n}\n\n/// Tier-0 routing-map parity gate (evallerina-0sy): read the checked-in\n/// routing.toml and the ddl sibling README relative to the repo root\n/// (discovered worktree-safe), run\n/// [`evallerina::routing_parity::routing_parity`], and print the parity\n/// report as JSON. Exit nonzero\n/// iff any parity row failed (`ERR_ROUTING_PARITY` rows carry tool +\n/// detail); an absent ddl sibling degrades to a warning row with exit\n/// 0 — parse failures stay loud and nonzero.\nfn run_routing_parity() -> Result<ExitCode, String> {\n    let root = evallerina::routing::discover_root()?;\n    let root_path = std::path::PathBuf::from(&root);\n    let toml_path = root_path.join(\"routing.toml\");\n    let toml = std::fs::read_to_string(&toml_path)\n        .map_err(|e| format!(\"cannot read {}: {e}\", toml_path.display()))?;\n    let readme_path = root_path.join(evallerina::routing_parity::DDL_README);\n    let readme = std::fs::read_to_string(&readme_path).ok();\n    let report = evallerina::routing_parity::routing_parity(readme.as_deref(), &toml, &root_path)?;\n    println!(\n        \"{}\",\n        serde_json::to_string_pretty(&report.to_json()).expect(\"parity report serializes\")\n    );\n    if report.failed() {\n        Ok(ExitCode::FAILURE)\n    } else {\n        Ok(ExitCode::SUCCESS)\n    }\n}\n\n/// Tier-0 doc-coverage audit CLI handler (evallerina-fok): load the\n/// checked-in doc_audit.toml from the repo root, run the surface step\n/// per tool (binary probe, or `skip`/`binary_absent` provenance —\n/// never a silent skip), scan each tool's local repo surfaces into a\n/// doc inventory, and diff the two into per-token audit rows that also\n/// flow into the report contract as report_version 1 rows. Findings\n/// are the record, not gate failures (the dashboard is the record);\n/// nonzero exit is reserved for loud errors: missing/malformed config,\n/// unreadable surfaces.\nfn run_doc_audit() -> Result<ExitCode, String> {\n    let root = evallerina::routing::discover_root()?;\n    let root_path = std::path::PathBuf::from(&root);\n    let config_path = root_path.join(\"doc_audit.toml\");\n    let config_src = std::fs::read_to_string(&config_path)\n        .map_err(|e| format!(\"cannot read {}: {e}\", config_path.display()))?;\n    let configs = evallerina::doc_audit::parse_config(&config_src)?;\n\n    let mut provenance = Vec::new();\n    let mut tools = serde_json::Map::new();\n    let mut report_rows = Vec::new();\n    let mut audit_rows_all = Vec::new();\n    for config in &configs {\n        let prov = evallerina::doc_audit::audit_tool_surface(config)?;\n        let mut tool_json = serde_json::json!({\n            \"surface_status\": prov.status,\n            \"surface_tokens\": prov.tokens.len(),\n            \"audit_rows\": 0,\n        });\n        if !prov.tokens.is_empty() {\n            // Only tools with a harvested surface can produce audit\n            // rows; the repo must be a local checkout to scan.\n            let repo = evallerina::routing::resolve_repo(&config.repo, &root_path);\n            let repo_path = std::path::PathBuf::from(&repo);\n            if repo_path.is_dir() {\n                let inv = evallerina::doc_audit::scan_inventory(&repo_path)?;\n                let rows = evallerina::doc_audit::audit(&prov.tokens, &inv);\n                tool_json[\"surfaces\"] = serde_json::json!(inv.surfaces.len());\n                tool_json[\"audit_rows\"] = serde_json::json!(rows.len());\n                audit_rows_all.extend(rows.iter().map(\n                    |r| serde_json::json!({\"tool\": config.tool, \"token\": r.token, \"code\": r.code}),\n                ));\n                if !rows.is_empty() {\n                    report_rows.push(evallerina::doc_audit::report_row(&config.tool, &rows));\n                }\n            } else {\n                provenance.push(serde_json::json!({\n                    \"tool\": config.tool,\n                    \"status\": \"repo_absent\",\n                    \"detail\": format!(\"repo checkout '{repo}' not found — inventory not scanned\"),\n                }));\n                tool_json[\"surfaces\"] = serde_json::json!(0);\n            }\n        }\n        provenance.push(serde_json::json!({\n            \"tool\": prov.tool,\n            \"status\": prov.status,\n            \"detail\": prov.detail,\n        }));\n        tools.insert(config.tool.clone(), tool_json);\n    }\n\n    println!(\n        \"{}\",\n        serde_json::to_string_pretty(&serde_json::json!({\n            \"inventory\": tools,\n            \"provenance\": provenance,\n            \"audit_rows\": audit_rows_all,\n            \"report_rows\": report_rows,\n        }))\n        .expect(\"doc-audit report serializes\")\n    );\n    Ok(ExitCode::SUCCESS)\n}\n\n/// Aggregate a JSONL file of report rows into the fault dashboard.\n/// The configured model registry comes from the checked-in registry;\n/// the channel map from the live scenario registry. Findings do not\n/// affect the exit code — the dashboard is the record, and nonzero\n/// exits are reserved for aggregation errors.\nfn run_report(path: &str, route: bool, file: bool) -> Result<ExitCode, String> {\n    evallerina::report::validate_route_flags(route, file)?;\n    let content = std::fs::read_to_string(path)\n        .map_err(|e| format!(\"cannot read report rows from {path}: {e}\"))?;\n    let rows: Vec<serde_json::Value> = content\n        .lines()\n        .filter(|line| !line.trim().is_empty())\n        .map(|line| serde_json::from_str(line).map_err(|e| format!(\"malformed report row: {e}\")))\n        .collect::<Result<Vec<_>, String>>()?;\n    let configured: Vec<String> = ordered_ids().into_iter().map(String::from).collect();\n    let mut dashboard = evallerina::report::aggregate_rows(\n        &rows,\n        &configured,\n        &evallerina::report::scenario_channel,\n    )?;\n    if route {\n        let mut runner = evallerina::routing::run_bd;\n        evallerina::report::run_routing_step(\n            &mut dashboard,\n            &rows,\n            &configured,\n            std::path::Path::new(path),\n            file,\n            &mut runner,\n\n[114 more lines in file. Use offset=401 to continue.]"}],"isError":false,"timestamp":1792528035000},{"role":"assistant","content":[{"type":"toolCall","id":"C3MnzkK7u","name":"read","arguments":{"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/doc_audit.rs","offset":401,"limit":200}}],"api":"openai-completions","provider":"openrouter","model":"mistralai/mistral-small-3.2-24b-instruct","usage":{"input":56752,"output":47,"cacheRead":0,"cacheWrite":0,"reasoning":0,"totalTokens":56799,"cost":{"input":0.0042564,"output":0.000009400000000000001,"cacheRead":0,"cacheWrite":0,"total":0.004265799999999999}},"stopReason":"toolUse","timestamp":1792528035002,"responseId":"gen-1792528035-z6A7Wv41YG7AA56ycrdn","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"C3MnzkK7u","toolName":"read","content":[{"type":"text","text":"            }\n            continue;\n        }\n        // Exit-code section: `Exit codes:` / `Exit status:` header,\n        // then indented `N  description` lines. Each documented code\n        // becomes the token `exitN`.\n        let lower = trimmed.to_lowercase();\n        if lower.starts_with(\"exit codes:\") || lower.starts_with(\"exit status:\") {\n            in_exit = true;\n            // Same-line codes (`Exit codes: 0, 2`) are harvested too.\n            harvest_exit_words(trimmed, &mut tokens);\n            continue;\n        }\n        if in_exit {\n            if trimmed.is_empty() || !line.starts_with(char::is_whitespace) {\n                in_exit = false;\n            } else {\n                harvest_exit_words(trimmed, &mut tokens);\n            }\n            continue;\n        }\n        // Inline exit-code mention: `Exits with code 2 on bad input`.\n        if let Some(idx) = lower\n            .find(\"exit code\")\n            .or_else(|| lower.find(\"exit status\"))\n        {\n            let after = &trimmed[idx + \"exit code\".len()..];\n            if let Some(code) = after\n                .trim_start_matches(|c: char| !c.is_ascii_digit())\n                .split(|c: char| !c.is_ascii_digit())\n                .next()\n                .and_then(|first| first.parse::<u32>().ok())\n            {\n                tokens.insert(format!(\"exit{code}\"));\n            }\n        }\n    }\n    tokens\n}\n\n/// Harvest leading integer exit codes from one exit-section line\n/// (`  0  success` → `exit0`); description words are not tokens.\nfn harvest_exit_words(line: &str, tokens: &mut BTreeSet<String>) {\n    let digits: String = line.chars().take_while(|c| c.is_ascii_digit()).collect();\n    if let Ok(code) = digits.parse::<u32>() {\n        tokens.insert(format!(\"exit{code}\"));\n    }\n}\n"}],"isError":false,"timestamp":1792528040664},{"role":"assistant","content":[{"type":"toolCall","id":"F6jDNko7w","name":"read","arguments":{"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/report.rs","offset":401,"limit":200}}],"api":"openai-completions","provider":"openrouter","model":"mistralai/mistral-small-3.2-24b-instruct","usage":{"input":57247,"output":46,"cacheRead":0,"cacheWrite":0,"reasoning":0,"totalTokens":57293,"cost":{"input":0.004293524999999999,"output":0.0000092,"cacheRead":0,"cacheWrite":0,"total":0.004302724999999999}},"stopReason":"toolUse","timestamp":1792528040665,"responseId":"gen-1792528040-5CKxZDUltOhkGEzJLccE","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"F6jDNko7w","toolName":"read","content":[{"type":"text","text":"    model: Option<&str>,\n    check: &str,\n) {\n    let entry = routings.entry(key.clone()).or_default();\n    entry.occurrences += 1;\n    entry.scenarios.insert(scenario.to_owned());\n    if let Some(model) = model {\n        entry.models.insert(model.to_owned());\n        let code = match key {\n            FaultKey::Agent { code, .. } => code.clone(),\n            // Tool faults carry no code; the matrix dimension uses the\n            // check name so tool rows stay visible per capability.\n            FaultKey::Tool { .. } => check.to_owned(),\n        };\n        let cell = matrix_cells\n            .entry((\n                match key {\n                    FaultKey::Agent { channel, .. } | FaultKey::Tool { channel, .. } => {\n                        channel.clone()\n                    }\n                },\n                code,\n                model.to_owned(),\n            ))\n            .or_default();\n        cell.occurrences += 1;\n        cell.scenarios.insert(scenario.to_owned());\n    }\n}\n\n/// Per-trial outcome status counts. Unknown statuses are a loud error:\n/// a silently-substituted status would corrupt the coverage record.\nfn bump_status(coverage: &mut Coverage, status: &str) -> Result<(), String> {\n    match status {\n        \"passed\" => coverage.passed += 1,\n        \"failed\" => coverage.failed += 1,\n        \"rate_limited\" => coverage.rate_limited += 1,\n        \"http_error\" => coverage.http_error += 1,\n        \"invalid_output\" => coverage.invalid_output += 1,\n        other => return Err(format!(\"unknown trial status '{other}'\")),\n    }\n    Ok(())\n}\n\n/// Coverage counters (the anti-goal record: absent and rate_limited\n/// cells are surfaced, never dropped, never failures).\n#[derive(Debug, Default)]\nstruct Coverage {\n    trials: usize,\n    passed: usize,\n    failed: usize,\n    rate_limited: usize,\n    http_error: usize,\n    invalid_output: usize,\n    absent: usize,\n    non_tier2: usize,\n    checks_passed: usize,\n    checks_failed: usize,\n}\n\nfn coverage_json(coverage: &Coverage) -> serde_json::Value {\n    json!({\n        \"trials\": coverage.trials,\n        \"passed\": coverage.passed,\n        \"failed\": coverage.failed,\n        \"rate_limited\": coverage.rate_limited,\n        \"http_error\": coverage.http_error,\n        \"invalid_output\": coverage.invalid_output,\n        \"absent\": coverage.absent,\n        \"non_tier2\": coverage.non_tier2,\n        \"checks_passed\": coverage.checks_passed,\n        \"checks_failed\": coverage.checks_failed,\n    })\n}\n"}],"isError":false,"timestamp":1792528044918},{"role":"assistant","content":[{"type":"toolCall","id":"i3vh0TcbZ","name":"read","arguments":{"path":"/var/home/sasha/para/areas/dev/gh/charly/evallerina/src/main.rs","offset":401,"limit":200}}],"api":"openai-completions","provider":"openrouter","model":"mistralai/mistral-small-3.2-24b-instruct","usage":{"input":57912,"output":45,"cacheRead":0,"cacheWrite":0,"reasoning":0,"totalTokens":57957,"cost":{"input":0.0043434,"output":0.000009,"cacheRead":0,"cacheWrite":0,"total":0.0043524}},"stopReason":"toolUse","timestamp":1792528044920,"responseId":"gen-1792528045-9GHwMXD1hpMuf5DTQXj3","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"i3vh0TcbZ","toolName":"read","content":[{"type":"text","text":"        )?;\n    }\n    println!(\n        \"{}\",\n        serde_json::to_string_pretty(&dashboard).expect(\"dashboard serializes\")\n    );\n    Ok(ExitCode::SUCCESS)\n}\n\n/// A/B ablation CLI handler (evallerina-wdx): resolve the named\n/// scenario and model list, run both arms via\n/// [`evallerina::ablation::run_ablation`], write the ArmReport JSONL\n/// rows (full arm first, then ablated, in run order), and print the\n/// per-arm summary + delta as JSON on stdout. Measurement, not a gate:\n/// the exit code is success whenever the ablation ran; errors — unknown\n/// scenario, artifact-path collision, generation failure, unwritable\n/// output — are loud and nonzero, never silent.\nfn run_ablate(\n    scenario: &str,\n    reps: u32,\n    model: Option<String>,\n    dry_run: bool,\n    real_artifacts: bool,\n    budget_mins: u64,\n    out: &str,\n) -> Result<ExitCode, String> {\n    let scenario = evallerina::scenario::live_scenario_by_name(scenario)?;\n    let models: Vec<String> = match model {\n        Some(id) => vec![id],\n        None => ordered_ids().into_iter().map(String::from).collect(),\n    };\n    let artifacts: AixSource<'static> = if real_artifacts {\n        let wai = ToolBinaries::discover_wai().ok_or_else(|| {\n            \"real artifact generation requested but no `wai` binary is on PATH — refusing to fake it\"\n                .to_owned()\n        })?;\n        AixSource::Real(ToolBinaries { wai })\n    } else {\n        AixSource::Static(&DEFAULT_AIX_ARTIFACTS)\n    };\n    // Dry-run: transports are constructed but never called — the zero\n    // budget records every cell absent before any trial starts. No\n    // key required, no network. Non-dry-run: the real tier-2\n    // transport, which refuses to start without OPENROUTER_API_KEY.\n    let report = if dry_run {\n        let mut full_factory = |m: &str| {\n            Ok(Box::new(OpenRouterTransport::new(m, \"dry-run-no-network\"))\n                as Box<dyn evallerina::live::Transport>)\n        };\n        let mut ablated_factory = |m: &str| {\n            Ok(Box::new(OpenRouterTransport::new(m, \"dry-run-no-network\"))\n                as Box<dyn evallerina::live::Transport>)\n        };\n        run_ablation(\n            &scenario,\n            &models,\n            reps,\n            artifacts,\n            AblationFactories {\n                full: &mut full_factory,\n                ablated: &mut ablated_factory,\n            },\n            &evallerina::live::Bounds::default(),\n            &|| false,\n        )\n    } else {\n        let start = Instant::now();\n        let budget = Duration::from_secs(budget_mins * 60);\n        let mut full_factory = |m: &str| {\n            OpenRouterTransport::from_env(m)\n                .map(|t| Box::new(t) as Box<dyn evallerina::live::Transport>)\n        };\n        let mut ablated_factory = |m: &str| {\n            OpenRouterTransport::from_env(m)\n                .map(|t| Box::new(t) as Box<dyn evallerina::live::Transport>)\n        };\n        run_ablation(\n            &scenario,\n            &models,\n            reps,\n            artifacts,\n            AblationFactories {\n                full: &mut full_factory,\n                ablated: &mut ablated_factory,\n            },\n            &evallerina::live::Bounds::default(),\n            &|| start.elapsed() < budget,\n        )\n    }?;\n\n    let mut rows = std::fs::File::create(out)\n        .map_err(|e| format!(\"cannot write report rows to {out}: {e}\"))?;\n    for event in report.full_rows.iter().chain(&report.ablated_rows) {\n        writeln!(\n            rows,\n            \"{}\",\n            serde_json::to_string(event).expect(\"row serializes\")\n        )\n        .map_err(|e| format!(\"cannot write report rows to {out}: {e}\"))?;\n    }\n    let summary = serde_json::json!({\n        \"ablation_version\": report.ablation_version,\n        \"scenario\": report.scenario,\n        \"full\": report.full,\n        \"ablated\": report.ablated,\n        \"delta\": report.delta,\n    });\n    println!(\n        \"{}\",\n        serde_json::to_string_pretty(&summary).expect(\"summary serializes\")\n    );\n    Ok(ExitCode::SUCCESS)\n}\n"}],"isError":false,"timestamp":1792528051551},{"role":"assistant","content":[{"type":"toolCall","id":"gMNPdaONj","name":"read","arguments":{"function":"bash","parameters":{"command":"git log --oneline --grep=evallerina-fok --","timeout":null}}}],"api":"openai-completions","provider":"openrouter","model":"mistralai/mistral-small-3.2-24b-instruct","usage":{"input":59011,"output":37,"cacheRead":0,"cacheWrite":0,"reasoning":0,"totalTokens":59048,"cost":{"input":0.0044258249999999996,"output":0.0000074,"cacheRead":0,"cacheWrite":0,"total":0.004433225}},"stopReason":"toolUse","timestamp":1792528051553,"responseId":"gen-1792528051-an6RVBabIhM4rFM0UDLo","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"gMNPdaONj","toolName":"read","content":[{"type":"text","text":"Validation failed for tool \"read\":\n  - path: must have required properties path\n\nReceived arguments:\n{\n  \"function\": \"bash\",\n  \"parameters\": {\n    \"command\": \"git log --oneline --grep=evallerina-fok --\",\n    \"timeout\": nul