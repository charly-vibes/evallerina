g) => {\n                eprintln!(\"{msg}\");\n                ExitCode::FAILURE\n            }\n        },\n        Command::Report { path, route, file } => match run_report(&path, route, file) {\n            Ok(code) => code,\n            Err(msg) => {\n                eprintln!(\"{msg}\");\n                ExitCode::FAILURE\n            }\n        },\n        Command::DocAudit => match run_doc_audit() {\n            Ok(code) => code,\n            Err(e) => {\n                eprintln!(\"doc-audit: {e}\");\n                ExitCode::FAILURE\n            }\n        },\n        Command::RoutingParity => match run_routing_parity() {\n            Ok(code) => code,\n            Err(msg) => {\n                eprintln!(\"{msg}\");\n                ExitCode::FAILURE\n            }\n        },\n        Command::Ablate {\n            scenario,\n            reps,\n            model,\n            dry_run,\n            real_artifacts,\n            budget_mins,\n            out,\n        } => match run_ablate(\n\n[314 more lines in file. Use offset=201 to continue.]"}],"isError":false,"timestamp":1792527960413}}
