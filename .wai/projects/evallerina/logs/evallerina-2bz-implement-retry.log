t model attribution, absent records).\n/// `configured_models` is the model registry the rotation was configured\n/// with — it defines the routing threshold (min(3, registry size));\n/// empty is a loud error, no routing threshold exists. `scenario_tool_of`\n/// resolves a scenario to the tool its *definition* recorded (proposals\n/// key the repo on this, never on the row's tool field); an unknown\n/// scenario is a loud error. `repo_map` maps tool name → repo path (the\n/// parsed routing.toml); a mapped-but-unregistered tool surfaces as\n/// `skipped`/`unmapped_tool`, never a silent drop.\npub fn propose(\n    rows: &[serde_json::Value],\n    configured_models: &[String],\n    scenario_tool_of: &dyn Fn(&str) -> Option<String>,\n    repo_map: &BTreeMap<String, String>,\n) -> Result<Vec<ProposalRow>, String> {\n    if configured_models.is_empty() {\n        return Err(\"configured model registry is empty — no routing threshold exists\".into());\n    }\n    let routing_threshold = configured_models.len().min(ROUTING_THRESHOLD);\n\n    // Fault key (scenario, fault-class, tool-from-scenario) →\n    // distinct models + occurrences + provenance rows.\n    let mut faults: BTreeMap<FaultKey, FaultTally> = BTreeMap::new();\n\n    for row in rows {\n        let kind = row.get(\"kind\").and_then(serde_json::Value::as_str);\n        if kind == Some(\"absent\") {\n            // Absent cells are the record that a cell did not run;\n            // never failures, never dropped (anti-goal — mirrored\n            // from report.rs).\n            continue;\n        }\n        let scenario = row\n            .get(\"scenario\")\n            .and_then(serde_json::Value::as_str)\n            .ok_or(\"report row lacks a `scenario` field\")?;\n        let row_tool = row\n            .get(\"tool\")\n            .and_then(serde_json::Value::as_str)\n            .ok_or(\"report row lacks a `tool` field\")?;\n        let report_version = row\n            .get(\"report_version\")\n            .and_then(serde_json::Value::as_u64)\n            .ok_or(\"report row lacks a `report_version` field\")?;\n        if report_version != 1 {\n            return Err(format!(\n                \"report row carries report_version {report_version}; routing aggregates version 1 only\"\n            ));\n        }\n        // The repo keys on the scenario definition's recorded tool,\n        // not the row's tool field (hardcoded in live rows; the hhs\n        // bug showed attribution drifts). Unknown scenario → loud.\n        let recorded_tool = scenario_tool_of(scenario).ok_or_else(|| {\n            format!(\"scenario '{scenario}' has no recorded tool — refusing to route\")\n        })?;\n        let checks = row\n            .get(\"checks\")\n            .and_then(serde_json::Value::as_array)\n            .ok_or(\"report row lacks a `checks` array\")?;\n\n        let model = row.get(\"model\").and_then(serde_json::Value::as_str);\n        for check in checks {\n            // Validated for loudness even though routing keys on the\n            // scenario, not the check name (report.rs keys the matrix\n            // on it; routing's ticket granularity is the scenario).\n            let _name = check\n                .get(\"name\")\n                .and_then(serde_json::Value::as_str)\n                .ok_or(\"check row lacks a `name` field\")?;\n            let passed = check\n                .get(\"passed\")\n                .and_then(serde_json::Value::as_bool)\n                .ok_or(\"check row lacks a `passed` field\")?;\n            if passed {\n                continue;\n            }\n            match check.get(\"code\").and_then(serde_json::Value::as_str) {\n                // Agent faults are never routed (fault taxonomy: they\n                // inform AIX-channel work in genesis — a human decision).\n                Some(code) if code.starts_with(\"ERR_\") => continue,\n                // Tool fault: no code by contract (report.rs FaultKey::Tool).\n                _ => {\n                    let key = FaultKey {\n                        scenario: scenario.to_owned(),\n                        fault_class: \"tool_fault\".to_owned(),\n                        tool: recorded_tool.to_owned(),\n                    };\n                    let entry = faults.entry(key).or_default();\n                    entry.occurrences += 1;\n                    if let Some(model) = model {\n                        entry.models.insert((model.to_owned(), row_tool.to_owned()));\n                    }\n                }\n            }\n        }\n    }\n\n    Ok(faults\n        .into_iter()\n        .filter(|(_, tally)| tally.models.len() >= routing_threshold)\n        .map(|(key, tally)| {\n            let repo = repo_map.get(&key.tool).cloned();\n            let (decision, reason) = match repo {\n                Some(_) => (\"dry_run\".to_owned(), None),\n                None => (\"skipped\".to_owned(), Some(\"unmapped_tool\".to_owned())),\n            };\n            ProposalRow {\n                token: format!(\"evallerina:{}:{}\", key.scenario, key.fault_class),\n                scenario: key.scenario.clone(),\n                fault_class: key.fault_class.clone(),\n                tool: key.tool,\n                repo,\n                decision,\n                reason,\n                bd_issue_id: None,\n                row_provenance: tally\n                    .models\n                    .into_iter()\n                    .map(|(model, tool)| ProvenanceRow {\n                        scenario: key.scenario.clone(),\n                        model,\n                        tool,\n                    })\n                    .collect(),\n            }\n        })\n        .collect())\n}\n\n/// Internal fault key: (scenario, fault-class, scenario-recorded tool).\n#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]\nstruct FaultKey {\n    scenario: String,\n    fault_class: String,\n    tool: String,\n}\n\n/// Accumulated occurrences for one fault key: distinct\n/// (model, row-tool) pairs + total count. Distinct models drive the\n/// threshold; the row tool rides along as provenance.\n#[derive(Debug, Default)]\nstruct FaultTally {\n    occurrences: usize,\n    models: BTreeSet<(String, String)>,\n}\n\nuse std::collections::BTreeSet;\n\n/// Parse routing.toml content into the tool → repo map. Structure is\n/// deliberately minimal: `[<tool>]` tables with a `repo` string.\npub fn parse_routing_toml(content: &str) -> Result<BTreeMap<String, String>, String> {\n    let value: toml::Value =\n        toml::from_str(content).map_err(|e| format!(\"routing.toml parse error: {e}\"))?;\n    let mut map = BTreeMap::new();\n    let table = value\n        .as_table()\n        .ok_or(\"routing.toml must be a table of [tool] sections\")?;\n    for (tool, item) in table {\n        let repo = item\n            .get(\"repo\")\n            .and_then(toml::Value::as_str)\n            .ok_or_else(|| format!(\"routing.toml [{tool}] lacks a `repo` string\"))?;\n        map.insert(tool.clone(), repo.to_owned());\n    }\n    Ok(map)\n}\n\n/// Resolve a mapped repo path: absolute paths pass through untouched\n/// (target-repo worktrees); relative paths resolve against the\n/// evallerina repo root (via `git rev-parse --show-toplevel`, so they\n/// survive worktree checkouts of evallerina itself).\npub fn resolve_repo(repo: &str, evallerina_root: &std::path::Path) -> String {\n    let path = std::path::Path::new(repo);\n    if path.is_absolute() {\n        return repo.to_owned();\n    }\n    evallerina_root.join(repo).to_string_lossy().into_owned()\n}\n\n/// Serialize proposals to the proposed-tickets.jsonl artifact: one JSON\n/// object per line, machine-checkable, reviewable without reading code.\npub fn to_jsonl(proposals: &[ProposalRow]) -> String {\n    let mut out = String::new();\n    for p in proposals {\n        out.push_str(&p.to_json().to_string());\n        out.push('\\n');\n    }\n    out\n}\n\n/// Discover the evallerina repo root (worktree-safe) for relative\n/// routing.toml path resolution.\npub fn discover_root() -> Result<String, String> {\n    let out = std::process::Command::new(\"git\")\n        .args([\"rev-parse\", \"--show-toplevel\"])\n        .output()\n        .map_err(|e| format!(\"cannot run git for repo root: {e}\"))?;\n    if !out.status.success() {\n        return Err(format!(\n            \"git rev-parse --show-toplevel failed: {}\",\n            String::from_utf8_lossy(&out.stderr)\n        ));\n    }\n    Ok(String::from_utf8_lossy(&out.stdout).trim().to_owned())\n}\n\n[1 more lines in file. Use offset=293 to continue.]"}],"isError":false,"timestamp":1792427396922}}
{"type":"message_start","message":{"role":"toolResult","toolCallId":"call_30abb6dcb58340bd81c1961d","toolName":"read","content":[{"type":"text","text":"//! Purpose: integration tests for the dry-run fault routing module\n//! (evallerina-l8w, openspec add-fault-ticket-routing Phase 1).\n//! Responsibilities: pin the report.rs threshold semantics (min(3,\n//! |configured registry|) distinct models per fault key), agent-fault\n//! exclusion, unmapped-tool skip, scenario-recorded-tool repo keying,\n//! worktree-safe routing.toml path resolution, and the full\n//! proposed-tickets.jsonl row schema.\n//! Rationale: routing proposals are cross-repo actions in potentia —\n//! every decision branch (dry_run / skipped) and every schema field is\n//! machine-checked here so the CI artifact is reviewable without\n//! reading code.\n\nuse evallerina::routing;\nuse serde_json::json;\n\n/// A tier-2 trial row with a failing, code-less check (tool fault) for\n/// one model. `row_tool` is the report row's tool field (hardcoded in\n/// live rows); `recorded` is the scenario definition's recorded tool.\nfn trial_row(scenario: &str, row_tool: &str, model: &str) -> serde_json::Value {\n    json!({\n        \"kind\": \"trial\",\n        \"report_version\": 1,\n        \"scenario\": scenario,\n        \"tool\": row_tool,\n        \"model\": model,\n        \"status\": \"failed\",\n        \"checks\": [{\"name\": \"envelope_hint_absent\", \"passed\": false}]\n    })\n}\n\nfn three_models() -> Vec<String> {\n    vec![\"m/a\".into(), \"m/b\".into(), \"m/c\".into()]\n}\n\nfn recorded_wai(scenario: &str) -> Option<String> {\n    (scenario == \"wai-hint-adherence-typo\").then(|| \"wai\".to_owned())\n}\n\nfn repo_map() -> std::collections::BTreeMap<String, String> {\n    [(\"wai\".to_owned(), \"../wai\".to_owned())].into()\n}\n\n#[test]\nfn threshold_tool_fault_becomes_dry_run_proposal() {\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    assert_eq!(proposals.len(), 1, \"one fault key above threshold\");\n    let p = &proposals[0].to_json();\n    assert_eq!(p[\"scenario\"], \"wai-hint-adherence-typo\");\n    assert_eq!(p[\"fault_class\"], \"tool_fault\");\n    assert_eq!(p[\"token\"], \"evallerina:wai-hint-adherence-typo:tool_fault\");\n    assert_eq!(p[\"decision\"], \"dry_run\");\n    assert_eq!(p[\"reason\"], serde_json::Value::Null);\n    assert_eq!(p[\"bd_issue_id\"], serde_json::Value::Null);\n}\n\n#[test]\nfn below_threshold_is_no_proposal() {\n    // (schema via to_json — indexing reads the serialized artifact)\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\"] // 2 distinct < 3\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    assert!(\n        proposals.is_empty(),\n        \"below threshold → recorded, no action\"\n    );\n}\n\n#[test]\nfn agent_faults_are_never_routed() {\n    // Failing checks WITH an ERR_* code are agent faults: they inform\n    // AIX-channel work in genesis (a human decision), never tickets.\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| {\n            let mut r = trial_row(\"wai-hint-adherence-typo\", \"wai\", m);\n            r[\"checks\"] = json!([{\"name\": \"hint_followed\", \"passed\": false,\n                                   \"code\": \"ERR_ENVELOPE_HINT_BLINDNESS\"}]);\n            r\n        })\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    assert!(\n        proposals.is_empty(),\n        \"agent faults must not produce proposals\"\n    );\n}\n\n#[test]\nfn unmapped_tool_is_skipped_not_fatal() {\n    // Above threshold, but routing.toml has no [wai] entry here.\n    let empty_map = std::collections::BTreeMap::new();\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &empty_map)\n        .expect(\"routing must not fail on an unmapped tool\");\n    assert_eq!(proposals.len(), 1, \"skipped is still recorded, not dropped\");\n    let p = &proposals[0].to_json();\n    assert_eq!(p[\"decision\"], \"skipped\");\n    assert_eq!(p[\"reason\"], \"unmapped_tool\");\n    assert_eq!(p[\"repo\"], serde_json::Value::Null);\n}\n\n#[test]\nfn repo_keys_on_recorded_tool_not_row_tool() {\n    // Live rows hardcode tool: \"wai\" (src/live.rs); a drifted row tool\n    // (the hhs bug class) must never send the ticket to the wrong repo.\n    // routing.toml here maps \"dont\" only — the scenario's recorded tool.\n    let mut drifted_map = std::collections::BTreeMap::new();\n    drifted_map.insert(\"dont\".to_owned(), \"../dont\".to_owned());\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| {\n            // Row tool says \"wai\"; scenario definition recorded \"dont\".\n            trial_row(\"dont-hint-adherence-lifecycle\", \"wai\", m)\n        })\n        .collect();\n    let recorded_dont = |s: &str| (s == \"dont-hint-adherence-lifecycle\").then(|| \"dont\".to_owned());\n    let proposals = routing::propose(&rows, &three_models(), &recorded_dont, &drifted_map)\n        .expect(\"routing succeeds\");\n    assert_eq!(proposals.len(), 1);\n    let p = &proposals[0].to_json();\n    assert_eq!(p[\"tool\"], \"dont\", \"repo keyed on recorded tool\");\n    assert_eq!(p[\"repo\"], \"../dont\");\n    // The drifted row tool survives as provenance only.\n    assert_eq!(p[\"row_provenance\"][0][\"tool\"], \"wai\");\n}\n\n#[test]\nfn routing_toml_parses_tools_to_repos() {\n    let toml_src = \"[wai]\\nrepo = \\\"../wai\\\"\\n\\n[genesis]\\nrepo = \\\"../genesis\\\"\\n\";\n    let map = routing::parse_routing_toml(toml_src).expect(\"parses\");\n    assert_eq!(map.get(\"wai\").map(String::as_str), Some(\"../wai\"));\n    assert_eq!(map.get(\"genesis\").map(String::as_str), Some(\"../genesis\"));\n}\n\n#[test]\nfn routing_toml_missing_repo_is_loud() {\n    let err = routing::parse_routing_toml(\"[wai]\\ndescription = \\\"no repo\\\"\\n\")\n        .expect_err(\"missing repo is a loud error\");\n    assert!(err.contains(\"repo\"));\n}\n\n#[test]\nfn relative_repo_resolves_against_evallerina_root() {\n    let root = std::path::Path::new(\"/worktrees/evallerina\");\n    assert_eq!(\n        routing::resolve_repo(\"../wai\", root),\n        \"/worktrees/evallerina/../wai\"\n    );\n}\n\n#[test]\nfn absolute_repo_passes_through_for_worktrees() {\n    let root = std::path::Path::new(\"/worktrees/evallerina\");\n    assert_eq!(\n        routing::resolve_repo(\"/para/worktrees/wai\", root),\n        \"/para/worktrees/wai\"\n    );\n}\n\n#[test]\nfn every_proposal_row_carries_the_full_schema() {\n    // Mixed bag: one mapped tool fault (dry_run), one unmapped\n    // (skipped/unmapped_tool) — every row must carry ALL schema fields\n    // with null where absent, and the JSONL artifact must be one\n    // machine-checkable JSON object per line.\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .flat_map(|m| {\n            vec![\n                trial_row(\"wai-hint-adherence-typo\", \"wai\", m),\n                trial_row(\"wai-doc-drift-stale-agents-md\", \"wai\", m),\n            ]\n        })\n        .collect();\n    let mut map = std::collections::BTreeMap::new();\n    map.insert(\"wai\".to_owned(), \"../wai\".to_owned());\n    let two_scenarios = |s: &str| {\n        (s == \"wai-hint-adherence-typo\" || s == \"wai-doc-drift-stale-agents-md\")\n            .then(|| \"wai\".to_owned())\n    };\n    let proposals =\n        routing::propose(&rows, &three_models(), &two_scenarios, &map).expect(\"routing succeeds\");\n    assert_eq!(proposals.len(), 2);\n    for p in &proposals {\n        let j = p.to_json();\n        for field in [\n            \"tool\",\n            \"repo\",\n            \"scenario\",\n            \"fault_class\",\n            \"token\",\n            \"decision\",\n            \"reason\",\n            \"bd_issue_id\",\n            \"row_provenance\",\n        ] {\n            assert!(j.get(field).is_some(), \"schema field {field} missing\");\n        }\n        assert_eq!(\n            j[\"bd_issue_id\"],\n            serde_json::Value::Null,\n            \"dry-run files nothing\"\n        );\n        assert_eq!(\n            j[\"reason\"],\n            serde_json::Value::Null,\n            \"dry_run has no reason\"\n        );\n        // row_provenance dedupes by model: 3 entries per proposal.\n        assert_eq!(j[\"row_provenance\"].as_array().map(Vec::len), Some(3));\n        for prov in j[\"row_provenance\"].as_array().unwrap() {\n            for f in [\"scenario\", \"model\", \"tool\"] {\n                assert!(prov.get(f).is_some(), \"provenance field {f} missing\");\n            }\n        }\n    }\n}\n\n#[test]\nfn unknown_scenario_is_a_loud_error() {\n    let rows = vec![trial_row(\"mystery-scenario\", \"wai\", \"m/a\")];\n    let err = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect_err(\"unknown scenario must be loud, never a silent bucket\");\n    assert!(err.contains(\"mystery-scenario\"));\n}\n\n#[test]\nfn jsonl_writer_emits_one_object_per_line() {\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    let jsonl = routing::to_jsonl(&proposals);\n    let lines: Vec<&str> = jsonl.lines().collect();\n    assert_eq!(lines.len(), proposals.len(), \"one object per line\");\n    for line in &lines {\n        let v: serde_json::Value = serde_json::from_str(line).expect(\"each line is a JSON object\");\n        assert!(v.get(\"token\").is_some());\n    }\n}\n\n[1 more lines in file. Use offset=255 to continue.]"}],"isError":false,"timestamp":1792427396922}}
{"type":"message_end","message":{"role":"toolResult","toolCallId":"call_30abb6dcb58340bd81c1961d","toolName":"read","content":[{"type":"text","text":"//! Purpose: integration tests for the dry-run fault routing module\n//! (evallerina-l8w, openspec add-fault-ticket-routing Phase 1).\n//! Responsibilities: pin the report.rs threshold semantics (min(3,\n//! |configured registry|) distinct models per fault key), agent-fault\n//! exclusion, unmapped-tool skip, scenario-recorded-tool repo keying,\n//! worktree-safe routing.toml path resolution, and the full\n//! proposed-tickets.jsonl row schema.\n//! Rationale: routing proposals are cross-repo actions in potentia —\n//! every decision branch (dry_run / skipped) and every schema field is\n//! machine-checked here so the CI artifact is reviewable without\n//! reading code.\n\nuse evallerina::routing;\nuse serde_json::json;\n\n/// A tier-2 trial row with a failing, code-less check (tool fault) for\n/// one model. `row_tool` is the report row's tool field (hardcoded in\n/// live rows); `recorded` is the scenario definition's recorded tool.\nfn trial_row(scenario: &str, row_tool: &str, model: &str) -> serde_json::Value {\n    json!({\n        \"kind\": \"trial\",\n        \"report_version\": 1,\n        \"scenario\": scenario,\n        \"tool\": row_tool,\n        \"model\": model,\n        \"status\": \"failed\",\n        \"checks\": [{\"name\": \"envelope_hint_absent\", \"passed\": false}]\n    })\n}\n\nfn three_models() -> Vec<String> {\n    vec![\"m/a\".into(), \"m/b\".into(), \"m/c\".into()]\n}\n\nfn recorded_wai(scenario: &str) -> Option<String> {\n    (scenario == \"wai-hint-adherence-typo\").then(|| \"wai\".to_owned())\n}\n\nfn repo_map() -> std::collections::BTreeMap<String, String> {\n    [(\"wai\".to_owned(), \"../wai\".to_owned())].into()\n}\n\n#[test]\nfn threshold_tool_fault_becomes_dry_run_proposal() {\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    assert_eq!(proposals.len(), 1, \"one fault key above threshold\");\n    let p = &proposals[0].to_json();\n    assert_eq!(p[\"scenario\"], \"wai-hint-adherence-typo\");\n    assert_eq!(p[\"fault_class\"], \"tool_fault\");\n    assert_eq!(p[\"token\"], \"evallerina:wai-hint-adherence-typo:tool_fault\");\n    assert_eq!(p[\"decision\"], \"dry_run\");\n    assert_eq!(p[\"reason\"], serde_json::Value::Null);\n    assert_eq!(p[\"bd_issue_id\"], serde_json::Value::Null);\n}\n\n#[test]\nfn below_threshold_is_no_proposal() {\n    // (schema via to_json — indexing reads the serialized artifact)\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\"] // 2 distinct < 3\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    assert!(\n        proposals.is_empty(),\n        \"below threshold → recorded, no action\"\n    );\n}\n\n#[test]\nfn agent_faults_are_never_routed() {\n    // Failing checks WITH an ERR_* code are agent faults: they inform\n    // AIX-channel work in genesis (a human decision), never tickets.\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| {\n            let mut r = trial_row(\"wai-hint-adherence-typo\", \"wai\", m);\n            r[\"checks\"] = json!([{\"name\": \"hint_followed\", \"passed\": false,\n                                   \"code\": \"ERR_ENVELOPE_HINT_BLINDNESS\"}]);\n            r\n        })\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    assert!(\n        proposals.is_empty(),\n        \"agent faults must not produce proposals\"\n    );\n}\n\n#[test]\nfn unmapped_tool_is_skipped_not_fatal() {\n    // Above threshold, but routing.toml has no [wai] entry here.\n    let empty_map = std::collections::BTreeMap::new();\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &empty_map)\n        .expect(\"routing must not fail on an unmapped tool\");\n    assert_eq!(proposals.len(), 1, \"skipped is still recorded, not dropped\");\n    let p = &proposals[0].to_json();\n    assert_eq!(p[\"decision\"], \"skipped\");\n    assert_eq!(p[\"reason\"], \"unmapped_tool\");\n    assert_eq!(p[\"repo\"], serde_json::Value::Null);\n}\n\n#[test]\nfn repo_keys_on_recorded_tool_not_row_tool() {\n    // Live rows hardcode tool: \"wai\" (src/live.rs); a drifted row tool\n    // (the hhs bug class) must never send the ticket to the wrong repo.\n    // routing.toml here maps \"dont\" only — the scenario's recorded tool.\n    let mut drifted_map = std::collections::BTreeMap::new();\n    drifted_map.insert(\"dont\".to_owned(), \"../dont\".to_owned());\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| {\n            // Row tool says \"wai\"; scenario definition recorded \"dont\".\n            trial_row(\"dont-hint-adherence-lifecycle\", \"wai\", m)\n        })\n        .collect();\n    let recorded_dont = |s: &str| (s == \"dont-hint-adherence-lifecycle\").then(|| \"dont\".to_owned());\n    let proposals = routing::propose(&rows, &three_models(), &recorded_dont, &drifted_map)\n        .expect(\"routing succeeds\");\n    assert_eq!(proposals.len(), 1);\n    let p = &proposals[0].to_json();\n    assert_eq!(p[\"tool\"], \"dont\", \"repo keyed on recorded tool\");\n    assert_eq!(p[\"repo\"], \"../dont\");\n    // The drifted row tool survives as provenance only.\n    assert_eq!(p[\"row_provenance\"][0][\"tool\"], \"wai\");\n}\n\n#[test]\nfn routing_toml_parses_tools_to_repos() {\n    let toml_src = \"[wai]\\nrepo = \\\"../wai\\\"\\n\\n[genesis]\\nrepo = \\\"../genesis\\\"\\n\";\n    let map = routing::parse_routing_toml(toml_src).expect(\"parses\");\n    assert_eq!(map.get(\"wai\").map(String::as_str), Some(\"../wai\"));\n    assert_eq!(map.get(\"genesis\").map(String::as_str), Some(\"../genesis\"));\n}\n\n#[test]\nfn routing_toml_missing_repo_is_loud() {\n    let err = routing::parse_routing_toml(\"[wai]\\ndescription = \\\"no repo\\\"\\n\")\n        .expect_err(\"missing repo is a loud error\");\n    assert!(err.contains(\"repo\"));\n}\n\n#[test]\nfn relative_repo_resolves_against_evallerina_root() {\n    let root = std::path::Path::new(\"/worktrees/evallerina\");\n    assert_eq!(\n        routing::resolve_repo(\"../wai\", root),\n        \"/worktrees/evallerina/../wai\"\n    );\n}\n\n#[test]\nfn absolute_repo_passes_through_for_worktrees() {\n    let root = std::path::Path::new(\"/worktrees/evallerina\");\n    assert_eq!(\n        routing::resolve_repo(\"/para/worktrees/wai\", root),\n        \"/para/worktrees/wai\"\n    );\n}\n\n#[test]\nfn every_proposal_row_carries_the_full_schema() {\n    // Mixed bag: one mapped tool fault (dry_run), one unmapped\n    // (skipped/unmapped_tool) — every row must carry ALL schema fields\n    // with null where absent, and the JSONL artifact must be one\n    // machine-checkable JSON object per line.\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .flat_map(|m| {\n            vec![\n                trial_row(\"wai-hint-adherence-typo\", \"wai\", m),\n                trial_row(\"wai-doc-drift-stale-agents-md\", \"wai\", m),\n            ]\n        })\n        .collect();\n    let mut map = std::collections::BTreeMap::new();\n    map.insert(\"wai\".to_owned(), \"../wai\".to_owned());\n    let two_scenarios = |s: &str| {\n        (s == \"wai-hint-adherence-typo\" || s == \"wai-doc-drift-stale-agents-md\")\n            .then(|| \"wai\".to_owned())\n    };\n    let proposals =\n        routing::propose(&rows, &three_models(), &two_scenarios, &map).expect(\"routing succeeds\");\n    assert_eq!(proposals.len(), 2);\n    for p in &proposals {\n        let j = p.to_json();\n        for field in [\n            \"tool\",\n            \"repo\",\n            \"scenario\",\n            \"fault_class\",\n            \"token\",\n            \"decision\",\n            \"reason\",\n            \"bd_issue_id\",\n            \"row_provenance\",\n        ] {\n            assert!(j.get(field).is_some(), \"schema field {field} missing\");\n        }\n        assert_eq!(\n            j[\"bd_issue_id\"],\n            serde_json::Value::Null,\n            \"dry-run files nothing\"\n        );\n        assert_eq!(\n            j[\"reason\"],\n            serde_json::Value::Null,\n            \"dry_run has no reason\"\n        );\n        // row_provenance dedupes by model: 3 entries per proposal.\n        assert_eq!(j[\"row_provenance\"].as_array().map(Vec::len), Some(3));\n        for prov in j[\"row_provenance\"].as_array().unwrap() {\n            for f in [\"scenario\", \"model\", \"tool\"] {\n                assert!(prov.get(f).is_some(), \"provenance field {f} missing\");\n            }\n        }\n    }\n}\n\n#[test]\nfn unknown_scenario_is_a_loud_error() {\n    let rows = vec![trial_row(\"mystery-scenario\", \"wai\", \"m/a\")];\n    let err = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect_err(\"unknown scenario must be loud, never a silent bucket\");\n    assert!(err.contains(\"mystery-scenario\"));\n}\n\n#[test]\nfn jsonl_writer_emits_one_object_per_line() {\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    let jsonl = routing::to_jsonl(&proposals);\n    let lines: Vec<&str> = jsonl.lines().collect();\n    assert_eq!(lines.len(), proposals.len(), \"one object per line\");\n    for line in &lines {\n        let v: serde_json::Value = serde_json::from_str(line).expect(\"each line is a JSON object\");\n        assert!(v.get(\"token\").is_some());\n    }\n}\n\n[1 more lines in file. Use offset=255 to continue.]"}],"isError":false,"timestamp":1792427396922}}
{"type":"turn_end","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_bda87bf24ee2422ba3870c7a","name":"read","arguments":{"limit":292,"offset":1,"path":"src/routing.rs"}},{"type":"toolCall","id":"call_30abb6dcb58340bd81c1961d","name":"read","arguments":{"limit":254,"offset":1,"path":"tests/routing.rs"}}],"api":"openai-completions","provider":"openrouter","model":"z-ai/glm-5.3-flash","usage":{"input":868,"output":52,"cacheRead":11008,"cacheWrite":0,"reasoning":1,"totalTokens":11928,"cost":{"input":0.0001302,"output":0.000026,"cacheRead":0.00033024,"cacheWrite":0,"total":0.00048644}},"stopReason":"toolUse","timestamp":1792427394852,"responseId":"gen-1792427394-1UL6bhYVPqskx2GFEMDf","rawStopReason":"tool_calls"},"toolResults":[{"role":"toolResult","toolCallId":"call_bda87bf24ee2422ba3870c7a","toolName":"read","content":[{"type":"text","text":"//! Purpose: Dry-run fault routing — proposals for tool-fault tickets in\n//! the faulting tool's repository (openspec add-fault-ticket-routing).\n//! Responsibilities: filter tier-2 report rows to tool faults (failing\n//! checks without an `ERR_*` code), tally DISTINCT models per fault key\n//! (scenario, fault-class, tool) using the same threshold semantics as\n//! report.rs (min(3, |configured model registry|)), key the target\n//! repository on the scenario definition's recorded tool (never the\n//! report row's tool field, which is hardcoded for live trials), and\n//! emit proposal rows with the fingerprint token\n//! `evallerina:<scenario>:<fault-class>` and the full machine-checkable\n//! schema. Phase 1 is dry-run only: every emitted decision is `dry_run`\n//! (mapped tool) or `skipped`/`unmapped_tool` — no `bd` invocations\n//! happen here (filing is evallerina-2bz).\n//! Rationale: the fault taxonomy routes tool faults to tickets in the\n//! tool's repo, but the value that made evallerina useful (evallerina-2rr,\n//! -00n, -54f) all required hand-filing from dashboard findings. Routing\n//! makes that mechanical, with a dry-run default so cross-repo writes\n//! stay behind an explicit local opt-in, and loud errors on unknown\n//! scenarios (mirroring report.rs: never a silent bucket).\n\nuse std::collections::BTreeMap;\n\n/// The cross-model routing threshold — identical semantics to\n/// report.rs: a fault key observed in trial rows from at least this\n/// many distinct models (3, or the full configured registry when\n/// smaller) is routed.\nconst ROUTING_THRESHOLD: usize = 3;\n\n/// One dry-run proposal row (the proposed-tickets.jsonl schema, design\n/// §6): machine-checkable so the CI artifact is reviewable without\n/// reading code.\n#[derive(Debug, PartialEq)]\npub struct ProposalRow {\n    /// The scenario definition's recorded tool — the repo key.\n    pub tool: String,\n    /// Mapped repository path (null until/unless the tool is mapped).\n    pub repo: Option<String>,\n    pub scenario: String,\n    pub fault_class: String,\n    /// Fingerprint token: `evallerina:<scenario>:<fault-class>`.\n    pub token: String,\n    /// `dry_run` (mapped, not filed) or `skipped` (unmapped tool).\n    pub decision: String,\n    /// Null unless skipped (`unmapped_tool`).\n    pub reason: Option<String>,\n    /// Null in dry-run; set only when a ticket is filed (Phase 2).\n    pub bd_issue_id: Option<String>,\n    /// Provenance of the contributing trial rows (deduped by model):\n    /// report row scenario/model/tool values.\n    pub row_provenance: Vec<ProvenanceRow>,\n}\n\n/// One contributing trial row's provenance.\n#[derive(Debug, PartialEq)]\npub struct ProvenanceRow {\n    pub scenario: String,\n    pub model: String,\n    /// The report row's tool value — provenance only, never the repo key.\n    pub tool: String,\n}\n\nimpl ProposalRow {\n    /// Serialize to the proposed-tickets.jsonl JSON object.\n    pub fn to_json(&self) -> serde_json::Value {\n        serde_json::json!({\n            \"tool\": self.tool,\n            \"repo\": self.repo,\n            \"scenario\": self.scenario,\n            \"fault_class\": self.fault_class,\n            \"token\": self.token,\n            \"decision\": self.decision,\n            \"reason\": self.reason,\n            \"bd_issue_id\": self.bd_issue_id,\n            \"row_provenance\": self.row_provenance.iter()\n                .map(|p| serde_json::json!({\n                    \"scenario\": p.scenario,\n                    \"model\": p.model,\n                    \"tool\": p.tool,\n                }))\n                .collect::<Vec<_>>(),\n        })\n    }\n}\n\n/// Propose dry-run tickets from tier-2 report rows.\n///\n/// `rows` are parsed report rows (same inputs as report.rs: tier-2\n/// trial events, tier-1 rows without model attribution, absent records).\n/// `configured_models` is the model registry the rotation was configured\n/// with — it defines the routing threshold (min(3, registry size));\n/// empty is a loud error, no routing threshold exists. `scenario_tool_of`\n/// resolves a scenario to the tool its *definition* recorded (proposals\n/// key the repo on this, never on the row's tool field); an unknown\n/// scenario is a loud error. `repo_map` maps tool name → repo path (the\n/// parsed routing.toml); a mapped-but-unregistered tool surfaces as\n/// `skipped`/`unmapped_tool`, never a silent drop.\npub fn propose(\n    rows: &[serde_json::Value],\n    configured_models: &[String],\n    scenario_tool_of: &dyn Fn(&str) -> Option<String>,\n    repo_map: &BTreeMap<String, String>,\n) -> Result<Vec<ProposalRow>, String> {\n    if configured_models.is_empty() {\n        return Err(\"configured model registry is empty — no routing threshold exists\".into());\n    }\n    let routing_threshold = configured_models.len().min(ROUTING_THRESHOLD);\n\n    // Fault key (scenario, fault-class, tool-from-scenario) →\n    // distinct models + occurrences + provenance rows.\n    let mut faults: BTreeMap<FaultKey, FaultTally> = BTreeMap::new();\n\n    for row in rows {\n        let kind = row.get(\"kind\").and_then(serde_json::Value::as_str);\n        if kind == Some(\"absent\") {\n            // Absent cells are the record that a cell did not run;\n            // never failures, never dropped (anti-goal — mirrored\n            // from report.rs).\n            continue;\n        }\n        let scenario = row\n            .get(\"scenario\")\n            .and_then(serde_json::Value::as_str)\n            .ok_or(\"report row lacks a `scenario` field\")?;\n        let row_tool = row\n            .get(\"tool\")\n            .and_then(serde_json::Value::as_str)\n            .ok_or(\"report row lacks a `tool` field\")?;\n        let report_version = row\n            .get(\"report_version\")\n            .and_then(serde_json::Value::as_u64)\n            .ok_or(\"report row lacks a `report_version` field\")?;\n        if report_version != 1 {\n            return Err(format!(\n                \"report row carries report_version {report_version}; routing aggregates version 1 only\"\n            ));\n        }\n        // The repo keys on the scenario definition's recorded tool,\n        // not the row's tool field (hardcoded in live rows; the hhs\n        // bug showed attribution drifts). Unknown scenario → loud.\n        let recorded_tool = scenario_tool_of(scenario).ok_or_else(|| {\n            format!(\"scenario '{scenario}' has no recorded tool — refusing to route\")\n        })?;\n        let checks = row\n            .get(\"checks\")\n            .and_then(serde_json::Value::as_array)\n            .ok_or(\"report row lacks a `checks` array\")?;\n\n        let model = row.get(\"model\").and_then(serde_json::Value::as_str);\n        for check in checks {\n            // Validated for loudness even though routing keys on the\n            // scenario, not the check name (report.rs keys the matrix\n            // on it; routing's ticket granularity is the scenario).\n            let _name = check\n                .get(\"name\")\n                .and_then(serde_json::Value::as_str)\n                .ok_or(\"check row lacks a `name` field\")?;\n            let passed = check\n                .get(\"passed\")\n                .and_then(serde_json::Value::as_bool)\n                .ok_or(\"check row lacks a `passed` field\")?;\n            if passed {\n                continue;\n            }\n            match check.get(\"code\").and_then(serde_json::Value::as_str) {\n                // Agent faults are never routed (fault taxonomy: they\n                // inform AIX-channel work in genesis — a human decision).\n                Some(code) if code.starts_with(\"ERR_\") => continue,\n                // Tool fault: no code by contract (report.rs FaultKey::Tool).\n                _ => {\n                    let key = FaultKey {\n                        scenario: scenario.to_owned(),\n                        fault_class: \"tool_fault\".to_owned(),\n                        tool: recorded_tool.to_owned(),\n                    };\n                    let entry = faults.entry(key).or_default();\n                    entry.occurrences += 1;\n                    if let Some(model) = model {\n                        entry.models.insert((model.to_owned(), row_tool.to_owned()));\n                    }\n                }\n            }\n        }\n    }\n\n    Ok(faults\n        .into_iter()\n        .filter(|(_, tally)| tally.models.len() >= routing_threshold)\n        .map(|(key, tally)| {\n            let repo = repo_map.get(&key.tool).cloned();\n            let (decision, reason) = match repo {\n                Some(_) => (\"dry_run\".to_owned(), None),\n                None => (\"skipped\".to_owned(), Some(\"unmapped_tool\".to_owned())),\n            };\n            ProposalRow {\n                token: format!(\"evallerina:{}:{}\", key.scenario, key.fault_class),\n                scenario: key.scenario.clone(),\n                fault_class: key.fault_class.clone(),\n                tool: key.tool,\n                repo,\n                decision,\n                reason,\n                bd_issue_id: None,\n                row_provenance: tally\n                    .models\n                    .into_iter()\n                    .map(|(model, tool)| ProvenanceRow {\n                        scenario: key.scenario.clone(),\n                        model,\n                        tool,\n                    })\n                    .collect(),\n            }\n        })\n        .collect())\n}\n\n/// Internal fault key: (scenario, fault-class, scenario-recorded tool).\n#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]\nstruct FaultKey {\n    scenario: String,\n    fault_class: String,\n    tool: String,\n}\n\n/// Accumulated occurrences for one fault key: distinct\n/// (model, row-tool) pairs + total count. Distinct models drive the\n/// threshold; the row tool rides along as provenance.\n#[derive(Debug, Default)]\nstruct FaultTally {\n    occurrences: usize,\n    models: BTreeSet<(String, String)>,\n}\n\nuse std::collections::BTreeSet;\n\n/// Parse routing.toml content into the tool → repo map. Structure is\n/// deliberately minimal: `[<tool>]` tables with a `repo` string.\npub fn parse_routing_toml(content: &str) -> Result<BTreeMap<String, String>, String> {\n    let value: toml::Value =\n        toml::from_str(content).map_err(|e| format!(\"routing.toml parse error: {e}\"))?;\n    let mut map = BTreeMap::new();\n    let table = value\n        .as_table()\n        .ok_or(\"routing.toml must be a table of [tool] sections\")?;\n    for (tool, item) in table {\n        let repo = item\n            .get(\"repo\")\n            .and_then(toml::Value::as_str)\n            .ok_or_else(|| format!(\"routing.toml [{tool}] lacks a `repo` string\"))?;\n        map.insert(tool.clone(), repo.to_owned());\n    }\n    Ok(map)\n}\n\n/// Resolve a mapped repo path: absolute paths pass through untouched\n/// (target-repo worktrees); relative paths resolve against the\n/// evallerina repo root (via `git rev-parse --show-toplevel`, so they\n/// survive worktree checkouts of evallerina itself).\npub fn resolve_repo(repo: &str, evallerina_root: &std::path::Path) -> String {\n    let path = std::path::Path::new(repo);\n    if path.is_absolute() {\n        return repo.to_owned();\n    }\n    evallerina_root.join(repo).to_string_lossy().into_owned()\n}\n\n/// Serialize proposals to the proposed-tickets.jsonl artifact: one JSON\n/// object per line, machine-checkable, reviewable without reading code.\npub fn to_jsonl(proposals: &[ProposalRow]) -> String {\n    let mut out = String::new();\n    for p in proposals {\n        out.push_str(&p.to_json().to_string());\n        out.push('\\n');\n    }\n    out\n}\n\n/// Discover the evallerina repo root (worktree-safe) for relative\n/// routing.toml path resolution.\npub fn discover_root() -> Result<String, String> {\n    let out = std::process::Command::new(\"git\")\n        .args([\"rev-parse\", \"--show-toplevel\"])\n        .output()\n        .map_err(|e| format!(\"cannot run git for repo root: {e}\"))?;\n    if !out.status.success() {\n        return Err(format!(\n            \"git rev-parse --show-toplevel failed: {}\",\n            String::from_utf8_lossy(&out.stderr)\n        ));\n    }\n    Ok(String::from_utf8_lossy(&out.stdout).trim().to_owned())\n}\n\n[1 more lines in file. Use offset=293 to continue.]"}],"isError":false,"timestamp":1792427396922},{"role":"toolResult","toolCallId":"call_30abb6dcb58340bd81c1961d","toolName":"read","content":[{"type":"text","text":"//! Purpose: integration tests for the dry-run fault routing module\n//! (evallerina-l8w, openspec add-fault-ticket-routing Phase 1).\n//! Responsibilities: pin the report.rs threshold semantics (min(3,\n//! |configured registry|) distinct models per fault key), agent-fault\n//! exclusion, unmapped-tool skip, scenario-recorded-tool repo keying,\n//! worktree-safe routing.toml path resolution, and the full\n//! proposed-tickets.jsonl row schema.\n//! Rationale: routing proposals are cross-repo actions in potentia —\n//! every decision branch (dry_run / skipped) and every schema field is\n//! machine-checked here so the CI artifact is reviewable without\n//! reading code.\n\nuse evallerina::routing;\nuse serde_json::json;\n\n/// A tier-2 trial row with a failing, code-less check (tool fault) for\n/// one model. `row_tool` is the report row's tool field (hardcoded in\n/// live rows); `recorded` is the scenario definition's recorded tool.\nfn trial_row(scenario: &str, row_tool: &str, model: &str) -> serde_json::Value {\n    json!({\n        \"kind\": \"trial\",\n        \"report_version\": 1,\n        \"scenario\": scenario,\n        \"tool\": row_tool,\n        \"model\": model,\n        \"status\": \"failed\",\n        \"checks\": [{\"name\": \"envelope_hint_absent\", \"passed\": false}]\n    })\n}\n\nfn three_models() -> Vec<String> {\n    vec![\"m/a\".into(), \"m/b\".into(), \"m/c\".into()]\n}\n\nfn recorded_wai(scenario: &str) -> Option<String> {\n    (scenario == \"wai-hint-adherence-typo\").then(|| \"wai\".to_owned())\n}\n\nfn repo_map() -> std::collections::BTreeMap<String, String> {\n    [(\"wai\".to_owned(), \"../wai\".to_owned())].into()\n}\n\n#[test]\nfn threshold_tool_fault_becomes_dry_run_proposal() {\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    assert_eq!(proposals.len(), 1, \"one fault key above threshold\");\n    let p = &proposals[0].to_json();\n    assert_eq!(p[\"scenario\"], \"wai-hint-adherence-typo\");\n    assert_eq!(p[\"fault_class\"], \"tool_fault\");\n    assert_eq!(p[\"token\"], \"evallerina:wai-hint-adherence-typo:tool_fault\");\n    assert_eq!(p[\"decision\"], \"dry_run\");\n    assert_eq!(p[\"reason\"], serde_json::Value::Null);\n    assert_eq!(p[\"bd_issue_id\"], serde_json::Value::Null);\n}\n\n#[test]\nfn below_threshold_is_no_proposal() {\n    // (schema via to_json — indexing reads the serialized artifact)\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\"] // 2 distinct < 3\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    assert!(\n        proposals.is_empty(),\n        \"below threshold → recorded, no action\"\n    );\n}\n\n#[test]\nfn agent_faults_are_never_routed() {\n    // Failing checks WITH an ERR_* code are agent faults: they inform\n    // AIX-channel work in genesis (a human decision), never tickets.\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| {\n            let mut r = trial_row(\"wai-hint-adherence-typo\", \"wai\", m);\n            r[\"checks\"] = json!([{\"name\": \"hint_followed\", \"passed\": false,\n                                   \"code\": \"ERR_ENVELOPE_HINT_BLINDNESS\"}]);\n            r\n        })\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    assert!(\n        proposals.is_empty(),\n        \"agent faults must not produce proposals\"\n    );\n}\n\n#[test]\nfn unmapped_tool_is_skipped_not_fatal() {\n    // Above threshold, but routing.toml has no [wai] entry here.\n    let empty_map = std::collections::BTreeMap::new();\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &empty_map)\n        .expect(\"routing must not fail on an unmapped tool\");\n    assert_eq!(proposals.len(), 1, \"skipped is still recorded, not dropped\");\n    let p = &proposals[0].to_json();\n    assert_eq!(p[\"decision\"], \"skipped\");\n    assert_eq!(p[\"reason\"], \"unmapped_tool\");\n    assert_eq!(p[\"repo\"], serde_json::Value::Null);\n}\n\n#[test]\nfn repo_keys_on_recorded_tool_not_row_tool() {\n    // Live rows hardcode tool: \"wai\" (src/live.rs); a drifted row tool\n    // (the hhs bug class) must never send the ticket to the wrong repo.\n    // routing.toml here maps \"dont\" only — the scenario's recorded tool.\n    let mut drifted_map = std::collections::BTreeMap::new();\n    drifted_map.insert(\"dont\".to_owned(), \"../dont\".to_owned());\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| {\n            // Row tool says \"wai\"; scenario definition recorded \"dont\".\n            trial_row(\"dont-hint-adherence-lifecycle\", \"wai\", m)\n        })\n        .collect();\n    let recorded_dont = |s: &str| (s == \"dont-hint-adherence-lifecycle\").then(|| \"dont\".to_owned());\n    let proposals = routing::propose(&rows, &three_models(), &recorded_dont, &drifted_map)\n        .expect(\"routing succeeds\");\n    assert_eq!(proposals.len(), 1);\n    let p = &proposals[0].to_json();\n    assert_eq!(p[\"tool\"], \"dont\", \"repo keyed on recorded tool\");\n    assert_eq!(p[\"repo\"], \"../dont\");\n    // The drifted row tool survives as provenance only.\n    assert_eq!(p[\"row_provenance\"][0][\"tool\"], \"wai\");\n}\n\n#[test]\nfn routing_toml_parses_tools_to_repos() {\n    let toml_src = \"[wai]\\nrepo = \\\"../wai\\\"\\n\\n[genesis]\\nrepo = \\\"../genesis\\\"\\n\";\n    let map = routing::parse_routing_toml(toml_src).expect(\"parses\");\n    assert_eq!(map.get(\"wai\").map(String::as_str), Some(\"../wai\"));\n    assert_eq!(map.get(\"genesis\").map(String::as_str), Some(\"../genesis\"));\n}\n\n#[test]\nfn routing_toml_missing_repo_is_loud() {\n    let err = routing::parse_routing_toml(\"[wai]\\ndescription = \\\"no repo\\\"\\n\")\n        .expect_err(\"missing repo is a loud error\");\n    assert!(err.contains(\"repo\"));\n}\n\n#[test]\nfn relative_repo_resolves_against_evallerina_root() {\n    let root = std::path::Path::new(\"/worktrees/evallerina\");\n    assert_eq!(\n        routing::resolve_repo(\"../wai\", root),\n        \"/worktrees/evallerina/../wai\"\n    );\n}\n\n#[test]\nfn absolute_repo_passes_through_for_worktrees() {\n    let root = std::path::Path::new(\"/worktrees/evallerina\");\n    assert_eq!(\n        routing::resolve_repo(\"/para/worktrees/wai\", root),\n        \"/para/worktrees/wai\"\n    );\n}\n\n#[test]\nfn every_proposal_row_carries_the_full_schema() {\n    // Mixed bag: one mapped tool fault (dry_run), one unmapped\n    // (skipped/unmapped_tool) — every row must carry ALL schema fields\n    // with null where absent, and the JSONL artifact must be one\n    // machine-checkable JSON object per line.\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .flat_map(|m| {\n            vec![\n                trial_row(\"wai-hint-adherence-typo\", \"wai\", m),\n                trial_row(\"wai-doc-drift-stale-agents-md\", \"wai\", m),\n            ]\n        })\n        .collect();\n    let mut map = std::collections::BTreeMap::new();\n    map.insert(\"wai\".to_owned(), \"../wai\".to_owned());\n    let two_scenarios = |s: &str| {\n        (s == \"wai-hint-adherence-typo\" || s == \"wai-doc-drift-stale-agents-md\")\n            .then(|| \"wai\".to_owned())\n    };\n    let proposals =\n        routing::propose(&rows, &three_models(), &two_scenarios, &map).expect(\"routing succeeds\");\n    assert_eq!(proposals.len(), 2);\n    for p in &proposals {\n        let j = p.to_json();\n        for field in [\n            \"tool\",\n            \"repo\",\n            \"scenario\",\n            \"fault_class\",\n            \"token\",\n            \"decision\",\n            \"reason\",\n            \"bd_issue_id\",\n            \"row_provenance\",\n        ] {\n            assert!(j.get(field).is_some(), \"schema field {field} missing\");\n        }\n        assert_eq!(\n            j[\"bd_issue_id\"],\n            serde_json::Value::Null,\n            \"dry-run files nothing\"\n        );\n        assert_eq!(\n            j[\"reason\"],\n            serde_json::Value::Null,\n            \"dry_run has no reason\"\n        );\n        // row_provenance dedupes by model: 3 entries per proposal.\n        assert_eq!(j[\"row_provenance\"].as_array().map(Vec::len), Some(3));\n        for prov in j[\"row_provenance\"].as_array().unwrap() {\n            for f in [\"scenario\", \"model\", \"tool\"] {\n                assert!(prov.get(f).is_some(), \"provenance field {f} missing\");\n            }\n        }\n    }\n}\n\n#[test]\nfn unknown_scenario_is_a_loud_error() {\n    let rows = vec![trial_row(\"mystery-scenario\", \"wai\", \"m/a\")];\n    let err = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect_err(\"unknown scenario must be loud, never a silent bucket\");\n    assert!(err.contains(\"mystery-scenario\"));\n}\n\n#[test]\nfn jsonl_writer_emits_one_object_per_line() {\n    let rows: Vec<serde_json::Value> = [\"m/a\", \"m/b\", \"m/c\"]\n        .iter()\n        .map(|m| trial_row(\"wai-hint-adherence-typo\", \"wai\", m))\n        .collect();\n    let proposals = routing::propose(&rows, &three_models(), &recorded_wai, &repo_map())\n        .expect(\"routing succeeds\");\n    let jsonl = routing::to_jsonl(&proposals);\n    let lines: Vec<&str> = jsonl.lines().collect();\n    assert_eq!(lines.len(), proposals.len(), \"one object per line\");\n    for line in &lines {\n        let v: serde_json::Value = serde_json::from_str(line).expect(\"each line is a JSON object\");\n        assert!(v.get(\"token\").is_some());\n    }\n}\n\n[1 more lines in file. Use offset=255 to continue.]"}],"isError":false,"timestamp":1792427396922}]}
