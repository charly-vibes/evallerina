rite scenario-injected faults are a\n//! loud error, and real-tool generation asserts on process exit codes\n//! and produced files — a tool failure is a loud error, never a silent\n//! placeholder fallback.\n\nuse std::path::{Path, PathBuf};\n\nuse serde::Serialize;"},{"oldText":"impl AixArtifacts {\n    /// The artifact set as fixture files, written into the full arm's\n    /// fixture after the scenario's own material.\n    pub fn fixture_files(&self) -> Vec<(String, String)> {\n        vec![\n            (\"AGENTS.md\".to_owned(), self.managed_agents_md.to_owned()),\n            (\".genesis/tools.toml\".to_owned(), self.tools_toml.to_owned()),\n            (\"llms.txt\".to_owned(), self.llms_txt.to_owned()),\n        ]\n    }\n}","newText":"/// The fixture paths the full arm provisions, in [`AixArtifacts::fixture_files`]\n/// order. Shared by the static and real paths so the two arms of the\n/// ablation can never drift apart — and so the collision check below\n/// covers both.\nconst ARTIFACT_PATHS: [&str; 3] = [\"AGENTS.md\", \".genesis/tools.toml\", \"llms.txt\"];\n\nimpl AixArtifacts {\n    /// The artifact set as fixture files, written into the full arm's\n    /// fixture after the scenario's own material.\n    pub fn fixture_files(&self) -> Vec<(String, String)> {\n        vec![\n            (\"AGENTS.md\".to_owned(), self.managed_agents_md.to_owned()),\n            (\".genesis/tools.toml\".to_owned(), self.tools_toml.to_owned()),\n            (\"llms.txt\".to_owned(), self.llms_txt.to_owned()),\n        ]\n    }\n\n    /// Real generation entry (evallerina-0j8): invoke the provisioned\n    /// tools inside `fixture_dir` and harvest the artifacts they\n    /// produce. Process-boundary only: `wai init --json` must exit 0\n    /// and produce a readable `AGENTS.md` (its managed block) and a\n    /// registered `.genesis/tools.toml` — tool internals are never\n    /// inspected. A tool failure is a loud error, never a silent\n    /// placeholder fallback.\n    pub fn for_fixture(\n        fixture_dir: &Path,\n        tools: &ToolBinaries,\n    ) -> Result<GeneratedAixArtifacts, String> {\n        let out = std::process::Command::new(&tools.wai)\n            .arg(\"init\")\n            .arg(\"--json\")\n            .current_dir(fixture_dir)\n            .output()\n            .map_err(|e| format!(\"wai init spawn failed ({}): {e}\", tools.wai.display()))?;\n        if !out.status.success() {\n            return Err(format!(\n                \"wai init exited {} — real artifact generation failed loudly (stderr: {})\",\n                out.status,\n                String::from_utf8_lossy(&out.stderr).trim()\n            ));\n        }\n        let managed_agents_md = std::fs::read_to_string(fixture_dir.join(\"AGENTS.md\"))\n            .map_err(|e| format!(\"wai init produced no readable AGENTS.md: {e}\"))?;\n        let tools_toml = std::fs::read_to_string(fixture_dir.join(\".genesis/tools.toml\"))\n            .map_err(|e| format!(\"wai init produced no readable .genesis/tools.toml: {e}\"))?;\n        // llms.txt wires up in the next red/green step (genesis\n        // generate_llms_txt over the fixture tool set).\n        Ok(GeneratedAixArtifacts {\n            llms_txt: String::new(),\n            managed_agents_md,\n            tools_toml,\n        })\n    }\n}\n\n/// The provisioned tool binaries available for real artifact\n/// generation ([`AixSource::Real`]). Paths, not versions: generation\n/// asserts on process exit codes and produced files, never tool\n/// internals.\n#[derive(Debug, Clone)]\npub struct ToolBinaries {\n    /// The provisioned `wai` binary — generates the managed AGENTS.md\n    /// (with its provenance footer) and registers the tool manifest.\n    pub wai: PathBuf,\n}\n\nimpl ToolBinaries {\n    /// Locate `wai` on `PATH`; `None` when absent, so CI without tool\n    /// binaries stays hermetic ([`AixSource::Static`]).\n    pub fn discover_wai() -> Option<PathBuf> {\n        std::env::var_os(\"PATH\").into_iter().flatten().find_map(|dir| {\n            let candidate = PathBuf::from(dir).join(\"wai\");\n            let usable = candidate.is_file()\n                && std::fs::metadata(&candidate)\n                    .map(|m| !m.is_dir())\n                    .unwrap_or(false);\n            usable.then_some(candidate)\n        })\n    }\n}\n\n/// Which contents the full arm provisions. The hermetic static\n/// contents are the default (tests, CI without tool binaries); real\n/// generation is opt-in and runs the provisioned tools in a generation\n/// fixture ([`AixArtifacts::for_fixture`]).\n#[derive(Debug, Clone)]\npub enum AixSource<'a> {\n    /// Static contents — today's hermetic behavior, byte-for-byte.\n    Static(&'a AixArtifacts),\n    /// Real generation: invoke the provisioned tools and harvest what\n    /// they produce. Opt-in; a tool failure is a loud error.\n    Real(ToolBinaries),\n}\n\n/// Owned artifact contents produced by real generation\n/// ([`AixArtifacts::for_fixture`]) — the production entry. The static\n/// [`AixArtifacts`] variant stays for hermetic tests.\n#[derive(Debug, Clone)]\npub struct GeneratedAixArtifacts {\n    /// The `llms.txt` file content.\n    pub llms_txt: String,\n    /// The managed `AGENTS.md` content (managed blocks included).\n    pub managed_agents_md: String,\n    /// The `.genesis/tools.toml` content.\n    pub tools_toml: String,\n}\n\nimpl GeneratedAixArtifacts {\n    /// The artifact set as fixture files, written into the full arm's\n    /// fixture after the scenario's own material.\n    pub fn fixture_files(&self) -> Vec<(String, String)> {\n        ARTIFACT_PATHS\n            .iter()\n            .zip([\n                self.managed_agents_md.clone(),\n                self.tools_toml.clone(),\n                self.llms_txt.clone(),\n            ])\n            .map(|(path, content)| ((*path).to_owned(), content))\n            .collect()\n    }\n}"}]}}
